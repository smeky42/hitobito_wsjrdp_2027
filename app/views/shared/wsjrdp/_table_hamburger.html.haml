-#
-#  Reusable right-aligned "hamburger" dropdown for a table toolbar. Holds the
-#  column picker (shared/wsjrdp/_expandable_table_columns_form: a server round-trip
-#  form whose state lives in the <prefix>_cols param). Locals:
-#    id    -- unique element id for the panel
-#    menu  -- HTML content of the dropdown panel (usually a `capture` block)
-#    label -- button tooltip / aria-label (default "Spalten ein-/ausblenden")
-#    icon  -- FontAwesome 5 icon name (default "bars")
-#  A pin in the panel keeps it open: it stays open on a click outside, and
-#  opens again on every load of the page until it is unpinned. The pin is the
-#  viewer's own, kept in the browser (localStorage, per page and panel).
- id = local_assigns.fetch(:id)
- label = local_assigns.fetch(:label, "Spalten ein-/ausblenden")
- icon_name = local_assigns.fetch(:icon, "bars")
- unless @wsjrdp_table_hamburger_css
  - @wsjrdp_table_hamburger_css = true
  :css
    .tbl-burger { position: relative; flex: 0 0 auto; }
    .tbl-burger-panel { position: absolute; right: 0; top: calc(100% + .25rem); z-index: 1050;
      min-width: 15rem; max-width: min(92vw, 26rem); background: var(--bs-body-bg);
      border: 1px solid var(--bs-border-color); border-radius: .5rem;
      box-shadow: 0 .5rem 1.25rem rgba(0, 0, 0, .18); padding: .7rem; display: none;
      max-height: min(70vh, 30rem); overflow: auto; }
    .tbl-burger.open .tbl-burger-panel { display: block; }
    .tbl-burger-pin { float: right; margin: -.3rem -.3rem .2rem .5rem; padding: .1rem .35rem; border: 0;
      border-radius: .25rem; background: none; color: var(--bs-secondary-color, #6c757d); line-height: 1; }
    .tbl-burger-pin:hover { background: var(--bs-tertiary-bg, #f1f3f5); color: var(--bs-body-color); }
    .tbl-burger-pin .fas { transform: rotate(45deg); }
    .tbl-burger.pinned .tbl-burger-pin { color: var(--bs-primary, #21697c); }
    .tbl-burger.pinned .tbl-burger-pin .fas { transform: none; }
    @media (max-width: 575.98px) {
      /* Right-anchored to the button (absolute, not fixed -- a fixed element's
         top:100% is the viewport bottom); cap width + min-width to the screen so
         it never overflows a phone. */
      .tbl-burger-panel { min-width: min(15rem, calc(100vw - 1rem));
        max-width: calc(100vw - 1rem); }
    }
  :javascript
    (function () {
      if (window.__tblBurger) return;
      window.__tblBurger = true;
      function pinKey(burger) {
        var panel = burger.querySelector(".tbl-burger-panel");
        return "tblBurgerPin:" + location.pathname + "#" + (panel ? panel.id : "");
      }
      // The panel hangs from the button's right edge; where the button sits
      // near the left (a phone, a wrapped toolbar) that would push it off the
      // screen, so it is moved right until it starts inside the viewport.
      var GAP = 8;
      function place(burger) {
        var panel = burger.querySelector(".tbl-burger-panel");
        if (!panel) return;
        panel.style.left = "";
        panel.style.right = "";
        if (!burger.classList.contains("open")) return;
        var box = panel.getBoundingClientRect();
        if (box.left >= GAP) return;
        var anchor = burger.getBoundingClientRect();
        panel.style.right = "auto";
        panel.style.left = (GAP - anchor.left) + "px";
      }
      window.addEventListener("resize", function () { document.querySelectorAll(".tbl-burger.open").forEach(place); });

      function setPinned(burger, pinned) {
        burger.classList.toggle("pinned", pinned);
        var pin = burger.querySelector(".tbl-burger-pin");
        if (pin) {
          pin.setAttribute("aria-pressed", pinned ? "true" : "false");
          pin.title = pinned ? "Menü lösen" : "Menü anheften (bleibt offen, auch nach dem Neuladen)";
          pin.setAttribute("aria-label", pinned ? "Menü lösen" : "Menü anheften");
        }
        if (pinned) {
          burger.classList.add("open");
          var btn = burger.querySelector(".tbl-burger-btn");
          if (btn) btn.setAttribute("aria-expanded", "true");
          place(burger);
        }
      }
      function restorePins() {
        document.querySelectorAll(".tbl-burger").forEach(function (burger) {
          var pinned = false;
          try { pinned = localStorage.getItem(pinKey(burger)) === "1"; } catch (e) {}
          setPinned(burger, pinned);
        });
      }
      ["DOMContentLoaded", "turbo:load", "turbo:frame-load"].forEach(function (name) {
        document.addEventListener(name, restorePins);
      });
      setTimeout(restorePins, 0);
      document.addEventListener("click", function (e) {
        var pin = e.target.closest(".tbl-burger-pin");
        if (pin) {
          var burger = pin.closest(".tbl-burger");
          var pinned = !burger.classList.contains("pinned");
          try {
            if (pinned) localStorage.setItem(pinKey(burger), "1");
            else localStorage.removeItem(pinKey(burger));
          } catch (err) {}
          setPinned(burger, pinned);
          e.stopPropagation();
          return;
        }
        var btn = e.target.closest(".tbl-burger-btn");
        if (btn) {
          var burger = btn.closest(".tbl-burger");
          var open = burger.classList.toggle("open");
          btn.setAttribute("aria-expanded", open ? "true" : "false");
          place(burger);
          e.stopPropagation();
          return;
        }
        // click outside an open panel closes it (clicks inside the panel keep it)
        if (e.target.closest(".tbl-burger-panel")) return;
        document.querySelectorAll(".tbl-burger.open:not(.pinned)").forEach(function (b) {
          b.classList.remove("open");
          var t = b.querySelector(".tbl-burger-btn");
          if (t) t.setAttribute("aria-expanded", "false");
        });
      });
      document.addEventListener("keydown", function (e) {
        if (e.key !== "Escape") return;
        document.querySelectorAll(".tbl-burger.open:not(.pinned)").forEach(function (b) {
          b.classList.remove("open");
          var t = b.querySelector(".tbl-burger-btn");
          if (t) { t.setAttribute("aria-expanded", "false"); t.focus(); }
        });
      });
    })();
.tbl-burger
  %button.tbl-burger-btn.btn.btn-sm.btn-outline-secondary{type: "button", "aria-expanded": "false",
    "aria-haspopup": "true", "aria-controls": id, title: label, "aria-label": label}
    %i.fas{class: "fa-#{icon_name}", "aria-hidden": "true"}
  .tbl-burger-panel{id: id, role: "menu"}
    %button.tbl-burger-pin{type: "button", "aria-pressed": "false", "aria-label": "Menü anheften",
      title: "Menü anheften (bleibt offen, auch nach dem Neuladen)"}
      %i.fas.fa-thumbtack{"aria-hidden": "true"}
    = menu
