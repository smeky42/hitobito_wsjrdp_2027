        if (!attr) return cond[0] + " " + cond[1] + " " + cond.slice(2).join(", ");
        var op = opByKey(attr, cond[1]);
        var operands = cond.slice(2);
        var opLabel = op ? ((operands.length > 1 && op.label_many) ? op.label_many : op.label) : cond[1];
        var shown;
        if (!operands.length) shown = "";
        else if (op && op.arity === "two") shown = fmtOperandFull(attr, operands[0]) + " – " + fmtOperandFull(attr, operands[1]);
        else shown = operands.map(function (v) { return fmtOperandFull(attr, v); }).join(", ");
        return (attr.label + " " + opLabel + (shown ? " " + shown : "")).trim();
      }

      // What the operator dropdown lists. Two reductions of the attribute's
      // ACCEPTED operators:
      //   * only the PICKABLE ones (Attribute#pickable) -- an accepted but
      //     unpickable operator stays valid in a hand-written URL, a preset or
      //     a fixed slot, and chips label it, it is just not offered here.
      //     `currentKey` is always kept, so an existing condition on such an
      //     operator opens with it selected and can be re-saved unchanged;
      //   * case-insensitive/-sensitive pairs (case_group) collapse to one
      //     entry (the insensitive member) + the separate case toggle.
      // Nothing pickable at all (a derive can narrow that far) falls back to
      // the full list rather than leaving the dropdown empty.
      function operatorEntries(attr, currentKey) {
