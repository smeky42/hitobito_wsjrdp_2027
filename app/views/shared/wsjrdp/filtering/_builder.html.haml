      }

      // ----- presets -------------------------------------------------------
      // The SAME slot equality the server applies (Wsjrdp::Filtering::SlotEquality):
      // a slot is one canonical set of stringified conditions, order and
      // repetition irrelevant. Used only to MARK a slot as a preset's -- which
      // preset is active is decided server-side, from the applied filter.
      //
      // Sign pairs count as ONE attribute under a sign-invariant operator: "≠ 0",
      // "hat Wert", "ist leer" and "= 0" ask nothing about the sign, so a
      // condition on the signed member canonicalises to its magnitude twin and a
      // "Saldo ≠ 0" slot gets the stripe of the "|Saldo| ≠ 0" preset. The pairing
      // comes from the catalog's own variant_group/sign, as it does server-side.
      var SIGN_INVARIANT_OPS = ["nonzero", "present", "blank"];
      var signAliases = (function () {
        var byGroup = {}, map = {};
        labelAttrs.forEach(function (a) {
          if (!a.variant_group || !a.sign) return;
          if (!byGroup[a.variant_group]) byGroup[a.variant_group] = {};
          byGroup[a.variant_group][a.sign] = a.key;
        });
        Object.keys(byGroup).forEach(function (group) {
