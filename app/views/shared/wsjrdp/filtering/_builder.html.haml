        });
      });
      // The members of a GROUP share ONE slot -- `attribute in (values)`, one
      // value per pressed button -- so that slot is nobody's alone and is
      // recognised the way the chips recognise it (Wsjrdp::FilterChips): exactly
      // one condition, on an attribute a group speaks for, under "in", and every
      // one of its values a member's (group_values). The stripe then names the
      // members whose values the slot holds.
      var groupValues = {}, groupLabels = {};
