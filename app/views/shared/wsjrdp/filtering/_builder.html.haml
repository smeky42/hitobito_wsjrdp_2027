      // Outside click: commit if possible, else discard the draft.
      document.addEventListener("mousedown", function (e) {
        if (!editor) return;
        if (!root.contains(e.target)) settleEditor();
      });

      // ----- rendering -----------------------------------------------------
      // A read-only chip (locked conditions, and every chip in disabled mode).
      function readonlyChip(cond, suffix) {
        var t = condText(cond);
