      }

      // ----- editor state / commit ----------------------------------------
      // Current operands from editor state, or null if not committable.
      function currentOperands() {
        var attr = attrByKey(editor.attrKey);
        var op = opByKey(attr, editor.opKey);
        if (op.arity === "none") return [];
        if (attr.control === "multiselect" || attr.control === "select") {
          return editor.sel.length ? editor.sel.slice() : null;
        }
        var want = (op.arity === "two") ? 2 : 1;
        var vals = [];
        for (var i = 0; i < want; i++) {
          var raw = (editor.raw[i] || "").trim();
          if (raw === "") return null;
