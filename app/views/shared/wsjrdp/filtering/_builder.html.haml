        chip.title = condFullText(cond) + (suffix || "");
        var text = el("span", "flt-chip-text");
        text.appendChild(el("span", "fw-semibold", t.label + " "));
        text.appendChild(el("span", "flt-op", t.op + (t.operands ? " " : "")));
        if (t.operands) text.appendChild(el("span", null, t.operands));
        chip.appendChild(text);
        return chip;
      }
      // Locked conditions as full read-only slots (one row per AND-slot).
      function renderLockedFull() {
        locked.forEach(function (slot, li) {
          if (li > 0) slotsEl.appendChild(el("div", "flt-und", "UND"));
          var row = el("div", "flt-slot flt-slot-locked");
          row.title = "Fest vorgegeben – nicht änderbar";
          row.appendChild(icon("lock")).classList.add("flt-lock");
          slot.forEach(function (cond, ci) {
            if (ci > 0) row.appendChild(el("span", "flt-or", "oder"));
