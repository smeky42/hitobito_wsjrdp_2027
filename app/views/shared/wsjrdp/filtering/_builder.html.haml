        }
        return named.join(", ");
      }
      // While the builder differs from the applied filter, every preset toggle
      // is locked: applying one at once would throw the unapplied edits away.
      function lockPresets(locked) {
        if (!presetsBar) return;
        presetsBar.classList.toggle("flt-locked", locked);
        presetsBar.querySelectorAll(".flt-preset").forEach(function (link) {
          if (locked) {
            if (link.hasAttribute("href")) {
              link.dataset.href = link.getAttribute("href");
              link.removeAttribute("href");
            }
            link.setAttribute("aria-disabled", "true");
            link.setAttribute("tabindex", "-1");
            link.title = "Gesperrt: erst die Änderungen im Filter anwenden oder verwerfen";
          } else {
            if (link.dataset.href) {
              link.setAttribute("href", link.dataset.href);
