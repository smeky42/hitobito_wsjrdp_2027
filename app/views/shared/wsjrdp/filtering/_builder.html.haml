          slotsEl.appendChild(row);
          if (editor && editor.si === si) slotsEl.appendChild(buildEditor());
        });

        if (!value.length) {
          // Empty state: one waiting slot instead of just a button.
          if (locked.length) slotsEl.appendChild(el("div", "flt-und", "UND"));
          var emptyRow = el("div", "flt-slot flt-slot-empty");
