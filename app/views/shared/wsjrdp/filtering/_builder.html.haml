          caseChk.type = "checkbox";
          caseChk.checked = !!editor.caseSensitive;
          caseChk.addEventListener("change", function () {
            editor.caseSensitive = caseChk.checked;
            editor.opKey = effectiveOpKey(attr, dropdownKeyFor(attr, editor.opKey), caseChk.checked);
          });
          caseLabel.appendChild(caseChk);
          caseLabel.appendChild(el("span", null, "Groß/Klein beachten"));
          caseLabel.title = "Groß-/Kleinschreibung beachten";
          grid.appendChild(caseLabel);
        }

        // ✓ / × icons right next to the inputs
        var icons = el("div", "flt-icons");
        var ok = el("button", "flt-ok");
        ok.type = "button";
        ok.title = "Übernehmen (↵)";
        ok.appendChild(icon("check"));
        ok.addEventListener("click", function () { commitIfValid(); });
        var cancel = el("button", "flt-cancel");
        cancel.type = "button";
        cancel.title = "Abbrechen (Esc)";
        cancel.appendChild(icon("times"));
        cancel.addEventListener("click", cancelEditor);
        icons.appendChild(ok);
        icons.appendChild(cancel);
        grid.appendChild(icons);

        var hints = el("div", "flt-hints", hint);
        grid.appendChild(hints);
        panel.appendChild(grid);

        function refreshOk() { ok.disabled = (currentOperands() === null); }
        panel.addEventListener("input", refreshOk);
        panel.addEventListener("change", refreshOk);
        refreshOk();

        panel.addEventListener("keydown", function (e) {
          if (e.key === "Escape") {
            e.preventDefault();
            cancelEditor();
          } else if (e.key === "Enter" && e.target.tagName !== "SELECT" &&
              !e.target.classList.contains("flt-ms-input")) {
            e.preventDefault();
            commitIfValid();
          }
        });
        return panel;
      }

      // Build operand inputs into `zone`; returns the keyboard hint text.
      function buildOperandControls(zone, attr, op) {
        if (op.arity === "none") {
          return "Ohne Wert – wird beim Auswählen direkt übernommen.";
        }

        // Operator-specific controls (whole year / whole month on dates),
        // prefilled with the current year/month so ✓/↵ works immediately.
        if (op.operand_control === "year" || op.operand_control === "month") {
          var isYear = op.operand_control === "year";
          var now = new Date();
          var dflt = isYear ? String(now.getFullYear())
            : (now.getFullYear() + "-" + String(now.getMonth() + 1).padStart(2, "0"));
          if (!(editor.raw[0] || "").trim()) editor.raw[0] = dflt;
          var special = el("input", "form-control form-control-sm");
          special.type = isYear ? "number" : "month";
          if (isYear) {
            special.min = "1900";
            special.max = "2100";
            special.style.width = "7rem";
          } else if (special.type !== "month") {
            special.type = "text"; // browser without <input type=month>
            special.placeholder = "JJJJ-MM";
            special.style.width = "8rem";
          }
          special.value = editor.raw[0];
          special.addEventListener("input", function () { editor.raw[0] = special.value; });
          zone.appendChild(special);
          return "Vorbelegt mit " + (isYear ? "dem aktuellen Jahr" : "dem aktuellen Monat") +
            " · ↵: übernehmen · Esc: abbrechen";
        }

        if (attr.control === "multiselect" || attr.control === "select") {
          buildChipsCombobox(zone, attr);
          return "Tippen: suchen · ↑↓: markieren · ↵: auswählen, mit leerem Feld: übernehmen · ⌫: letzte entfernen · Esc: abbrechen";
        }

        var isNumber = attr.control === "number_range";
        var isDate = attr.control === "date_range";
        if (isNumber || isDate) {
          var n = (op.arity === "two") ? 2 : 1;
          for (var i = 0; i < n; i++) {
            if (i > 0) zone.appendChild(el("span", "small text-muted", "–"));
            (function (idx) {
              var input = el("input", "form-control form-control-sm");
              input.type = isNumber ? "number" : "date";
              if (isNumber) {
                input.step = "any";
                input.style.width = "9rem";
                // operand_min: an absolute-value attribute (|Betrag|, |Saldo|)
                // cannot match below 0, so the input says so.
                if (attr.operand_min !== null && attr.operand_min !== undefined) {
                  input.min = String(attr.operand_min);
                }
              }
              input.value = editor.raw[idx] !== undefined ? editor.raw[idx] : "";
              input.addEventListener("input", function () { editor.raw[idx] = input.value; });
              zone.appendChild(input);
            })(i);
          }
          return "↵: übernehmen · Esc: abbrechen";
        }

        var text = el("input", "form-control form-control-sm");
        text.type = "text";
        text.style.minWidth = "10rem";
        text.value = editor.raw[0] !== undefined ? editor.raw[0] : "";
        text.addEventListener("input", function () { editor.raw[0] = text.value; });
        zone.appendChild(text);
        return "↵: übernehmen · Esc: abbrechen";
      }

      // TomSelect-style chips-combobox: selected values as removable chips in
      // the field, a search input, and a keyboard-navigable option list.
      function buildChipsCombobox(zone, attr) {
        var values = (attr.options && attr.options.values) || [];
        var op = opByKey(attr, editor.opKey);
        var field = el("div", "flt-msfield");
        var box = el("div", "flt-msbox");
        var input = el("input", "flt-ms-input");
        input.type = "text";
        input.setAttribute("aria-label", attr.label + " suchen");
        input.placeholder = "Suchen…";
        var list = el("div", "flt-ms-list");
        // ANY-of semantics hint, shown as soon as more than one value is picked.
        var manyHint = el("div", "flt-many-hint");
        var highlight = -1; // index into the currently visible rows

        function selected(v) { return editor.sel.indexOf(v) >= 0; }
        function syncManyHint() {
          manyHint.textContent =
            (editor.sel.length > 1 && op && op.many_hint) ? op.many_hint : "";
        }
        function toggle(v) {
          var i = editor.sel.indexOf(v);
          if (i >= 0) editor.sel.splice(i, 1);
          else editor.sel.push(v);
          syncChips();
          syncList();
          syncManyHint();
          box.dispatchEvent(new Event("change", {bubbles: true}));
        }
        function syncChips() {
          box.querySelectorAll(".flt-mschip").forEach(function (c) { c.remove(); });
          editor.sel.forEach(function (v) {
            var chip = el("span", "flt-mschip");
            chip.appendChild(el("span", null, optionLabel(attr, v)));
            var x = el("button", "flt-x");
            x.type = "button";
            x.title = "Entfernen";
            x.appendChild(icon("times"));
            x.addEventListener("click", function (e) {
              e.stopPropagation();
              toggle(v);
              input.focus();
            });
            chip.appendChild(x);
            box.insertBefore(chip, input);
          });
        }
        function visibleRows() {
          return Array.prototype.filter.call(list.children, function (r) { return r.style.display !== "none"; });
        }
        function syncList() {
          var q = input.value.toLowerCase();
          Array.prototype.forEach.call(list.children, function (row) {
            row.style.display = row.dataset.text.indexOf(q) >= 0 ? "" : "none";
            row.classList.toggle("sel", selected(row.dataset.value));
            row.querySelector(".flt-ms-tick").textContent = selected(row.dataset.value) ? "✓" : "";
          });
          var rows = visibleRows();
          if (highlight >= rows.length) highlight = rows.length - 1;
          rows.forEach(function (row, i) { row.classList.toggle("hl", i === highlight); });
        }
        values.forEach(function (pair) {
          var row = el("div", "flt-ms-row");
          row.dataset.value = pair[0];
          row.dataset.text = pair[1].toLowerCase();
          row.appendChild(el("span", "flt-ms-tick", ""));
          row.appendChild(el("span", "flt-ms-text", pair[1]));
          row.addEventListener("mousedown", function (e) { e.preventDefault(); }); // keep input focus
          row.addEventListener("click", function () {
            // Same as picking the row with Enter: the typed search is consumed.
            toggle(pair[0]);
            input.value = "";
            highlight = -1;
            syncList();
            input.focus();
          });
          list.appendChild(row);
        });
        input.addEventListener("input", function () {
          highlight = input.value ? 0 : -1;
          syncList();
        });
        input.addEventListener("keydown", function (e) {
          var rows = visibleRows();
          if (e.key === "ArrowDown") {
            e.preventDefault();
            highlight = Math.min(highlight + 1, rows.length - 1);
            syncList();
            if (highlight >= 0) rows[highlight].scrollIntoView({block: "nearest"});
          } else if (e.key === "ArrowUp") {
            e.preventDefault();
            highlight = Math.max(highlight - 1, -1);
            syncList();
          } else if (e.key === "Enter") {
            e.preventDefault();
            var current = visibleRows()[highlight];
            if (current) {
              toggle(current.dataset.value);
              input.value = "";
              highlight = -1;
              syncList();
            } else if (input.value === "") {
              commitIfValid(); // empty field + Enter = done
            }
          } else if (e.key === "Backspace" && input.value === "" && editor.sel.length) {
            toggle(editor.sel[editor.sel.length - 1]);
          }
        });
        box.addEventListener("click", function () { input.focus(); });
        box.appendChild(input);
        field.appendChild(box);
        field.appendChild(manyHint);
        field.appendChild(list);
        zone.appendChild(field);
        syncChips();
        syncList();
        syncManyHint();
      }

      render();
    }

    function initAll() {
      document.querySelectorAll(".flt-root").forEach(initRoot);
    }
    initAll();
    // Turbo-safety: cached snapshots keep data-init but lose the listeners, so
    // strip the marker before caching and re-init after every (restore) visit.
    window.__fltInitAll = initAll;
    if (!window.__fltTurboHooks) {
      window.__fltTurboHooks = true;
      document.addEventListener("turbo:before-cache", function () {
        document.querySelectorAll(".flt-root").forEach(function (r) {
          delete r.dataset.init;
          var slots = r.querySelector(".flt-slots");
          if (slots) slots.textContent = "";
        });
      });
      document.addEventListener("turbo:load", function () {
        if (window.__fltInitAll) window.__fltInitAll();
      });
    }
  })();
