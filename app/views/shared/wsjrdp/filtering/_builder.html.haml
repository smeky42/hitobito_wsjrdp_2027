-#
-#  Generic CNF filter builder (doc/wsjrdp/generic_filter_builder.md): AND-combined
-#  slots of OR-combined conditions, driven purely by the catalog + value JSON
-#  (no dataset knowledge). Editing is flow-oriented: conditions auto-commit on
-#  Enter / on outside click / when continuing with "oder"/"UND"; ✓ and ×
-#  icons next to the inputs are the explicit fallback. Nothing runs until
-#  "Anwenden": while the builder differs from the applied filter, a hint and a
-#  badge on the filter toggle (rendered at the right end of the filter line
-#  above this pane) say so, and "Änderungen verwerfen" throws the
-#  unapplied edits away; "Filter zurücksetzen" links to the table's default
-#  filter (et_filter_reset_url). The one exception are the PRESETS
-#  ("Schnellauswahl", rendered in the filter LINE above this pane --
-#  shared/wsjrdp/filtering/_line): they are GET links that apply at once, and
-#  are therefore locked while there are unapplied edits. Keyboard hints are
-#  shown in the editor. Attributes sharing a variant_group appear as ONE
-#  picker entry with a sub-variant switch in the editor. The operator dropdown
-#  offers only the attribute's PICKABLE operators (plus the edited condition's
-#  own, so a chip on an accepted-but-unpickable operator survives editing).
-#  Locals:
-#    state:      the table's Wsjrdp::TableState -- supplies EVERYTHING the
-#                builder shows: the catalog (already reduced by the table's
-#                exclude:), the applied user conditions, the FIXED slots (D2e:
-#                rendered read-only ahead of the user's, or not at all), the
-#                pane's open state and cookie, the filter reset URL and the
-#                params the apply carries. Nothing here is read from
-#                params/cookies, and nothing is passed in that the controller
-#                did not resolve.
-#    apply_url:  POST target; the server encodes to Rison and redirects (PRG)
-#    presets:    the table's quick-select presets, ALREADY RESOLVED to
-#                Wsjrdp::TableState::FilterPresets by the widget (which is the
-#                one place that decides between the policy's and the view's
-#                declaration) -- the same list the filter line renders as the
-#                "Schnellauswahl" bar. Used here only to MARK a user slot a
-#                preset owns or a group of buttons shares, and to lock the bar
-#                while dirty.
-#  shared/wsjrdp/_collapsible_panes must be rendered once on the page.
- state = local_assigns.fetch(:state)
- catalog = state.filter.catalog
- value = state.filter.user_slots
- presets = Array(local_assigns.fetch(:presets, nil))
-# Fixed slots with show: :readonly are shown as locked chips; show: :hidden ones
-# never reach the view. Either way they are display only -- the enforcement is
-# state.filter.scope, which compiles ALL fixed slots.
- locked = state.filter.readonly_slots
- carry = et_carry_params(state, except: %i[filter page open])
-# "Zurücksetzen" clears the FILTER only (an explicitly blank filter param), never
-# the table's sort, columns, page size or page -- there is no table-wide reset
-# control in the UI.
- reset_url = et_filter_reset_url(state)
- open = state.pane
- pane_cookie = state.cookie_name(:pane)
-# Locked chips may name attributes the user's picker does not offer, so they are
-# labelled from the FULL catalog -- fetched only when there is something to
-# label AND the two catalogs actually differ (building one runs the option
-# queries of every reference attribute).
- locked_catalog = (locked.any? && state.filter.exclude.any?) ? state.filter.full_catalog : {}
- condensed_locked = local_assigns.fetch(:condensed_locked, false)
- disabled = local_assigns.fetch(:disabled, false)
-# The preset bar sits OUTSIDE .flt-root -- in the filter LINE above this
-# pane -- so the JS reaches it by id rather than by walking the DOM.
- presets_id = et_filter_presets_id(state)

:css
  .flt-slot { display: flex; flex-wrap: wrap; align-items: center; gap: .4rem;
    border: 1px solid var(--bs-border-color); border-radius: .5rem;
    padding: .45rem .6rem; background: var(--bs-body-bg); }
  .flt-slot-empty { border-style: dashed; }
  .flt-slot-locked { background: var(--bs-tertiary-bg, var(--bs-light)); }
  /* Read-only (host-pinned) conditions: muted throughout so they read clearly
     as "fixed, not editable" next to the user's own (full-contrast) chips. This
     Bootstrap build has no --bs-secondary-color token (a 5.3 addition), so a
     concrete gray fallback is given. */
  .flt-slot-locked .flt-chip { cursor: default; background: transparent; color: var(--bs-secondary-color, #6c757d); }
  .flt-slot-locked .flt-chip .fw-semibold { font-weight: 500 !important; color: var(--bs-secondary-color, #6c757d); }
  .flt-slot-locked .flt-chip .flt-op,
  .flt-slot-locked .flt-chip .flt-chip-text > span { color: var(--bs-secondary-color, #6c757d); }
  .flt-slot-locked .flt-chip:hover { border-color: var(--bs-border-color); }
  .flt-slot-locked .flt-lock { color: var(--bs-secondary-color, #6c757d); }
  /* Truncated chip content still explains itself in full via the title
     tooltip (set in JS); show the help cursor only where a tooltip exists. */
  .flt-chip[title] { cursor: help; }
  .flt-slot:not(.flt-slot-locked) .flt-chip[title] { cursor: pointer; }
  .flt-lock { color: var(--bs-secondary-color, #6c757d); font-size: .75rem; }
  /* Condensed summary of the fixed (locked) conditions: one muted line with a
     full-text tooltip, shown instead of the full read-only chip rows. */
  .flt-locked-summary { display: flex; flex-wrap: wrap; align-items: baseline; gap: .3rem;
    padding: .35rem .6rem; border: 1px dashed var(--bs-border-color); border-radius: .5rem;
    background: var(--bs-tertiary-bg, var(--bs-light)); color: var(--bs-secondary-color, #6c757d);
    font-size: .85rem; cursor: help; }
  .flt-locked-summary .flt-lock { font-size: .8rem; align-self: center; }
  .flt-locked-summary-text { word-break: break-word; }
  .flt-und { align-self: flex-start; margin: .25rem 0 .25rem .75rem; font-size: .7rem;
    font-weight: 600; color: var(--bs-secondary-color, #6c757d);
    background: var(--bs-secondary-bg); border-radius: .35rem; padding: .1rem .45rem; }
  .flt-chip { display: inline-flex; align-items: center; gap: .3rem; max-width: 100%;
    border: 1px solid var(--bs-border-color); border-radius: 999px;
    padding: .12rem .25rem .12rem .6rem; background: var(--bs-tertiary-bg, var(--bs-light));
    cursor: pointer; font-size: .85rem; }
  .flt-chip:hover { border-color: var(--bs-secondary-color, #6c757d); }
  .flt-chip .flt-chip-text { white-space: normal; word-break: break-word; }
  .flt-chip .flt-op { color: var(--bs-secondary-color, #6c757d); }
  .flt-x { border: 0; background: transparent; line-height: 1; padding: 0 .3rem;
    font-size: .7rem; color: var(--bs-secondary-color, #6c757d); cursor: pointer; }
  .flt-x:hover { color: var(--bs-danger); }
  .flt-del-slot .fas { font-size: .85rem; }
  .flt-add-cond .fas, .flt-add-slot .fas { font-size: .75rem; }
  .flt-or { font-size: .8rem; color: var(--bs-secondary-color, #6c757d); }
  .flt-add-cond, .flt-add-slot { border: 1px dashed var(--bs-border-color); background: transparent;
    border-radius: 999px; font-size: .8rem; padding: .1rem .6rem; color: var(--bs-link-color); cursor: pointer; }
  .flt-add-cond:hover, .flt-add-slot:hover { background: var(--bs-secondary-bg); }
  .flt-del-slot { border: 0; background: transparent; color: var(--bs-secondary-color, #6c757d);
    cursor: pointer; margin-left: auto; padding: 0 .2rem; }
  .flt-del-slot:hover { color: var(--bs-danger); }
  .flt-editor { border: 1px solid var(--bs-border-color); border-radius: .5rem;
    padding: .6rem; margin-top: .35rem; background: var(--bs-secondary-bg); }
  .flt-editor-grid { display: flex; flex-wrap: wrap; gap: .5rem; align-items: flex-start; }
  .flt-editor-grid select { max-width: 100%; }
  /* Sign toggle of an amount's variant group: two segmented buttons (± and
     |x|) in the place of the sub-variant dropdown. Both are given the same
     width, and |x| a monospace face, so the pair does not jump. */
  .flt-sign .btn { min-width: 2.4rem; }
  .flt-sign .flt-sign-abs { font-family: var(--bs-font-monospace, ui-monospace, monospace); }
  .flt-operands { display: flex; flex-wrap: wrap; gap: .35rem; align-items: center; min-width: 0; }
  /* Compact date fields so attribute + operator + range fit on one line. */
  .flt-operands input[type="date"] { width: 9.2rem; }
  .flt-operands input[type="month"] { width: 8.5rem; }
  .flt-icons { display: flex; gap: .25rem; align-items: center; }
  .flt-ok, .flt-cancel { border: 1px solid var(--bs-border-color); background: var(--bs-body-bg);
    border-radius: .35rem; width: 1.9rem; height: 1.9rem; line-height: 1; cursor: pointer;
    font-size: 1rem; padding: 0; }
  .flt-ok { color: var(--bs-success); }
  .flt-ok:disabled { color: var(--bs-secondary-color, #6c757d); opacity: .45; cursor: default; }
  .flt-ok:not(:disabled):hover { background: var(--bs-success-bg-subtle, #d1e7dd); }
  .flt-cancel { color: var(--bs-danger); }
  .flt-cancel:hover { background: var(--bs-danger-bg-subtle, #f8d7da); }
  .flt-hints { flex-basis: 100%; font-size: .72rem; color: var(--bs-secondary-color, #6c757d); }
  .flt-case { display: inline-flex; align-items: center; gap: .35rem; font-size: .8rem;
    color: var(--bs-body-color); margin: 0; align-self: center; text-align: left;
    white-space: nowrap; }
  .flt-case input[type="checkbox"] { width: 1rem; height: 1rem; margin: 0; flex: 0 0 auto; }
  .flt-many-hint { font-size: .75rem; color: var(--bs-primary-text-emphasis, #084298);
    margin-top: .25rem; }
  /* Chips-combobox (multiselect): chips + search inside one field, list below. */
  .flt-msfield { flex: 1 1 20rem; min-width: min(20rem, 100%); }
  .flt-msbox { display: flex; flex-wrap: wrap; gap: .25rem; align-items: center;
    border: 1px solid var(--bs-border-color); border-radius: .35rem;
    background: var(--bs-body-bg); padding: .25rem .35rem; cursor: text; }
  .flt-msbox:focus-within { border-color: var(--bs-primary); box-shadow: 0 0 0 .15rem rgba(13,110,253,.15); }
  .flt-mschip { display: inline-flex; align-items: center; gap: .2rem; font-size: .8rem;
    background: var(--bs-secondary-bg); border: 1px solid var(--bs-border-color);
    border-radius: .3rem; padding: .05rem .15rem .05rem .4rem; max-width: 100%; }
  .flt-mschip span { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 16rem; }
  /* hitobito's global stylesheet gives every input a fixed width -- undo it. */
  .flt-ms-input { border: 0 !important; outline: none !important; box-shadow: none !important;
    background: transparent; flex: 1 0 6rem; width: 6rem; min-height: 1.5rem;
    font-size: .85rem; padding: 0 .1rem; margin: 0; }
  .flt-ms-list { max-height: 240px; overflow: auto; border: 1px solid var(--bs-border-color);
    border-radius: .35rem; margin-top: .25rem; background: var(--bs-body-bg); }
  .flt-ms-row { display: flex; gap: .45rem; align-items: baseline; padding: .18rem .5rem;
    font-size: .85rem; cursor: pointer; text-align: left; }
  .flt-ms-row .flt-ms-tick { width: 1rem; flex: 0 0 auto; color: var(--bs-success); }
  .flt-ms-row .flt-ms-text { flex: 1 1 auto; text-align: left; }
  .flt-ms-row:hover { background: var(--bs-secondary-bg); }
  .flt-ms-row.hl { background: var(--bs-primary); color: #fff; }
  .flt-ms-row.hl .flt-ms-tick { color: #fff; }
  .flt-ms-row.sel .flt-ms-text { font-weight: 600; }
  .flt-empty-hint { color: var(--bs-secondary-color, #6c757d); font-size: .85rem; }
  /* Unapplied edits: a warning chip next to the buttons, a badge on the pane
     pill (visible even when the pane is collapsed), a highlighted Anwenden and
     the "Änderungen verwerfen" button -- all driven by .flt-dirty. */
  .flt-dirty-hint { display: none; align-items: center; gap: .35rem; padding: .2rem .55rem;
    border-radius: .35rem; background: var(--bs-warning-bg-subtle, #fff3cd);
    border: 1px solid var(--bs-warning-border-subtle, #ffe69c);
    color: var(--bs-warning-text-emphasis, #664d03); font-size: .8rem; }
  .flt-root.flt-dirty .flt-dirty-hint { display: inline-flex; }
  .flt-root.flt-dirty .flt-apply-btn { box-shadow: 0 0 0 .2rem rgba(255, 193, 7, .35); }
  .flt-discard-btn { display: none; }
  .flt-root.flt-dirty .flt-discard-btn { display: inline-block; }
  /* The "nicht angewendet" badge sits on the pane's toggle button (rendered in
     the filter line above); markDirty() flags the toggle via its
     data-pane-target. */
  .flt-dirty-pill { display: none; }
  .pane-toggle.flt-dirty .flt-dirty-pill { display: inline; }
  /* Schnellauswahl (presets): toggle links in the filter LINE above this pane
     (shared/wsjrdp/filtering/_line renders them; the styles stay here, with the
     rest of the filter's chrome, and the two partials are always rendered
     together). While the builder has unapplied edits every toggle is locked
     (aria-disabled + no href, set by the JS) and the bar explains why -- a
     preset applies at once, which would silently throw those edits away. */
  .flt-presets { row-gap: .35rem; }
  /* "Filter zurücksetzen": the outline-danger button reads red in border AND
     text -- hitobito's `.btn { color }` rule would keep the text dark -- and
     white on the filled hover state. */
  .flt-reset-btn { color: var(--bs-danger, #dc3545); }
  .flt-reset-btn:hover, .flt-reset-btn:focus-visible { color: #fff; }
  /* A toggle is a normal small hitobito outline button. ON = a light primary
     tint with the primary border, so the (theme-forced, dark) button text keeps
     its contrast -- hitobito's `.btn { color }` rule overrides Bootstrap's white
     text, which made a filled btn-secondary unreadable -- plus a small round
     tick indicator: empty when off, primary-filled with a white check when on. */
  .flt-preset { display: inline-flex; align-items: center; gap: .4rem; }
  .flt-preset[aria-pressed="true"] { background: rgba(var(--bs-primary-rgb, 33, 105, 124), .12);
    border-color: var(--bs-primary, #21697c); }
  .flt-preset[aria-pressed="true"]:hover { background: rgba(var(--bs-primary-rgb, 33, 105, 124), .2);
    border-color: var(--bs-primary, #21697c); }
  .flt-preset-tick { width: .95rem; height: .95rem; border-radius: 50%; flex: 0 0 auto;
    border: 1.5px solid currentColor; opacity: .65; display: inline-grid; place-items: center; }
  .flt-preset-tick .fas { font-size: .6rem; line-height: 1; }
  .flt-preset[aria-pressed="true"] .flt-preset-tick { opacity: 1; background: var(--bs-primary, #21697c);
    border-color: var(--bs-primary, #21697c); color: #fff; }
  .flt-preset[aria-disabled="true"] { pointer-events: none; opacity: .55; }
  .flt-preset-lock-note { display: none; color: var(--bs-warning-text-emphasis, #664d03); }
  .flt-presets.flt-locked .flt-preset-lock-note { display: inline; }
  /* A user slot one of the Schnellauswahl's buttons speaks for -- a preset's own
     slot, or the one a group of buttons shares -- marked with a left accent
     stripe. Cosmetic only -- the server decides which button is pressed. */
  .flt-slot-preset { box-shadow: inset 3px 0 0 var(--bs-primary, #0d6efd); }
  @media (max-width: 575.98px) {
    .flt-editor-grid { flex-direction: column; align-items: stretch; }
    .flt-editor-grid select, .flt-operands, .flt-operands input, .flt-msfield { width: 100%; }
    .flt-operands { flex-direction: column; align-items: stretch; }
    .flt-mschip span { max-width: 11rem; }
  }

-# The pane has no pill of its own: its toggle is the "Filter" button at the
-# right end of the filter line above (data-pane-target = this id). The pane
-# opens BETWEEN that line and the toolbar and is `display: none` when closed, so
-# nothing above it moves; the line's frame and the open pane's frame join into
-# one box (see the .flt-pane rules in shared/wsjrdp/_expandable_table_styles).
.wsjrdp-pane.flt-pane{id: et_pane_id(state), class: ("open" if open), data: {pane_cookie: pane_cookie}}
  .pane-body
    .flt-root{class: ("flt-disabled" if disabled), data: {catalog: catalog.to_json, value: value.to_json, locked: locked.to_json, locked_catalog: locked_catalog.to_json, condensed_locked: condensed_locked.to_s, disabled: disabled.to_s, presets: presets.map { |p| {key: p.key, label: p.label, slots: p.slots, group: p.group, attribute: p.attribute, value: p.value, group_values: p.group_values} }.to_json, presets_bar: presets_id}}
      .flt-slots
      - unless disabled
        .d-flex.flex-wrap.align-items-center.gap-2.mt-2
          = form_tag apply_url, method: :post, class: "d-inline flt-apply-form booking-scroll-form" do
            = hidden_field_tag :filter_json, value.to_json, id: nil, class: "flt-json"
            -# Nested hashes / arrays among the carried page params must keep
            -# Rack's bracket notation -- see et_hidden_params.
            = et_hidden_params(carry)
            %button.btn.btn-sm.btn-primary.flt-apply-btn{type: "submit"} Anwenden
          %button.btn.btn-sm.btn-outline-secondary.flt-discard-btn{type: "button", title: "Die noch nicht angewendeten Änderungen verwerfen"} Änderungen verwerfen
          %span.flt-dirty-hint
            %i.fas.fa-exclamation-triangle{"aria-hidden": "true"}
            Änderungen noch nicht angewendet
          -# "Filter zurücksetzen" throws the user's conditions away, so it sits
          -# apart from the editing buttons -- at the right end of the row -- and
          -# wears the outline-danger colour hitobito uses for destructive actions.
          = link_to "Filter zurücksetzen", reset_url, class: "btn btn-sm btn-outline-danger flt-reset-btn ms-auto",
            title: "Alle eigenen Bedingungen entfernen und den Standardfilter dieser Tabelle anwenden"

:javascript
  (function () {
    function initRoot(root) {
      if (root.dataset.init) return;
      root.dataset.init = "1";

      var catalog = JSON.parse(root.dataset.catalog);
      var value = JSON.parse(root.dataset.value || "[]");
      var locked = JSON.parse(root.dataset.locked || "[]");
      var lockedCatalog = JSON.parse(root.dataset.lockedCatalog || "{}");
      var condensedLocked = root.dataset.condensedLocked === "true";
      var disabled = root.dataset.disabled === "true";
      var presets = JSON.parse(root.dataset.presets || "[]");
      var presetsBar = document.getElementById(root.dataset.presetsBar || "");
      var initialJson = JSON.stringify(value);
      var slotsEl = root.querySelector(".flt-slots");
      var form = root.querySelector(".flt-apply-form");
      var jsonInput = root.querySelector(".flt-json");
      var attrs = catalog.attributes;
      // For LABELLING locked conditions the host may hand a wider catalog
      // (locked slots can use attributes the user picker does not offer).
      var labelAttrs = attrs.concat((lockedCatalog.attributes || []).filter(function (a) {
        return !attrs.some(function (b) { return b.key === a.key; });
      }));
      // editor: {si, ci|null, attrKey, opKey, sel: [values], raw: [strings]}
      var editor = null;

      form.addEventListener("submit", function () {
        if (editor) commitIfValid();
        jsonInput.value = JSON.stringify(value);
      });

      // "Änderungen verwerfen": back to the APPLIED filter (the value the page
      // was rendered with), dropping every unapplied edit and any open editor.
      var discard = root.querySelector(".flt-discard-btn");
      if (discard) {
        discard.addEventListener("click", function () {
          editor = null;
          value = JSON.parse(initialJson);
          render();
        });
      }

      // ----- catalog helpers ----------------------------------------------
      function attrByKey(k) {
        for (var i = 0; i < labelAttrs.length; i++) if (labelAttrs[i].key === k) return labelAttrs[i];
        return null;
      }
      function opByKey(attr, k) {
        for (var i = 0; i < attr.operators.length; i++) if (attr.operators[i].key === k) return attr.operators[i];
        return null;
      }
      function variantMembers(group) {
        return attrs.filter(function (a) { return a.variant_group === group; });
      }
      // Picker entries: attributes, with each variant_group collapsed to one
      // entry (labelled by the group, keyed by its first member).
      function pickerEntries() {
        var seen = {}, entries = [];
        attrs.forEach(function (a) {
          if (a.variant_group) {
            if (seen[a.variant_group]) return;
            seen[a.variant_group] = true;
            entries.push({key: a.key, label: a.variant_group, group: a.group});
          } else {
            entries.push({key: a.key, label: a.label, group: a.group});
          }
        });
        return entries;
      }
      function pickerKeyFor(attrKey) {
        var a = attrByKey(attrKey);
        if (a && a.variant_group) return variantMembers(a.variant_group)[0].key;
        return attrKey;
      }
      function optionLabel(attr, v) {
        var values = attr.options && attr.options.values;
        if (values) for (var i = 0; i < values.length; i++) if (values[i][0] === String(v)) return values[i][1];
        return String(v);
      }
      function el(tag, cls, text) {
        var node = document.createElement(tag);
        if (cls) node.className = cls;
        if (text !== undefined) node.textContent = text;
        return node;
      }
      // FontAwesome 5 icons, same set hitobito uses elsewhere (fas fa-*).
      function icon(name) {
        var i = el("i", "fas fa-" + name);
        i.setAttribute("aria-hidden", "true");
        return i;
      }
      function shorten(s, n) { return s.length > n ? s.slice(0, n - 1) + "…" : s; }
      function fmtOperand(attr, v) {
        if (attr.control === "multiselect" || attr.control === "select") return shorten(optionLabel(attr, v), 28);
        if (attr.control === "date_range") {
          var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(v));
          if (m) return m[3] + "." + m[2] + "." + m[1];
          var mo = /^(\d{4})-(\d{2})$/.exec(String(v));
          if (mo) return mo[2] + "." + mo[1];
          return String(v);
        }
        if (attr.control === "number_range" && typeof v === "number") return v.toLocaleString("de-DE");
        return String(v);
      }
      function condText(cond) {
        var attr = attrByKey(cond[0]);
        if (!attr) return {label: cond[0], op: cond[1], operands: cond.slice(2).join(", ")};
        var op = opByKey(attr, cond[1]);
        var operands = cond.slice(2);
        // "ist eines von" etc. makes the ANY-of semantics of a multi-select visible
        var opLabel = op ? ((operands.length > 1 && op.label_many) ? op.label_many : op.label) : cond[1];
        var shown;
        if (!operands.length) shown = "";
        else if (op && op.arity === "two") shown = fmtOperand(attr, operands[0]) + " – " + fmtOperand(attr, operands[1]);
        else if (operands.length > 2) shown = fmtOperand(attr, operands[0]) + " +" + (operands.length - 1);
        else shown = operands.map(function (v) { return fmtOperand(attr, v); }).join(", ");
        return {label: attr.label, op: opLabel, operands: shown};
      }
      // Full, untruncated operand text for the hover tooltip (condFullText):
      // option labels and long value lists are shown in full, so a chip that is
      // too small to display everything still explains itself completely.
      function fmtOperandFull(attr, v) {
        if (attr.control === "multiselect" || attr.control === "select") return optionLabel(attr, v);
        return fmtOperand(attr, v);
      }
      function condFullText(cond) {
