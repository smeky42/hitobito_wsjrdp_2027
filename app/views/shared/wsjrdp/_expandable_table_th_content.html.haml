-#
-#  What a column's header holds (shared/wsjrdp/_expandable_table_th, and
-#  each header of a flow cell): the label (a header_label may break into
-#  lines), its sort link or fixed arrow, its rank and its sort variant chips.
-#  Locals: col, state, condensed, sort_links, sort_names, multi_sort,
-#  show_ranks, sort_list
- label = (condensed && col[:condensed_label]) || col[:header_label] || col[:label]
-# A header_label may break into lines ("Beitrag\nRegulär").
- label = safe_join(label.to_s.split("\n"), tag.br) if label.to_s.include?("\n")
- variants = Array(col[:sort_variants])
- level = (et_sort_level_of_column(state, col[:key]) if show_ranks)
- if sort_links && col[:sort_key]
  = et_sort_link(state, col[:sort_key], label, first: col[:sort_first] || "asc", names: sort_names, multi: multi_sort)
- else
  -# A fixed sort (D8.8) is rendered without a link -- as a
  -# courtesy, not as the protection: the ORDER BY comes from the
  -# state either way.
  = label
  - if col[:sort_key] && (fixed_dir = Wsjrdp::ExpandableTableSort.dir_of(sort_list, col[:sort_key]))
    = et_sort_arrow(fixed_dir)
- if level
  = et_sort_rank_box(state, level, names: sort_names, removable: sort_links)
- if variants.any?
  -# The column's sort variants, one chip each ("ist ⇅").
  .exp-sort-chips
    - variants.each do |variant|
      - if sort_links
        = et_sort_link(state, variant[:key], variant[:label], first: variant[:first], names: sort_names, multi: multi_sort, css_class: "exp-sort-chip")
      - elsif (fixed_dir = Wsjrdp::ExpandableTableSort.dir_of(sort_list, variant[:key]))
        %span.exp-sort-chip.exp-sort-active
          = variant[:label]
          = et_sort_arrow(fixed_dir)
