-#
-#  The checkbox of three states in the columns menu
-#  (shared/wsjrdp/_expandable_table_columns_form), a tristate column's and
-#  the page links': auto a white "A" in the filled box, always a tick, never
-#  empty; after the label the state's name, muted.
-#
-#  Locals: mode ("auto", "always" or "never"), label
%span.exp-cols-links-box{ class: ("on" unless mode == "never") }
  - if mode == "auto"
    %span.exp-cols-links-auto A
  - elsif mode == "always"
    = icon(:check)
%span.small= label
%span.small.exp-cols-links-state= {"auto" => "auto", "always" => "immer", "never" => "nie"}[mode]
