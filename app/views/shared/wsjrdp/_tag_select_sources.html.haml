-#
-#  The suggestions of the tag selects with a source (content types and
-#  extensions, Wsjrdp::TagSelectHelper#wsjrdp_marcel_sources) as JSON
-#  scripts, which shared/wsjrdp/_tag_select_js reads. Emitted once per
-#  response.
- return if @wsjrdp_tag_select_sources_emitted
- @wsjrdp_tag_select_sources_emitted = true
- wsjrdp_marcel_sources.each do |key, list|
  %script{type: "application/json", id: "wsjrdp-tag-source-#{key}"}= list.to_json.html_safe
