-#
-#  Keeps the set of open detail rows in the URL query string, so the open/closed
-#  state is bookmarkable and survives a reload (D4). The server renders the
-#  matching rows open; this only writes the URL back on toggle. ONE delegated,
-#  window-guarded listener serves every table on the page: a toggled detail is
-#  attributed to its own table (the nearest .exp-table-wrap, which carries the
-#  table's open param in data-open-param), and only that table's own rows are
-#  written under that param -- a nested table inside a detail must neither add
-#  its rows to the outer table's param nor the outer rows to its own. A table
-#  living inside a turbo frame (a lazily loaded detail) has its own request URL,
-#  not the page's, so it never touches the page URL at all.
= render "shared/wsjrdp/relaxed_query_js"
:javascript
  (function () {
    if (window.__expOpenSync) return;
    window.__expOpenSync = true;
    function ownDetails(wrap) {
      return Array.prototype.filter.call(wrap.querySelectorAll(".exp-detail.show"), function (el) {
        return el.closest(".exp-table-wrap") === wrap;
      });
    }
    function sync(detail) {
      var wrap = detail.closest(".exp-table-wrap");
      if (!wrap || !wrap.dataset.openParam || wrap.closest("turbo-frame")) return;
      var open = ownDetails(wrap).map(function (el) { return el.dataset.expKey; }).filter(Boolean);
      var url = new URL(window.location);
      if (open.length) { url.searchParams.set(wrap.dataset.openParam, open.join(",")); }
      else { url.searchParams.delete(wrap.dataset.openParam); }
      // Mutating searchParams re-serialises the query as x-www-form-urlencoded,
      // re-encoding "," / "~" everywhere; wsjrdpRelaxedQuery.href rebuilds the
      // relative URL with them literal again (see doc/wsjrdp/url_encoding.md).
      window.history.replaceState({}, "", window.wsjrdpRelaxedQuery.href(url));
    }
    // The detail row is the LAST row of its group, so with sub-rows between the
    // two it is not the open row's next sibling any more and CSS cannot reach it
    // by adjacency. Mark it instead: the server renders .exp-open on a row that
    // starts open, this keeps the class in sync (see the .exp-open rule in
    // shared/wsjrdp/_expandable_table_styles). The row of the OWN detail is the
    // nearest one, so a nested table's detail marks its own row, not the outer.
    function markOpen(detail, open) {
      var row = detail.closest("tr.exp-detail-row");
      if (row) row.classList.toggle("exp-open", open);
    }
    function onToggle(e) {
      if (!(e.target.classList && e.target.classList.contains("exp-detail"))) return;
      markOpen(e.target, e.type === "shown.bs.collapse");
      sync(e.target);
    }
    document.addEventListener("shown.bs.collapse", onToggle);
    document.addEventListener("hidden.bs.collapse", onToggle);
  })();

  (function () {
    // A pane's frame answers a save with the flash INSIDE the frame
    // (WsjrdpFormHelper#wsjrdp_detail_frame_flash) -- which is below the header
    // line of links the table renders ABOVE the frame. Lift the message over
    // that line, to the top of the open detail, where the eye goes first. A
    // message lifted earlier belongs to the content the frame just replaced
    // and goes away with it. Delegated + window-guarded like the rest.
    if (window.__expFrameFlash) return;
    window.__expFrameFlash = true;
    document.addEventListener("turbo:frame-render", function (e) {
      var frame = e.target;
      var detail = frame.parentElement;
      if (!detail || !detail.classList.contains("exp-detail")) return;
      detail.querySelectorAll(":scope > .alert").forEach(function (old) { old.remove(); });
      var alerts = frame.querySelectorAll(":scope > .alert");
      for (var i = alerts.length - 1; i >= 0; i--) detail.prepend(alerts[i]);
    });
  })();

  (function () {
    // The sort controls (Wsjrdp::ExpandableTableSortHelper): a shift-click on
    // a sort link or a rank box follows its data-shift-href instead of the
    // link (a browser would open a shift-clicked link in a new window), and
    // dragging a level of the "Sortiert nach" bar reorders the sort. Both
    // navigate through a throwaway link next to the control, so Turbo, a
    // surrounding turbo frame and the scroll keeper below treat them exactly
    // like the plain sort links.
    if (window.__expSortControls) return;
    window.__expSortControls = true;
    function follow(origin, href) {
      var link = document.createElement("a");
      link.href = href;
      link.className = "exp-sort";
      link.hidden = true;
      origin.parentNode.appendChild(link);
      link.click();
      link.remove();
    }
    function shiftControl(e) {
      return e.shiftKey && e.target.closest ? e.target.closest("[data-shift-href]") : null;
    }
    // Shift + mousedown would extend the text selection first.
    document.addEventListener("mousedown", function (e) {
      if (shiftControl(e)) e.preventDefault();
    });
    document.addEventListener("click", function (e) {
      var control = shiftControl(e);
      if (!control) return;
      e.preventDefault();
      follow(control, control.getAttribute("data-shift-href"));
    });
    var dragged = null;
    document.addEventListener("dragstart", function (e) {
      var level = e.target.closest && e.target.closest(".exp-sort-level[draggable]");
      if (!level) return;
      dragged = level;
      level.classList.add("exp-sort-dragging");
      e.dataTransfer.effectAllowed = "move";
      e.dataTransfer.setData("text/plain", level.getAttribute("data-sort-token"));
    });
    document.addEventListener("dragover", function (e) {
      var level = dragged && e.target.closest && e.target.closest(".exp-sort-level");
      if (!level || level.parentNode !== dragged.parentNode) return;
      e.preventDefault();
      if (level === dragged) return;
      var box = level.getBoundingClientRect();
      level.parentNode.insertBefore(dragged, e.clientX > box.left + box.width / 2 ? level.nextSibling : level);
    });
    document.addEventListener("drop", function (e) {
      if (dragged) e.preventDefault();
    });
    document.addEventListener("dragend", function () {
      if (!dragged) return;
      var bar = dragged.closest(".exp-sort-bar");
      dragged.classList.remove("exp-sort-dragging");
      dragged = null;
      var tokens = Array.prototype.map.call(bar.querySelectorAll(".exp-sort-level"), function (el) {
        return el.getAttribute("data-sort-token");
      });
      var url = new URL(bar.getAttribute("data-sort-base-href"), window.location.href);
      var param = bar.getAttribute("data-sort-param");
      if (tokens.join(",") === url.searchParams.get(param)) return;
      url.searchParams.set(param, tokens.join(","));
      follow(bar, window.wsjrdpRelaxedQuery.href(url));
    });
  })();

  (function () {
    // THE scroll-position keeper for the whole finance area: preserve the
    // vertical scroll position across a table's paging / sorting / page-size
    // navigation AND across the reload of any form that reloads the page in
    // place (form.booking-scroll-form -- the filter apply form, the column
    // picker, the reconciliation connect/assign forms). Turbo Drive otherwise
    // scrolls to the top, which on a long page feels like the position jumps.
    // Delegated + window-guarded, so it covers every expandable table on the
    // page and survives Turbo visits.
    if (window.__expScrollKeep) return;
    window.__expScrollKeep = true;
    var KEY = "wsjrdp.exptbl.scroll";
    function remember() { try { sessionStorage.setItem(KEY, String(window.scrollY || document.documentElement.scrollTop || 0)); } catch (e) {} }
    // A control inside a turbo frame navigates the frame, not the page --
    // unless it targets the page itself --, so there is nothing to keep.
    function reloadsPage(el) {
      return !el.closest("turbo-frame") || el.getAttribute("data-turbo-frame") === "_top";
    }
    document.addEventListener("click", function (e) {
      var link = e.target.closest(".bk-pagination a, a.exp-sort");
      if (link && reloadsPage(link)) remember();
    });
    document.addEventListener("change", function (e) {
      var select = e.target.closest && e.target.closest(".bk-per-select");
      if (select && reloadsPage(select)) remember();
    });
    document.addEventListener("submit", function (e) {
      if (e.target.matches && e.target.matches("form.booking-scroll-form") && reloadsPage(e.target)) remember();
    });
    function restore() {
      var y;
      try { y = sessionStorage.getItem(KEY); } catch (e) { return; }
      if (y === null) return;
      try { sessionStorage.removeItem(KEY); } catch (e) {}
      requestAnimationFrame(function () { requestAnimationFrame(function () { window.scrollTo(0, parseInt(y, 10) || 0); }); });
    }
    document.addEventListener("turbo:load", restore);
    if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", restore);
    else restore();
  })();
