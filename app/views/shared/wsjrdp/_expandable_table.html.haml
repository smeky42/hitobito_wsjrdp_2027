-#
-#  THE shared table widget. One row = one clickable summary row + a per-row
-#  expandable detail row (Bootstrap collapse; several open at once). Every extra
-#  element is optional and off by default, so a bare call renders just a table;
-#  turning options on adds a filter, a summary line, paging, a column hamburger,
-#  row selection, sortable headers, etc. Several independent tables coexist on
-#  one page via distinct `prefix`es. FULL GUIDE: doc/wsjrdp/expandable_table.md.
-#
-#  Core locals:
-#    state     -- the controller-resolved Wsjrdp::TableState (REQUIRED): param
-#                 namespace, sort, visible columns, page size, page, open rows,
-#                 filter and nesting level. The widget reads the state, never
-#                 params (D8.4 of doc/plans/2026-09_expandable-table-state.md).
-#    columns   -- [{ key:, label:, cell: ->(row){..}, numeric:, width:,
-#                    sort_key:, css_class:, condensed_label:, header_label:, header_tooltip:, group:, grow:, tabular_nums:, merge:, merge_share:, header_align:, merged_cell:, mobile:, abbr: }]
-#                    (FULL set)
-#    rows      -- the collection (a Kaminari page when paginating, else any list)
-#    row_key   -- ->(row){ String } unique key (URL param + DOM id + selection)
-#    detail     -- ->(row){ html }   server-rendered detail  (OR)
-#    detail_src -- ->(row){ url }     lazy-loaded detail (turbo frame)
-#    detail_top / detail_extra -- ->(row){ html } injected at the top / bottom
-#                 of each detail (see fin/bookings/_booking_detail for the slots)
-#    detail_page  -- ->(row){ path } the primary "Detailseite" double link of the
-#                 detail's header line [t.detail_page]
-#    detail_links -- [{label:, icon:, title:, title_new_tab:, url: ->(row){..}}]
-#                 further double links, LEFT of the primary one [t.detail_link]
-#    id_prefix -- DOM id prefix (default: the state's prefix, else "exp")
-#    sub_rows  -- ->(row){ [sub, ..] } the rows THIS row brings with it, drawn
-#                 right after it inside the same tbody.exp-group
-#    sub_cell  -- ->(sub, col){ html } one sub-row cell (required with sub_rows)
-#    sub_row_class / group_class -- ->(sub){ css } / ->(row){ css }
-#    view      -- {label:, options: [[value, text], ..]} the view switch in the
-#                 toolbar, one segment per view the policy declares [t.view]
-#    footer    -- ->(col){ html } one cell of a footer row (a sum row) under
-#                 the rows, per visible column [t.footer]
-#  Optional feature locals (see the guide): multi_sort, pagination, per_options,
-#    columns_menu, summary, selection, filter, condensed.
- state = local_assigns.fetch(:state)
- prefix = state.prefix
- id_prefix = local_assigns.fetch(:id_prefix, prefix.presence || "exp")
- detail = local_assigns.fetch(:detail, nil)
- detail_src = local_assigns.fetch(:detail_src, nil)
- detail_top = local_assigns.fetch(:detail_top, nil)
- detail_extra = local_assigns.fetch(:detail_extra, nil)
-# The detail's header line (shared/wsjrdp/_detail_links): right-aligned double
-# links, the primary "Detailseite" one rightmost. It is the ONLY place a row
-# links to its own page -- the summary row carries no action cell.
- detail_page = local_assigns.fetch(:detail_page, nil)
- detail_links = Array(local_assigns.fetch(:detail_links, nil))
- has_detail_links = !(detail_page.nil? && detail_links.empty?)
-# The per-row detail is optional like every other element: a table that declares
-# neither `detail` nor `detail_src` (the Moss wallet -- its rows show everything
-# its detail page would repeat) still gets a detail row when it declares links,
-# holding the header line alone. Without both it gets NO detail row, and its
-# rows are not disclosure controls, so they carry neither role="button" nor the
-# collapse trigger.
- expandable = !(detail.nil? && detail_src.nil?) || has_detail_links
-# detail_if: ->(row){ bool } -- which rows of an expandable table open a
-# detail [t.detail_if]; nil = every row.
- detail_if = local_assigns.fetch(:detail_if, nil)
- detail_level = state.level
- param = state.param_name(:open)
- open_keys = state.open_keys
- condensed = local_assigns.fetch(:condensed, false)
- all_columns = local_assigns.fetch(:columns)
- columns_menu = local_assigns.fetch(:columns_menu, false)
-# extra_columns: host-injected columns appended after the (menu-managed) ones
-# and NOT part of the column picker -- e.g. the reconciliation match-proposal
-# column. Always shown.
- extra_columns = Array(local_assigns.fetch(:extra_columns, nil))
-# Visible columns + their order: resolved by the controller (the <prefix>c param
-# on top of the policy's default), matched to these column configs by key. The
-# controller also says which of the dataset's columns THIS table has and what it
-# calls them (cols: exclude: / labels:), so an excluded column is neither
-# rendered here nor offered in the picker below.
- columns = et_visible_columns(state, all_columns) + extra_columns
-# Sort: one <prefix>s param holds the sort keys + directions. A click on a sort
-# link sorts by that key alone, cycling its first direction / the opposite one /
-# off; a shift-click appends a level or steps it in place (Wsjrdp::
-# ExpandableTableSortHelper). When multi_sort is false there is no shift-click
-# and no rank. The list is the resolved, shown sort (the preselected default
-# included, the policy's hidden sort not), so the arrows show what was chosen.
- multi_sort = local_assigns.fetch(:multi_sort, true)
- sort_list = state.sort_list
- sort_links = !state.fixed?(:sort)
- sort_names = et_sort_names(state, all_columns)
- show_ranks = multi_sort && sort_list.size >= 2
-# The "Sortiert nach" bar: in the toolbar, as soon as anything is sorted -- not
-# for a fixed sort and not in a condensed (embedded) table, which only shows
-# the rank boxes.
- sort_bar = sort_links && !condensed && sort_list.any?
- selection = local_assigns.fetch(:selection, nil)
-# on_filter_change: :clear (default) drops a remembered selection when the
-# filter changes. :narrow (keep the still-matching rows) is a planned option --
-# accepted here but not implemented yet.
- raise NotImplementedError, "expandable_table selection on_filter_change: :narrow is not implemented yet" if selection && selection[:on_filter_change].to_s == "narrow"
- pagination = local_assigns.fetch(:pagination, nil)
-# per_options is set by t.paging (with the builder's default list when the host
-# names none), so its presence IS "this table has paging". The two lines differ:
-# below the table the page-size select shows even on a single page, above it
-# only when there is more than one page -- see the paging partial.
- per_options = local_assigns.fetch(:per_options, nil)
- summary = local_assigns.fetch(:summary, nil)
- footer = local_assigns.fetch(:footer, nil)
- view = local_assigns.fetch(:view, nil)
- if view
  - declared_views = Array(state.policy.field(:view).options[:values])
  - unknown_views = view[:options].map { |value, _| value.to_s } - declared_views
  - raise ArgumentError, "expandable_table view options #{unknown_views.join(", ")} are not views the table declares" if unknown_views.any?
- filter = local_assigns.fetch(:filter, nil)
-# Sub-rows: a row may bring rows of its own. They are drawn right after it,
-# inside the same tbody.exp-group, through the table's VISIBLE columns -- so a
-# column hidden in the menu is hidden in every row of the group. They have no
-# detail of their own: on an expandable table they carry the head row's
-# disclosure attributes and toggle the group's ONE detail. Nothing about them
-# reaches Wsjrdp::ExpandableTableRows or the state (sorting, paging, the filter,
-# the selection, the open-rows param and the summary all count PARENT rows).
- sub_rows = local_assigns.fetch(:sub_rows, nil)
- sub_cell = local_assigns.fetch(:sub_cell, nil)
- sub_row_class = local_assigns.fetch(:sub_row_class, nil)
- group_class = local_assigns.fetch(:group_class, nil)
-# Same check as Wsjrdp::ExpandableTableBuilder#to_locals, for the (rare) host
-# that renders this partial without the builder.
- raise ArgumentError, "expandable_table declares sub_rows but no sub_cell -- a sub-row's cells are rendered by sub_cell(sub, col)" if sub_rows && sub_cell.nil?
- lead_cols = (selection ? 1 : 0)
- cols_count = lead_cols + columns.size
-# Growing columns and gaps (a column's `grow:`, t.gaps): the room a table has
-# beyond its columns' widths widens the growing columns first, then the gaps
-# (see the two stages below). A gap sits at the right of the column before it
-# (more padding, wider column), so the cells keep their content width. No gap
-# between two columns of one group or of one merged cell, none in the pairs of
-# `except:`; none in a condensed table.
- gaps = local_assigns.fetch(:gaps, nil)
- gap_keys = []
- if gaps
  - columns.each_with_index do |col, i|
    - nxt = columns[i + 1]
    - next unless nxt
    - next if col[:group].present? && nxt[:group] == col[:group]
    - next if col[:merge].present? && nxt[:merge] == col[:merge]
    - next if gaps[:except].include?([col[:key], nxt[:key]])
    - gap_keys << col[:key]
-# Two stages: the room first widens the columns with `grow:` -- --exp-c per
-# unit of weight, up to the gaps' grow_max --, only the rest the gaps
-# (--exp-g, up to max). Both in whole pixels (round down), so the column
-# widths stay whole pixels and their sum never outgrows the wrapper.
- grow_weight = columns.sum { |col| col[:grow].to_f }
- gap_count = gap_keys.size
- growing = (grow_weight + gap_count).positive? && !condensed
-# Merged columns (a column's `merge:`): neighbouring shown columns with one
-# merge key share ONE body cell; the host's merged_cell renders it from the row
-# and the keys of the run's shown columns (the first column's cell otherwise).
- body_runs = columns.chunk_while { |a, b| a[:merge].present? && a[:merge] == b[:merge] }.to_a
- run_classes = ->(run) { [run.first[:css_class], ("text-end text-nowrap" if run.first[:numeric]), ("exp-gap" if gap_keys.include?(run.last[:key])), ("exp-tnum" if run.first[:tabular_nums]), ("exp-merged" if run.size > 1), ("exp-no-mobile" if run.first[:mobile] == false)].compact }
- run_cell = ->(run, row) { run.first[:merged_cell] ? run.first[:merged_cell].call(row, run.map { |c| c[:key] }) : run.first[:cell].call(row) }
-# A merged run shares its width (the sum of its shown columns' widths) out by
-# `merge_share` -- evenly by default --, so its headers spread regularly.
- merged_widths = {}
- body_runs.select { |run| run.size > 1 && run.all? { |c| c[:width].to_s =~ /\A[\d.]+rem\z/ } }.each do |run|
  -# In whole pixels (1rem = 16px), the rest to the last column: the sum stays
  -# exactly the run's width, and the columns stay whole pixels for t.gaps.
  - total_px = (run.sum { |c| c[:width].to_f } * 16).round
  - shares = run.sum { |c| (c[:merge_share] || 1).to_f }
  - parts = run.map { |c| (total_px * (c[:merge_share] || 1).to_f / shares).floor }
  - parts[-1] += total_px - parts.sum
  - run.zip(parts).each { |c, px| merged_widths[c[:key]] = "#{(px / 16.0).round(4)}rem" }
- base_width = ->(col) { merged_widths[col[:key]] || col[:width] }
-# The headers of a merged run spread like space-between: the first at the
-# start, the last at the end, the others centred; a column's `header_align`
-# overrides that.
- merged_align = {}
- body_runs.select { |run| run.size > 1 }.each do |run|
  - run.each_with_index { |c, i| merged_align[c[:key]] = (i.zero? ? "start" : ((i == run.size - 1) ? "end" : "center")) }
- header_align = ->(col) { col[:header_align].presence || merged_align[col[:key]] }
- col_extra = ->(col) { [(("var(--exp-g)" if gap_keys.include?(col[:key]))), (("#{col[:grow].to_f} * var(--exp-c)" if col[:grow].to_f.positive?))].compact }
- col_width = ->(col) { (growing && col[:width] && col_extra.call(col).any?) ? "calc(#{([base_width.call(col)] + col_extra.call(col)).join(" + ")})" : base_width.call(col) }
- gap_max = gaps ? gaps[:max] : "0px"
- grow_max = gaps ? gaps[:grow_max] : "100cqw"
- min_rem = columns.sum { |c| (c[:width].to_s[/[\d.]+/]&.to_f) || 8.0 } + (selection ? 2.0 : 0)
-# With capped gaps the table stops widening at a known width; the filter and
-# the toolbar above it stop there too, so the column menu sits at the table's
-# right edge and the filter pane is never wider than the table.
- max_width_style = (growing && gaps) ? "max-width: calc(#{min_rem}rem + #{grow_weight} * #{grow_max} + #{gap_count} * #{gap_max})" : nil
- paging_top_html = (render "shared/wsjrdp/expandable_table_paging", state: state, pagination: pagination, per_options: per_options, place: :top) if per_options
- paging_bottom_html = (render "shared/wsjrdp/expandable_table_paging", state: state, pagination: pagination, per_options: per_options, place: :bottom) if per_options
-# The filter has its OWN two lines above the toolbar (the filter line and the
-# pane between it and the toolbar), so it does not make a toolbar by itself.
- has_toolbar = columns_menu || paging_top_html.present? || summary || view || (selection && selection[:all_param]) || sort_bar

= render "shared/wsjrdp/expandable_table_styles"
= render "shared/wsjrdp/row_click_guard"
- if selection
  = render "shared/wsjrdp/table_selection_js"

-# The filter: a fixed LINE (presets + applied chips + the pane's toggle),
-# then the pane, then the toolbar, then the table. Both lines are there in both
-# states -- opening the pane only makes it appear BETWEEN them, so nothing above
-# the pointer moves.
- if filter
  = render "shared/wsjrdp/collapsible_panes"
  - filter_disabled = filter.fetch(:disabled, false)
  -# Presets are declared EITHER in the controller's policy OR in the view
  -# (declaring both raises in Wsjrdp::ExpandableTableBuilder). Both end up in
  -# the same Wsjrdp::TableState::FilterPreset object; resolving them HERE, once,
  -# gives the line (which renders the bar) and the builder (which marks the
  -# matching slots) exactly the same list.
  - declared_presets = Array(filter[:presets])
  -# A view-declared GROUP resolves to one preset per member (state.filter.preset
  -# returns the Array), a slot preset to one -- hence the flat_map.
  - filter_presets = declared_presets.any? ? declared_presets.flat_map { |p| Array(state.filter.preset(**p.to_h.symbolize_keys)) } : state.filter.presets
  -# `panel: false`: the Schnellauswahl alone -- no pane, no toggle to open one.
  - filter_panel = filter.fetch(:panel, true)
  .exp-filter-limit{ style: max_width_style }
    = render "shared/wsjrdp/filtering/line", state: state,
      presets: filter_presets, disabled: filter_disabled, panel: filter_panel
    - if filter_panel
      = render "shared/wsjrdp/filtering/builder", state: state,
        apply_url: filter[:apply_url],
        presets: filter_presets,
        condensed_locked: filter.fetch(:condensed_locked, false),
        disabled: filter_disabled

-# The remembered selection is keyed per page AND per table, so two pages that
-# happen to share a prefix / id_prefix never see each other's selection.
- selection_key = selection && (selection[:remember_key] || "#{state.store_key}:#{prefix.presence || id_prefix}")
.bk-select-scope{ style: max_width_style, data: (selection ? {select_key: selection_key, filter_sig: (selection[:filter_sig] || state.wire(:filter)), select_name: selection[:name], select_form: selection[:form], on_filter_change: selection.fetch(:on_filter_change, "clear").to_s} : {}) }
  - if has_toolbar
    -# Left: summary, paging and the (optional) select-all bar. Right: the column
    -# hamburger, bottom-aligned so it sits at the bottom of a tall left block.
    -# Below a filter the toolbar keeps a small gap to the line/pane above it
    -# (.exp-toolbar-below-filter).
    .d-flex.flex-wrap.justify-content-between.align-items-end.gap-2.mb-2{ class: ("exp-toolbar-below-filter" if filter) }
      .d-flex.flex-column.gap-1.flex-grow-1{ style: "min-width: 0" }
        - if view
          -# The view switch: a link per view, the chosen one pressed. A view
          -# changes what the rows say, so the open details go with it.
          = render "shared/wsjrdp/filtering/preset_styles"
          .exp-view.d-flex.flex-wrap.align-items-center.gap-2.small
            %span.text-muted= view[:label]
            .btn-group.btn-group-sm.flt-segment{ role: "group", "aria-label": view[:label] }
              - view[:options].each do |value, text|
                = link_to text, et_url(state, {view: value, open: nil}),
                  class: "btn btn-outline-secondary flt-preset", role: "button",
                  aria: { pressed: (state.view == value.to_s).to_s }
        - if summary
          .text-muted.small= summary
        - if paging_top_html.present?
          = paging_top_html
        - if selection && selection[:all_param]
          .bk-select-bar.small{ style: "display: none", data: { total: selection[:total_count] } }
            %span.bk-select-info.text-muted
            %a.bk-select-all-pages.ms-2{ href: "#" }
            %a.bk-select-clear.ms-2{ href: "#" } Auswahl aufheben
            %input{ type: "hidden", name: selection[:all_param], value: "", form: selection[:form], class: "bk-select-all-field" }
      -# Between them, right-aligned next to the hamburger: the "Sortiert nach"
      -# bar.
      - if sort_bar
        = render "shared/wsjrdp/expandable_table_sort_bar", state: state, names: sort_names, multi: multi_sort
      -# Right: the table's controls as one joined group -- only the column
      -# hamburger; the filter toggle sits in the filter line above
      -# (shared/wsjrdp/filtering/_line), where it does not move when the pane
      -# opens. The group stays, so a further toolbar control would join it.
      - if columns_menu
        .exp-tools{ role: "group", "aria-label": "Tabelle einstellen" }
          - menu = capture do
            = render "shared/wsjrdp/expandable_table_columns_form", state: state, all_columns: all_columns
          = render "shared/wsjrdp/table_hamburger", id: "#{id_prefix}-colmenu", menu: menu

  .table-responsive.exp-table-wrap{ class: ("bk-condensed-wrap" if condensed), data: { exptbl: id_prefix, open_param: param } }
    - table_style = condensed ? nil : "min-width: #{min_rem}rem"
    - if growing
      - room = "(100cqw - #{min_rem}rem)"
      - c_expr = grow_weight.positive? ? "clamp(0px, round(down, #{room} / #{grow_weight}, 1px), #{grow_max})" : "0px"
      - g_expr = gap_count.positive? ? "clamp(0px, round(down, (#{room} - #{grow_weight} * var(--exp-c)) / #{gap_count}, 1px), #{gap_max})" : "0px"
      - table_style = "--exp-c: #{c_expr}; --exp-g: #{g_expr}; min-width: #{min_rem}rem; width: calc(#{min_rem}rem + #{grow_weight} * var(--exp-c) + #{gap_count} * var(--exp-g))"
    %table.table.table-hover.align-middle.mb-0.bookings-table{ class: ("bookings-table-condensed" if condensed), style: table_style }
      -# Column groups (a column's `group:`): the group's name over a bracket
      -# that spans exactly its columns, whose headers form a second row; every
      -# other header spans both rows, bottom-aligned with them. The fixed table
      -# layout takes its widths from the first row, which then holds the group
      -# cells -- so the widths go into a colgroup.
      - grouped = columns.any? { |col| col[:group].present? }
      - th_locals = {state: state, condensed: condensed, sort_links: sort_links, sort_names: sort_names, multi_sort: multi_sort, show_ranks: show_ranks, sort_list: sort_list, gap_keys: gap_keys, col_width: col_width, header_align: header_align}
      - if (grouped || growing) && !condensed
        %colgroup
          - if selection
            %col{ style: "width: 2rem" }
          - columns.each do |col|
            %col{ class: ("exp-no-mobile" if col[:mobile] == false), style: ("width: #{col_width.call(col)}" if col[:width]) }
      %thead
        - if grouped
          %tr.exp-col-groups
            - if selection
              %th.bk-select-cell{ rowspan: 2 }
                %input.form-check-input.bk-select-all{ type: "checkbox", "aria-label": "Alle auf dieser Seite aus-/abwählen" }
            - columns.chunk_while { |a, b| a[:group].present? && a[:group] == b[:group] }.each do |run|
              - if run.first[:group].present?
                -# The gap after the group stays out of the bracket.
                %th.exp-col-group.text-center.small.fw-normal.border-bottom-0.pb-0{ colspan: run.size, class: ("exp-gap" if gap_keys.include?(run.last[:key])) }
                  .exp-col-group-bracket= run.first[:group]
              - else
                = render "shared/wsjrdp/expandable_table_th", col: run.first, rowspan: 2, **th_locals
          %tr
            - columns.select { |col| col[:group].present? }.each do |col|
              = render "shared/wsjrdp/expandable_table_th", col: col, **th_locals
        - else
          %tr
            - if selection
              %th.bk-select-cell{ style: "width: 2rem" }
                %input.form-check-input.bk-select-all{ type: "checkbox", "aria-label": "Alle auf dieser Seite aus-/abwählen" }
            - columns.each do |col|
              = render "shared/wsjrdp/expandable_table_th", col: col, **th_locals
      - if rows.blank?
        %tbody
          %tr
            %td.text-muted.text-center.py-4{ colspan: cols_count } Keine Einträge gefunden.
      -# ONE tbody per row: the row, its sub-rows and its detail row are one
      -# GROUP, which is what lets the CSS separate the rows inside a group from
      -# the border that ends it. A table without sub-rows renders the same
      -# group, so there is one structure to style and to read.
      - rows.each do |row|
        - key = row_key.call(row).to_s
        - row_expandable = expandable && (detail_if.nil? || detail_if.call(row))
        - detail_id = "#{id_prefix}-#{key}"
        - is_open = open_keys.include?(key)
        -# The disclosure half of the group's rows -- the head row and each of
        -# its sub-rows carry it, so every one of them toggles the same detail.
        -# Built as a Hash so a table WITHOUT a detail emits none of these
        -# attributes at all (a nil inside the literal would still render
        -# role='' / tabindex='').
        - disclosure = row_expandable ? { role: "button", tabindex: 0,
          data: { "bs-toggle": "collapse", "bs-target": "##{detail_id}" },
          aria: { expanded: is_open.to_s, controls: detail_id } } : {}
        %tbody.exp-group{ class: (group_class && group_class.call(row)) }
          %tr.exp-row{ { class: (local_assigns[:row_class] && local_assigns[:row_class].call(row)) }.merge(disclosure) }
            - if selection
              %td.bk-select-cell
                - if !selection[:enabled] || selection[:enabled].call(row)
                  %input.form-check-input.bk-select-check{ type: "checkbox", name: selection[:name],
                    value: selection[:id_field].call(row), form: selection[:form], "aria-label": "Zeile auswählen",
                    data: (selection[:row_data] ? selection[:row_data].call(row) : {}) }
            - body_runs.each do |run|
              %td.exp-col{ class: run_classes.call(run), colspan: (run.size if run.size > 1), data: { colkey: run.first[:key] } }= run_cell.call(run, row)
          - Array(sub_rows && sub_rows.call(row)).each do |sub|
            -# A sub-row is a disclosure control like the row it belongs to: the
            -# SAME collapse target, so it opens and closes the group's one
            -# detail, and Bootstrap mirrors aria-expanded onto every trigger of
            -# that detail. A link or a button inside a sub-row keeps its own
            -# click (shared/wsjrdp/_row_click_guard).
            %tr.exp-sub-row{ { class: (sub_row_class && sub_row_class.call(sub)) }.merge(disclosure) }
              -# The selection belongs to the PARENT row: the sub-row gets the
              -# cell so the columns keep lining up, and nothing in it.
              - if selection
                %td.bk-select-cell
              - body_runs.each do |run|
                %td.exp-col.exp-sub-col{ class: run_classes.call(run), colspan: (run.size if run.size > 1), data: { colkey: run.first[:key] } }= sub_cell.call(sub, run.first[:merge].present? ? run.first.merge(merged_keys: run.map { |c| c[:key] }) : run.first)
          - if row_expandable
            -# The detail is the group's LAST row: it opens under the whole
            -# group, sub-rows included. exp-open marks the open one for the CSS
            -# (shared/wsjrdp/_expandable_table_js keeps it in sync on toggle) --
            -# with sub-rows in between, the detail row is no longer the open
            -# row's next sibling.
            %tr.exp-detail-row{ class: ("exp-open" if is_open) }
              %td.p-0{ colspan: cols_count }
                .collapse.exp-detail{ id: detail_id, class: ("show" if is_open), data: { "exp-key": key } }
                  - links_html = has_detail_links ? render("shared/wsjrdp/detail_links", row: row, detail_page: detail_page, detail_links: detail_links) : nil
                  - if detail_src
                    -# The header line stays OUTSIDE the turbo frame, above it: it
                    -# is there the moment the row opens, while the frame still
                    -# shows "Wird geladen …", and it survives the frame's later
                    -# replacement. .exp-detail-linkbar repeats the padding the
                    -# direct detail's .booking-detail.p-3 gives it, so the line
                    -# sits in the same place in both modes.
                    - if links_html.present?
                      .booking-detail.exp-detail-linkbar= links_html
                    -# The detail's nesting level travels in the frame URL so the
                    -# lazily-rendered partial knows it sits inside a table row.
                    - src = detail_src.call(row)
                    - src = "#{src}#{src.include?("?") ? "&" : "?"}#{state.param_name(:level)}=#{detail_level + 1}"
                    -# data-record names the row's record (dom_id), so a change made
                    -# elsewhere on the page can reload this detail once it has
                    -# loaded (the `reload_frames` stream action,
                    -# Fin::SubjectLinkingHelper#loaded_detail_frames_selector).
                    - frame_record = row.is_a?(ActiveRecord::Base) ? dom_id(row) : nil
                    = turbo_frame_tag wsjrdp_detail_frame_id(id_prefix, key), src: src, loading: "lazy", data: {record: frame_record}.compact do
                      .booking-detail.p-3.text-center.text-muted.small Wird geladen …
                  - elsif detail
                    .booking-detail.p-3
                      = links_html
                      - if detail_top && (top_html = detail_top.call(row)).present?
                        .mb-3= top_html
                      -# Detail lambdas may take (row) or (row, table_context).
                      = (detail.arity == 1) ? detail.call(row) : detail.call(row, Wsjrdp::TableContext.for_detail(detail_level, lazy: false))
                      - if detail_extra && (extra_html = detail_extra.call(row)).present?
                        .mt-3.pt-2.border-top= extra_html
                  - elsif links_html.present?
                    -# Links only (the Moss wallet): the detail row is the slim
                    -# header-line bar, nothing below it.
                    .booking-detail.exp-detail-linkbar.exp-detail-linkbar-only= links_html

      - if footer && rows.present?
        %tfoot
          %tr.exp-footer-row
            - if selection
              %td.bk-select-cell
            - columns.each do |col|
              %td.exp-col{ class: [col[:css_class], ("text-end text-nowrap" if col[:numeric]), ("exp-no-mobile" if col[:mobile] == false)].compact, data: { colkey: col[:key] } }= footer.call(col)

  - if paging_bottom_html.present?
    .mt-2= paging_bottom_html

= render "shared/wsjrdp/expandable_table_js"
