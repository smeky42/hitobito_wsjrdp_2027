-#
-#  One small table of a bulk action's preview
-#  (shared/wsjrdp/_expandable_table_bulk_preview), scrolling in a box of its own.
-#
-#  Locals: rows, cols (column Hashes with :label, :cell, optional :numeric)
.bk-bulk-preview-list
  %table.table.table-sm.small.mb-0
    %thead
      %tr
        - cols.each do |col|
          %th{class: ("text-end" if col[:numeric])}= col[:label]
    %tbody
      - rows.each do |row|
        %tr
          - cols.each do |col|
            %td{class: ("text-end text-nowrap" if col[:numeric])}= col[:cell].call(row)
