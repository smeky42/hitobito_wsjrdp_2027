-#
-#  Shared metadata list of an item detail view (label left, value right).
-#  Used by the Buchhaltung item details (accounts / cost centers / suppliers)
-#  and the DATEV booking detail. Blank values are dropped.
-#
-#  Locals: fields -- [[label, value], ...]
- shown = fields.reject { |(_label, value)| value.blank? }
- if shown.any?
  %dl.row.small.mb-3
    - shown.each do |label, value|
      %dt.col-sm-3.col-lg-2.fw-normal.text-muted.mb-1= label
      %dd.col-sm-9.col-lg-10.mb-1.text-break= value
