-#
-#  The core's household line under the contact data, with the contingent
-#  role before each name (Wsjrdp2027::PeopleHelper#wsjrdp_render_household),
-#  and below it the other family members the same way, with how they are
-#  related (#wsjrdp_render_family_chips) -- these for whoever sees the
-#  person's details, as the aside's section.
-#
-#  Whoever may edit them gets an edit icon behind the caption: the core's
-#  household page (:create_households, as its aside) and the family page
-#  (:update_family).
- group = @group || person.default_group
- if person.household_people.present?
  = render_extensions 'household_attrs'
  .wsjrdp-household-attrs
    %small.d-block
      = t('people.contact_data.lives_in_household_with')
      - if can?(:create_households, person)
        = link_to(icon(:edit), edit_group_person_household_path(group.id, person.id),
          class: 'wsjrdp-household-edit ms-1', title: 'Haushalt bearbeiten', data: {turbo_frame: '_top'})
    = wsjrdp_render_household(person)
- if FeatureGate.enabled?("people.family_members") && can?(:show_details, person) && person.family_members.any?
  .wsjrdp-household-attrs
    %small.d-block
      Andere Familienmitglieder
      - if can?(:update_family, person)
        = link_to(icon(:edit), edit_person_family_members_path(person),
          class: 'wsjrdp-household-edit ms-1', title: 'Familienmitglieder bearbeiten')
    = wsjrdp_render_family_chips(person)
