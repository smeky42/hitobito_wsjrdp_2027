-#
-#  The progress of a registration in the background
-#  (Wsjrdp2027::RegisterDocumentsJob): people and files done, elapsed time and
-#  the rest (shared/wsjrdp/_tracked_job_progress).
= render "shared/wsjrdp/tracked_job_progress", job: Wsjrdp2027::RegisterDocumentsJob,
  id: "registration-documents-progress", figures: %w[people files],
  progress_url: document_management_registration_documents_progress_path,
  cancel_url: document_management_cancel_registration_documents_path
