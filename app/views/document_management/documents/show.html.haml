-#
-#  A document's page, and the lazy detail of its row in the Dokumente list:
-#  the frame answers the id the requesting row names (wsjrdp_detail_frame).

- title(t("document_management.document.title", id: @document.id)) unless turbo_frame_request?
= wsjrdp_detail_frame("doc", @document.id) do
  = render "detail", document: @document
