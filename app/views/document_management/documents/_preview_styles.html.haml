-#
-#  The look of a document's preview (_detail) and of the comparison
-#  (_preview): two panes side by side, one above the other (is-rows) or one
-#  alone (is-single). The toggle's chevron turns with aria-expanded, which
-#  Bootstrap keeps up to date.
:css
  /* The derivations (_rows_table): whole words, a file name
     broken anywhere -- the row's detail around them breaks anywhere. */
  .document-rows :is(th, td) { overflow-wrap: normal; }
  .document-rows td.document-rows-filename { overflow-wrap: anywhere; }
  .document-rows .document-rows-sort { font: inherit; color: inherit; text-decoration: none; border: 0;
    vertical-align: baseline; }
  .document-rows .document-rows-sort-mark { color: var(--bs-gray-500, #adb5bd); font-weight: normal; margin-left: .1rem; }
  .document-rows .document-rows-sort.is-sorted .document-rows-sort-mark { color: var(--bs-primary); }
  /* A versions table (_versions_table): the footer of the
     L and R buttons only once one of them shows. */
  .document-versions-table tfoot:not(:has(button:not([hidden]))) { display: none; }
  .document-versions-table .document-rows-end-icon, .document-rows .document-rows-end-icon { display: inline-block; width: 1.1em; margin-right: .3rem; text-align: center; }
  .document-preview { margin-bottom: 1.5rem; }
  .document-preview-toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; margin-bottom: .5rem; }
  .document-preview-toolbar > * { margin-bottom: 0; }
  .document-preview-toolbar h3 { margin: 0 .5rem 0 0; padding: 0; line-height: 1.5; }
  .document-compare-clear td { border-bottom: 0; padding-top: 0; }
  .document-preview-panes { display: grid; gap: .75rem; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .document-preview-panes.is-rows, .document-preview-panes.is-single { grid-template-columns: minmax(0, 1fr); }
  .document-preview-head { display: flex; align-items: baseline; gap: .5rem; font-size: .875rem; color: var(--bs-gray-600); margin-bottom: .25rem; }
  .document-preview-side { font-weight: 600; color: var(--bs-body-color); }
  .document-preview-time { font-variant-numeric: tabular-nums; }
  .document-preview-frame { display: block; width: 100%; height: 75vh; min-height: 24rem; border: 1px solid var(--bs-gray-300); border-radius: .25rem; }
  .document-preview-image { display: block; max-width: 100%; max-height: 75vh; border: 1px solid var(--bs-gray-300); border-radius: .25rem; }
  .document-preview-note { padding: 1rem; border: 1px dashed var(--bs-gray-400); border-radius: .25rem; color: var(--bs-gray-600); background: var(--bs-gray-100); }
  .document-preview-toggle .fa-chevron-down { transition: transform .15s ease-in-out; }
  .document-preview-toggle[aria-expanded="true"] .fa-chevron-down { transform: rotate(180deg); }
  @media (prefers-reduced-motion: reduce) { .document-preview-toggle .fa-chevron-down { transition: none; } }
