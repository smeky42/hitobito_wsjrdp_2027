-#
-#  Alle (first tab of the main section Dokumente): every document as an
-#  expandable table. Its filter, presets, sort and page size come from the
-#  controller's policy; a row opens the document's page (show) as its lazy
-#  detail.

- title(t("document_management.tabs.documents"))
= render "document_management/documents/list_styles"

#main
  %h1= t("document_management.tabs.documents")
  %p.text-muted= t("document_management.documents.lead")

  = wsjrdp_expandable_table do |t|
    - t.rows documents, id: "doc"
    - t.columns document_table_columns(people_by_id), menu: true
    - t.gaps max: "1.5rem", grow_max: "12rem"
    - t.row_key { |document| document.id }
    - t.detail_page(column: true) { |document| document_management_document_path(document) }
    - t.detail_src { |document| document_management_document_path(document) }
    - t.paging
    - t.filter apply_url: document_management_apply_documents_path

  %p.text-muted.small.mt-2#documents-shown
    = t("document_management.documents.shown", count: documents.total_count)
