-#
-#  A document group's page, and the lazy detail of its row in the tab Nach
-#  Person und Art: the frame answers the id the requesting row names
-#  (wsjrdp_detail_frame).

- title(document_group_title(@document_group)) unless turbo_frame_request?
= wsjrdp_detail_frame("dgr", @document_group.row_key) do
  = render "detail", group: @document_group
