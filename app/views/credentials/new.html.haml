-#
-#  The new-account form, first step: kind, account key and an optional
-#  display name. The form of the first version follows. The key is checked
-#  while typing and again on the server.
- scope = "credentials.new"
- title(t("#{scope}.title"))
- length = Wsjrdp::Credentials::ACCOUNT_KEY_LENGTH
-# The same layout as the version form.
- label_classes = "col-md-3 col-xl-2 text-md-end text-muted col-form-label col-form-label-sm"
- value_classes = "col-md-9 col-lg-8 col-xl-8"
= render "fin/shared/sticky_form_actions"

= form_with url: new_credential_path, method: :get, local: true, id: "credentials-new-account",
  data: {turbo: false} do
  .fin-account-form-actions.mb-3
    .d-flex.gap-2
      = submit_tag t("#{scope}.next"), class: "btn btn-primary", name: nil
      = link_to t("global.button.cancel"), credentials_path, class: "btn btn-link"
  - if @problems.present?
    .alert.alert-danger
      = safe_join(@problems.map { |code| t("#{scope}.problems.#{code}") }, tag.br)
  .row.mb-2
    = label_tag :kind, t("#{scope}.kind"), class: label_classes
    %div{class: value_classes}
      = select_tag :kind, options_for_select(kinds.names.map { |name| [credential_kind_label(name), name] }, @kind_name),
        class: "form-select form-select-sm d-block"
  .row.mb-2
    %span{class: label_classes}= t("credentials.attributes.stage")
    %div{class: value_classes}
      .form-control-plaintext.form-control-sm.font-monospace= credential_stage(Wsjrdp::Credentials::Keys.current.stage)
  .row.mb-2
    %label{for: "account_key", class: label_classes}
      = t("#{scope}.account_key_html", code: content_tag(:span, t("#{scope}.account_key_code"), class: "font-monospace"))
      = "*"
    %div{class: value_classes}
      = text_field_tag :account_key, @account_key, class: "form-control form-control-sm font-monospace", required: true,
        maxlength: length * 4, autocomplete: "off", spellcheck: false
      .form-text.d-flex.gap-3
        %span= t("#{scope}.account_key_help", length: length)
        %span.ms-auto.text-nowrap
          %span#account_key_count= Wsjrdp::Credentials.account_key_of(@account_key.to_s).to_s.length
          = t("#{scope}.account_key_count", length: length)
      -# Filled by the server after a refused send, and live while typing.
      - problems = credential_account_key_problems(@account_key)
      - warnings = credential_account_key_warnings(@account_key)
      .small.text-danger#account_key_problems{hidden: problems.empty?}= safe_join(problems, tag.br)
      .small.text-warning-emphasis#account_key_warnings{hidden: warnings.empty?}= safe_join(warnings, tag.br)
      .small.text-muted.mt-1#account_key_variable{hidden: true}
        = t("#{scope}.variable")
        %span.font-monospace.text-break#account_key_variable_name
  .row.mb-2
    = label_tag :name, t("#{scope}.name"), class: label_classes
    %div{class: value_classes}
      = text_field_tag :name, @name, class: "form-control form-control-sm", autocomplete: "off"
      .form-text= t("credentials.name_help")

= render "credentials/new_js", length: length
