-#
-#  The reveal button of a hidden field: asks the server for the value and
-#  shows it in place of the dots; the hide button removes it again. Every
-#  revealed value is removed before the page is left or cached.
:javascript
  (function () {
    if (window.WsjrdpCredentialReveal) return

    function parts(button) {
      const cell = button.closest("[data-credential-field]")
      return {
        masked: cell.querySelector("[data-credential-masked]"),
        value: cell.querySelector("[data-credential-value]"),
        error: cell.querySelector("[data-credential-error]")
      }
    }

    function hide(button) {
      const { masked, value, error } = parts(button)
      value.textContent = ""
      value.hidden = true
      error.textContent = ""
      error.hidden = true
      masked.hidden = false
      if (button.dataset.showLabel) button.textContent = button.dataset.showLabel
      delete button.dataset.revealed
    }

    function hideAll() {
      document.querySelectorAll("[data-credential-reveal][data-revealed]").forEach(hide)
    }

    async function reveal(button) {
      const { masked, value, error } = parts(button)
      const token = document.querySelector("meta[name=csrf-token]")
      const body = new URLSearchParams()
      ;["source", "versionId", "position", "field"].forEach((key) => {
        const given = button.dataset[key]
        if (given) body.append(key.replace(/[A-Z]/g, (c) => "_" + c.toLowerCase()), given)
      })
      button.disabled = true
      try {
        const response = await fetch(button.dataset.credentialReveal, {
          method: "POST",
          credentials: "same-origin",
          cache: "no-store",
          headers: { "Accept": "application/json", "X-CSRF-Token": token ? token.content : "" },
          body: body
        })
        // An answer that is not JSON (an error page) shows its status.
        const json = await response.json().catch(() => ({}))
        button.dataset.showLabel = button.dataset.showLabel || button.textContent
        if (response.ok && typeof json.value === "string") {
          value.textContent = json.value
          value.hidden = false
          masked.hidden = true
        } else {
          error.textContent = json.error || `${response.status} ${response.statusText}`.trim()
          error.hidden = false
        }
        button.dataset.revealed = "1"
        button.textContent = button.dataset.hideLabel
      } finally {
        button.disabled = false
      }
    }

    document.addEventListener("click", (event) => {
      const button = event.target.closest("[data-credential-reveal]")
      if (!button) return
      event.preventDefault()
      button.dataset.revealed ? hide(button) : reveal(button)
    })
    window.addEventListener("pagehide", hideAll)
    document.addEventListener("turbo:before-cache", hideAll)
    document.addEventListener("turbo:before-visit", hideAll)
    window.WsjrdpCredentialReveal = true
  })();
