-#
-#  All encryption keys, read-only: label, fingerprint (never the key),
-#  role, stage and source. This stage's keys come first.
- keys = overview.keys
- variable = keys.source == Wsjrdp::Credentials::Keys::ENV_NAME
- file, entry = keys.source.to_s.split(" ", 2) unless variable
- label_classes = "text-muted col-md-3 col-xl-2 text-md-end"
- value_classes = "col-md-9 col-lg-8 col-xl-8 mb-0 text-break"
%h2.h6.mt-4= t("credentials.keys.title")
%p.text-muted.small= t("credentials.keys.purpose")
#credentials-keys
  - if keys.fingerprints.empty?
    %p.text-muted= t("credentials.keys.none")
  - keys.entries.each do |key|
    %dl.fin-detail-list.border-top.pt-2{data: {credential_key: key.fingerprint, credential_key_role: key.role}}
      .row.mb-2
        %dt{class: label_classes}= t("credentials.keys.label")
        %dd{class: value_classes}= keys.label || content_tag(:span, t("credentials.version.not_set"), class: "text-muted")
      .row.mb-2
        %dt{class: label_classes}= t("credentials.keys.fingerprint")
        %dd{class: value_classes}
          %span.font-monospace= key.fingerprint
          %span.badge.ms-1{class: key.role == :other_stage ? "bg-secondary" : "bg-success"}
            = t("credentials.keys.roles.#{key.role}")
      .row.mb-2
        %dt{class: label_classes}= t("credentials.attributes.stage")
        %dd.font-monospace{class: value_classes}= credential_stage(key.stage)
      .row.mb-2{data: {credential_key_source: true}}
        %dt{class: label_classes}= t("credentials.keys.source")
        %dd{class: value_classes}
          - if variable
            = t("credentials.keys.from_variable")
            %span.font-monospace= keys.source
          - else
            = t("credentials.keys.from_file")
            %span.font-monospace= file
            - if entry
              = surround("(", ")") do
                = t("credentials.keys.file_entry")
                %span.font-monospace= entry
