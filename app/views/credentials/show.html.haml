-#
-#  One account: the versions of all sources, the one in use first, those
-#  of other stages last. Overrides are read-only. The page is never cached.
- scope = "credentials.show"
- kind = kinds[report.kind]
- keys = Wsjrdp::Credentials::Keys.current
- title(credential_account_title(report.kind, report.account_key, name: credential_display_name(report)))

-# Shown between the title and the toolbar.
- content_for(:filter) do
  %p.mb-2= link_to(t("#{scope}.back"), credentials_path, id: "credential-back")

- if kind
  - content_for(:toolbar) do
    = link_to(t("#{scope}.new_version"), new_credential_version_path(kind: report.kind, account_key: report.account_key),
      class: "btn btn-sm btn-outline-primary", id: "credential-new-version")

#credential-account{data: {kind: report.kind, account_key: report.account_key}}
  = render "credentials/notices"

  -# The versions of all sources; each names its source.
  - overridden = credential_overridden_versions(report)
  #credential-versions.mt-3
    - versions = credential_versions_in_order(report)
    - if versions.empty?
      %p.text-muted= t("#{scope}.no_versions")
    - versions.each do |version|
      = render "credentials/version", version: version, kind: kind, keys: keys,
        overridden: overridden.include?(version)

= render "credentials/reveal_js"
