-#
-#  The "Verbindung testen" button: asks for a confirmation where the
-#  button names one (plain http), then shows the server's outcome on the
-#  card.
-#
-#  A click calls the real Moss API with real credentials (a token, then
-#  one user). AI agents (see AGENTS.md): never click it, and never send this
-#  request any other way, unless the user explicitly asks for it or agrees
-#  when asked first.
:javascript
  (function () {
    // The click listener is added once per document; it calls the code of
    // the page loaded last, so a page Turbo brings in replaces older code.
    const firstLoad = !window.WsjrdpCredentialConnectionTest

    // The tests so far, sent anew after a test; an open list stays open.
    function replaceHistory(container, html) {
      const old = container.querySelector("[data-credential-connection-history-part]")
      if (!old) return
      const wasOpen = !!old.querySelector("details[open]")
      const template = document.createElement("template")
      template.innerHTML = html.trim()
      const fresh = template.content.firstElementChild
      if (!fresh) return
      if (wasOpen) fresh.querySelector("details")?.setAttribute("open", "")
      old.replaceWith(fresh)
    }

    async function run(button) {
      const container = button.closest("[data-credential-connection-test]")
      const output = container.querySelector("[data-credential-connection-output]")
      const confirmText = button.dataset.confirmInsecure
      if (confirmText && !window.confirm(confirmText)) return

      const token = document.querySelector("meta[name=csrf-token]")
      const body = new URLSearchParams()
      ;["source", "versionId", "position"].forEach((key) => {
        const given = button.dataset[key]
        if (given) body.append(key.replace(/[A-Z]/g, (c) => "_" + c.toLowerCase()), given)
      })
      if (confirmText) body.append("confirmed", "1")

      const label = button.textContent
      button.disabled = true
      button.textContent = button.dataset.runningLabel
      try {
        const response = await fetch(button.dataset.credentialConnection, {
          method: "POST",
          credentials: "same-origin",
          cache: "no-store",
          headers: { "Accept": "application/json", "X-CSRF-Token": token ? token.content : "" },
          body: body
        })
        const json = await response.json().catch(() => ({}))
        if (typeof json.html === "string") {
          output.innerHTML = json.html
          if (typeof json.history === "string") replaceHistory(container, json.history)
        } else {
          const alert = document.createElement("div")
          alert.className = "alert alert-danger py-2 small mb-2"
          alert.textContent = json.error || `${response.status} ${response.statusText}`.trim()
          output.replaceChildren(alert)
        }
      } finally {
        button.disabled = false
        button.textContent = label
      }
    }

    window.WsjrdpCredentialConnectionTest = { run: run }
    if (!firstLoad) return

    document.addEventListener("click", (event) => {
      const button = event.target.closest("[data-credential-connection]")
      if (!button) return
      event.preventDefault()
      window.WsjrdpCredentialConnectionTest.run(button)
    })
  })()
