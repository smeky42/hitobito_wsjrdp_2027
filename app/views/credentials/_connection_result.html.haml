-#
-#  The outcome of "Verbindung testen", shown on the version's card, with
-#  every request and answer for debugging (shown here only, the log keeps
-#  less). Never a secret or a token.
- scope = "credentials.connection_test"
- details = []
- if result.ok?
  - details << t("#{scope}.scope", value: result.scope) if result.scope.present?
  - details << t("#{scope}.expires_in", minutes: result.expires_in.to_i / 60) if result.expires_in.to_i.positive?
- else
  - details << t("#{scope}.status", status: result.status) if result.status
  - details << t("#{scope}.tracing_id", id: result.tracing_id) if result.tracing_id.present?
- details << t("#{scope}.duration", ms: result.duration_ms)
- details << result.host if result.host.present?
.alert.py-2.small.mb-2{class: result.ok? ? "alert-success" : "alert-danger",
  data: {credential_connection_result: result.ok? ? "ok" : "failed"}}
  - if result.ok?
    %strong= t("#{scope}.ok")
  - else
    %strong= "#{t("#{scope}.failed")} #{t("#{scope}.steps.#{result.step}")}:"
    = result.message
  .text-muted= details.join(" · ")
  - if insecure
    .text-warning-emphasis{data: {credential_connection_insecure: true}}= t("#{scope}.insecure")
  - if result.exchanges.any?
    %details.mt-2{data: {credential_connection_exchanges: true}}
      %summary= t("#{scope}.exchanges.title", count: result.exchanges.size)
      - result.exchanges.each do |exchange|
        .mt-2{data: {credential_connection_exchange: exchange.step}}
          %div
            %strong= "#{exchange.method} #{exchange.url}"
            = "→ #{exchange.status || exchange.error} · #{t("#{scope}.duration", ms: exchange.duration_ms)}"
          - parts = {request_headers: exchange.request_headers, request_body: exchange.request_body,
            response_headers: exchange.response_headers, response_body: exchange.response_body}
          - parts.each do |name, value|
            - next if value.blank?
            .text-muted.mt-1= t("#{scope}.exchanges.#{name}")
            %pre.bg-body-tertiary.border.rounded.p-2.mb-1.small.text-body{style: "white-space: pre-wrap; word-break: break-word; max-height: 20rem; overflow-y: auto;"}
              = value.is_a?(String) ? value : JSON.pretty_generate(value)
