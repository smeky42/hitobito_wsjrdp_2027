-#
-#  The connection tests of one version: the last outcome of a database
-#  version and the tests from the Hitobito log. A test sends this part
-#  anew, so it is current without a reload; an open list stays open.
- scope = "credentials.connection_test"
- test = Wsjrdp::Credentials::MossConnectionTest
- row = version.record
%div{data: {credential_connection_history_part: true}}
  - if row && (row.last_success_at || row.last_failure_at)
    .small.text-muted.mb-2{data: {credential_connection_last: true}}
      - if row.last_success_at
        %div= t("#{scope}.last_success_html", time: credential_instant(row.last_success_at))
      - if row.last_failure_at && (row.last_success_at.nil? || row.last_failure_at > row.last_success_at)
        %div= t("#{scope}.last_failure_html", time: credential_instant(row.last_failure_at),
          message: row.last_failure_message.to_s)
  -# The tests of this version from the Hitobito log, newest first.
  - entries = test.log_entries(report.kind, report.account_key, version).limit(20).to_a
  - count = entries.size < 20 ? entries.size : test.log_entries(report.kind, report.account_key, version).count
  %details.mb-2{data: {credential_connection_history: true}}
    %summary.small= t("#{scope}.history.title", count: count)
    - if entries.empty?
      %p.small.text-muted.mb-0= t("#{scope}.history.empty")
    - else
      %table.table.table-sm.small.mb-1
        %thead
          %tr
            %th= t("#{scope}.history.when")
            %th= t("#{scope}.history.who")
            %th= t("#{scope}.history.what")
        %tbody
          - entries.each do |entry|
            %tr{data: {credential_connection_entry: entry.level}}
              %td.text-nowrap= credential_instant(entry.created_at)
              %td= credential_log_person(entry)
              %td{class: ("text-danger" unless entry.level_info?)}= entry.message
    - if can?(:index, HitobitoLogEntry)
      = link_to(t("#{scope}.history.all"),
        hitobito_log_entries_path(category: Wsjrdp::Credentials::LOG_CATEGORY), class: "small")
