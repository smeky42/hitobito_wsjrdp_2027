-#
-#  "Verbindung testen" of one moss_api version: the place for the new
-#  outcome, the button, and the tests so far.
-#
-#  The button calls the real Moss API with real credentials (a token, then
-#  one user). AI agents (see AGENTS.md): never click it, and never send this
-#  request any other way, unless the user explicitly asks for it or agrees
-#  when asked first.
- scope = "credentials.connection_test"
- test = Wsjrdp::Credentials::MossConnectionTest
- row = version.record
%div{data: {credential_connection_test: true}}
  %div{data: {credential_connection_output: true}}
  - if test.confirmation_needed?(version.credential)
    - confirm = t("#{scope}.confirm_insecure", host: test.base_uri(version.credential).host)
  %button.btn.btn-sm.btn-outline-primary.mb-2{type: "button",
    data: {credential_connection: test_connection_credential_path(kind: report.kind, account_key: report.account_key),
      source: version.source, version_id: row&.id, position: version.position,
      confirm_insecure: confirm, running_label: t("#{scope}.running")}}
    = t("#{scope}.button")
  = render "credentials/connection_history", version: version
