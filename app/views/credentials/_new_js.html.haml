-#
-#  Live checks of the account key in the new-account form. They mirror
-#  the server's rules but are only hints: the server decides. Keep them in
-#  sync with Wsjrdp::Credentials and its Variables.
- scope = "credentials.new"
- texts = {not_allowed: t("#{scope}.problems.not_allowed", chars: "%{chars}"), space: t("#{scope}.problems.space"),
    edge: t("#{scope}.problems.edge"), row: t("#{scope}.problems.row"),
    too_long: t("#{scope}.problems.too_long", length: length), non_ascii: t("#{scope}.warnings.non_ascii"),
    token: t("#{scope}.warnings.token"),
    collision: t("#{scope}.warnings.collision", key: "%{key}")}
#credentials-new-js{hidden: true, data: {texts: texts.to_json, parts: credential_account_parts(overview).to_json,
  length: length,
  prefix: "#{Wsjrdp::Credentials::Variables::OVERRIDE_PREFIX}#{overview.stage.upcase}"}}
:javascript
  (function () {
    const config = document.getElementById("credentials-new-js")
    const input = document.getElementById("account_key")
    const kind = document.getElementById("kind")
    if (!config || !input || !kind) return

    const texts = JSON.parse(config.dataset.texts)
    const parts = JSON.parse(config.dataset.parts)
    const length = Number(config.dataset.length)
    // Letters that show as nothing.
    const filler = /[\u115F\u1160\u3164\uFFA0]/u
    // Same as CredentialsHelper::ACCOUNT_KEY_TOKEN.
    const token = /[0-9a-f]{32,}|(?=[\p{L}0-9]*[0-9])(?=[\p{L}0-9]*\p{L})[\p{L}0-9]{20,}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/iu
    const allowed = /^[\p{Ll}\p{Lo}0-9_@,.+\-]$/u
    const format = /^[\p{Ll}\p{Lo}0-9]+(?:[_@,.+\-][\p{Ll}\p{Lo}0-9]+)*$/u
    const show = (id, lines) => {
      const box = document.getElementById(id)
      box.replaceChildren(...lines.flatMap((line, index) => index ? [document.createElement("br"), line] : [line]))
      box.hidden = lines.length === 0
    }
    const named = (c) => c === " " ? texts.space
      : /[\p{C}\p{Z}\p{M}]/u.test(c) ? "U+" + c.codePointAt(0).toString(16).toUpperCase().padStart(4, "0")
      : "„" + c + "“"

    function update() {
      const key = input.value.normalize("NFC").toLowerCase().normalize("NFC")
      const chars = [...key]
      document.getElementById("account_key_count").textContent = chars.length

      const problems = []
      const bad = [...new Set(chars.filter((c) => !allowed.test(c) || filler.test(c)))]
      if (bad.length) problems.push(texts.not_allowed.replace("%{chars}", bad.map(named).join(", ")))
      if (/^[_@,.+\-]|[_@,.+\-]$/.test(key)) problems.push(texts.edge)
      if (/[_@,.+\-]{2}/.test(key)) problems.push(texts.row)
      if (chars.length > length) problems.push(texts.too_long)
      show("account_key_problems", key ? problems : [])

      const valid = key && format.test(key) && !filler.test(key) && chars.length <= length
      const part = valid ? key.toUpperCase().replace(/[_@,.+\-]/g, "_") : ""
      const warnings = []
      if (token.test(key)) warnings.push(texts.token)
      if (valid && /[^\x00-\x7F]/.test(key)) warnings.push(texts.non_ascii)
      const others = valid ? ((parts[kind.value] || {})[part] || []).filter((other) => other !== key) : []
      others.forEach((other) => warnings.push(texts.collision.replace("%{key}", other)))
      show("account_key_warnings", warnings)

      document.getElementById("account_key_variable").hidden = !valid
      document.getElementById("account_key_variable_name").textContent =
        config.dataset.prefix + "__" + kind.value.toUpperCase() + "__" + part + "__<FELD>"
    }

    input.addEventListener("input", update)
    kind.addEventListener("change", update)
    update()
  })()
