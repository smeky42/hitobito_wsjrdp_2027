-#
-#  One version of an account, with its actions. An override is
-#  read-only.
- scope = "credentials.version"
- row = version.record
- own_stage = row.nil? || row.stage == keys.stage
- dom_id = row ? "credential-version-#{row.id}" : "credential-#{version.source}-#{version.position}"
- in_use = version.role == Wsjrdp::Credentials::Overview::ACTIVE
- source_text, source_title = credential_source_chip(version)
.card.mb-3{id: dom_id, class: ("border-success" if in_use),
  data: {credential_state: version.state, credential_role: version.role, credential_source: version.source}}
  -# The name on the left, the labels on the right.
  .card-header.d-flex.flex-wrap.align-items-center.gap-2
    - if in_use
      %span.text-success{title: t("#{scope}.in_use"), "aria-label": t("#{scope}.in_use"), data: {credential_in_use: true}}
        = icon(:'check-circle')
    -# The display name, else the account key.
    - if version.name.present?
      %strong= version.name
    - else
      %strong.font-monospace= credential_account_key(report.account_key)
    .d-flex.flex-wrap.gap-1.ms-auto.justify-content-end{data: {credential_chips: true}}
      %span.badge.text-nowrap{class: "bg-#{credential_state_class(version)}", data: {credential_chip: "state"}}
        = credential_state_label(version)
      - if version.role == Wsjrdp::Credentials::Overview::FALLBACK
        %span.badge.text-nowrap.text-bg-light.border{data: {credential_chip: "fallback"}}= t("credentials.chips.fallback")
      - if local_assigns[:overridden]
        %span.badge.text-nowrap.text-bg-secondary{data: {credential_chip: "overridden"},
          title: t("credentials.chips.overridden_title", mark: credential_source_mark(version.overridden_by),
            source: t("credentials.chips.source_object.#{version.source}"))}= t("credentials.chips.overridden")
      %span.badge.text-nowrap.border.text-body.font-monospace.fw-normal{title: source_title,
        data: {credential_chip: "source"}}= source_text
  .card-body
    - hints = []
    - if row
      - hints.concat(credential_field_hints(row, keys, kinds)) if own_stage
      - if own_stage && (problem = row.secret_key_problem(keys))
        - hints << t("#{scope}.key_problems.#{problem}_html", fingerprint: credential_fingerprint(row.encryption_key_fingerprint))
    - else
      - hints.concat(version.errors.map { |error| credential_problem_message(error) })
      - hints << t("#{scope}.refused") if version.state == Wsjrdp::Credentials::Override::REFUSED
    - warnings = version.warnings
    - if hints.any?
      .alert.alert-danger.py-2.small{data: {credential_hints: true}}
        = safe_join(hints, tag.br)
    - if warnings.any?
      .alert.alert-warning.py-2.small{data: {credential_warnings: true}}
        = credential_problems_text(warnings)

    = fin_detail_styles
    - label_classes = "col-md-3 col-xl-2 text-md-end"
    - value_classes = "col-md-9 col-lg-8 col-xl-8 mb-0 text-break"
    -# The version's details and fields, then its further fields (if any),
    -# then its source and key.
    %div{data: {credential_fields: true}}
      - env = version.source == Wsjrdp::Credentials::Variables::SOURCE
      - field_rows = credential_field_rows(version, kind, keys)
      - kind_rows, further_rows = field_rows.partition { |field| !field.further }
      - row_locals = {version: version, row: row, report: report, env: env, label_classes: label_classes,
        value_classes: value_classes}
      %dl.fin-detail-list.mb-2
        .row.mb-2{data: {credential_kind_row: true}}
          %dt.text-muted{class: label_classes}= t("credentials.attributes.kind")
          %dd{class: value_classes}
            = credential_kind_label(report.kind)
            %span.font-monospace= "(#{credential_name(report.kind)})"
            - unless kind
              %span.badge.bg-danger.ms-1= t("credentials.states.kind_unknown")
        .row.mb-2{data: {credential_stage_row: true}}
          %dt.text-muted{class: label_classes}= t("credentials.attributes.stage")
          %dd.font-monospace{class: value_classes}= credential_stage(row ? row.stage : keys.stage)
        .row.mb-2{data: {credential_account_key_row: true}}
          %dt.text-muted{class: label_classes}= t("credentials.attributes.account_key")
          %dd.font-monospace{class: value_classes}= credential_account_key(report.account_key)
        -# The variables that would override this account in its stage.
        .row.mb-2{data: {credential_variables_row: true}}
          %dt.text-muted{class: label_classes}= t("credentials.version.variables")
          %dd.font-monospace.text-break{class: value_classes}
            = "#{Wsjrdp::Credentials::Variables.account_prefix(row ? row.stage : keys.stage, report.kind, report.account_key)}__<FELD>"
        - if row && row.comment.present?
          .row.mb-2
            %dt.text-muted{class: label_classes}= t("credentials.attributes.comment")
            %dd{class: value_classes}= row.comment
        .row.mb-2
          %dt.text-muted{class: label_classes}= t("credentials.attributes.valid_from")
          %dd{class: value_classes}= credential_instant(version.valid_from)
        .row.mb-2
          %dt.text-muted{class: label_classes}= t("credentials.attributes.expires_at")
          %dd{class: value_classes}= credential_instant(version.expires_at)
        - if row&.revoked_at
          .row.mb-2
            %dt.text-muted{class: label_classes}= t("credentials.attributes.revoked_at")
            %dd{class: value_classes}= credential_instant(row.revoked_at)
        - kind_rows.each do |field|
          = render "credentials/field_row", field: field, **row_locals
      - if further_rows.any?
        %h3.h6.mt-3.mb-2.pb-1.border-bottom{data: {credential_further_heading: true}}= t("#{scope}.further")
        %dl.fin-detail-list.mb-2
          - further_rows.each do |field|
            = render "credentials/field_row", field: field, **row_locals
      %hr.my-2
      %dl.fin-detail-list.mb-2
        .row.mb-2{data: {credential_source_row: true}}
          %dt.text-muted{class: label_classes}= t("credentials.attributes.source")
          %dd{class: value_classes}
            = credential_source_label(version.source)
            - if version.source == Wsjrdp::Credentials::LocalFile::NAME
              %span.font-monospace.ms-1= overview.file.source
            - elsif env
              %span.font-monospace.ms-1.text-break
                = "#{Wsjrdp::Credentials::Variables.account_prefix(keys.stage, report.kind, report.account_key)}__…"
        - if row
          -# The fingerprint of the key that encrypts the secret fields, never the key.
          .row.mb-2{data: {credential_key_row: true}}
            %dt.text-muted{class: label_classes}= t("credentials.attributes.encryption_key_fingerprint")
            %dd{class: value_classes}
              = credential_fingerprint(row.encryption_key_fingerprint)
              - if row.encryption_key_label.present?
                = row.encryption_key_label
              - if own_stage && credential_key_active?(row, keys)
                = t("#{scope}.key_active")

    .small.text-muted.mb-2
      - if row
        = t("#{scope}.deposited_html", time: credential_instant(row.created_at), author: credential_author(row.author))
      - else
        - if version.created_at
          = t("#{scope}.created_html", time: credential_instant(version.created_at))
          ·
        = t("#{scope}.read_only")

    - if Wsjrdp::Credentials::MossConnectionTest.offered?(report.kind, version)
      = render "credentials/connection_test", version: version

    - if row
      - button_form = {class: "d-inline", data: {turbo: false}}
      .d-flex.flex-wrap.gap-2.mb-2{data: {credential_actions: true}}
        - if own_stage
          = link_to(t("#{scope}.edit"), edit_credential_version_path(row), class: "btn btn-sm btn-outline-primary")
          - if credential_rekey?(row, keys)
            = button_to(t("#{scope}.rekey"), rekey_credential_version_path(row), method: :post,
              class: "btn btn-sm btn-warning", form: button_form,
              data: {confirm: t("#{scope}.rekey_confirm")})
          - if row.revoked_at
            = button_to(t("#{scope}.unrevoke"), unrevoke_credential_version_path(row), method: :post,
              class: "btn btn-sm btn-outline-secondary", form: button_form,
              data: {confirm: t("#{scope}.unrevoke_confirm")})
          - else
            = button_to(t("#{scope}.revoke"), revoke_credential_version_path(row), method: :post,
              class: "btn btn-sm btn-outline-secondary", form: button_form,
              data: {confirm: t("#{scope}.revoke_confirm")})
        = button_to(t("#{scope}.destroy"), credential_version_path(row), method: :delete,
          class: "btn btn-sm btn-outline-danger", form: button_form,
          data: {confirm: t("#{scope}.destroy_confirm")})

      = render "credentials/trail", row: row
