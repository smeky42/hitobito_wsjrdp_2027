-#
-#  The change history of one version, collapsed: newest first, public
-#  values shown, secret fields by name only.
- entries = credential_trail(row).to_a
%details{data: {credential_trail: row.id}}
  %summary.small= t("credentials.trail.title", count: entries.size)
  - if entries.empty?
    %p.small.text-muted.mb-0= t("credentials.trail.empty")
  - else
    %table.table.table-sm.small.mb-0
      %thead
        %tr
          %th= t("credentials.trail.when")
          %th= t("credentials.trail.who")
          %th= t("credentials.trail.what")
      %tbody
        - entries.each do |entry|
          %tr{data: {credential_trail_event: entry.event}}
            %td.text-nowrap= credential_instant(entry.created_at)
            %td= credential_trail_author(entry)
            %td= credential_trail_text(entry, row)
