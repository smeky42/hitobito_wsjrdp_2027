-#
-#  One field of a version: a field of the kind or a further one.
- scope = "credentials.version"
.row.mb-2{data: {credential_field: field.name, credential_further: (true if field.further)}}
  %dt.text-muted{class: label_classes}
    %span.font-monospace= field.name
  %dd{class: value_classes}
    - if !field.set
      %span.text-muted= t("#{scope}.not_set")
    - elsif field.masked
      -# On reveal, the value takes the place of the dots.
      %span{data: {credential_masked: true}}
        %span.text-muted= CredentialsHelper::MASK
        - if field.fingerprint
          %span.small.text-muted.ms-1= t("#{scope}.value_fingerprint_html", fingerprint: field.fingerprint)
        - elsif row
          %span.small.text-muted.ms-1= t("#{scope}.not_opening_here")
      - if field.revealable
        %span.font-monospace.text-break.bg-body-tertiary.border.rounded.px-2{hidden: true,
          data: {credential_value: true}}
        %span.small.text-danger{hidden: true, data: {credential_error: true}}
        %button.btn.btn-sm.btn-link.p-0.ms-2.align-baseline{type: "button",
          data: {credential_reveal: reveal_credential_path(kind: report.kind, account_key: report.account_key),
            source: version.source, version_id: row&.id, position: version.position, field: field.name,
            hide_label: t("#{scope}.hide")}}
          = t("#{scope}.reveal")
    - else
      %span.font-monospace= field.value.to_s
    - if env
      -# The rest of the field's variable name, never its value.
      .small.text-muted.font-monospace{data: {credential_variable: true}}= "…__#{field.name.upcase}"
