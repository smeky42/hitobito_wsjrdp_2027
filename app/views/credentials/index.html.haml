-#
-#  The list of all accounts from all sources, and whether each works here.
- scope = "credentials"
- title(t("#{scope}.title"))

- content_for(:toolbar) do
  = link_to(t("#{scope}.list.new"), new_credential_path, class: "btn btn-sm btn-outline-primary", id: "credentials-new")
  - if overview.file.status.in?([Wsjrdp::Credentials::LocalFile::READ, Wsjrdp::Credentials::LocalFile::OTHER_STAGE])
    = button_to(t("#{scope}.reload.button"), reload_local_file_credentials_path,
      class: "btn btn-sm btn-outline-secondary", form: {class: "ms-auto", id: "credentials-reload"},
      title: t("#{scope}.reload.title", source: overview.file.source))

#credentials
  = fin_detail_styles
  %dl.fin-detail-list.mb-3#credentials-stage
    .row.mb-2
      %dt.text-muted.col-md-3.col-xl-2.text-md-end= t("#{scope}.list.current_stage")
      %dd.font-monospace.col-md-9.col-lg-8.col-xl-8.mb-0= credential_stage(overview.stage)

  = render "credentials/notices"

  - groups = overview.accounts.group_by(&:kind)
  - if groups.empty?
    %p.text-muted#credentials-empty= t("#{scope}.list.empty")
  - else
    %table.table.table-sm#credentials-list
      %thead
        %tr
          %th= t("#{scope}.list.account")
          %th= t("#{scope}.list.here")
          %th= t("#{scope}.list.other_stages")
      - groups.sort_by { |kind_name, _reports| credential_kind_label(kind_name) }.each do |kind_name, reports|
        - kind = kinds[kind_name]
        %tbody{data: {credential_kind: credential_name(kind_name)}}
          %tr.table-light
            %th{colspan: 3}
              = credential_kind_label(kind_name)
              %code.small.text-muted.ms-1= credential_name(kind_name)
              - unless kind
                %span.badge.bg-danger.ms-1= t("#{scope}.states.kind_unknown")
          - reports.sort_by { |report| report.account_key.to_s }.each do |report|
            - key = credential_account_key(report.account_key)
            %tr{data: {credential_account: key}}
              %td
                - if Wsjrdp::Credentials.name?(report.kind) && Wsjrdp::Credentials.account_key?(report.account_key)
                  = link_to(key, credential_path(kind: report.kind, account_key: report.account_key))
                - else
                  = key
                - if (title_value = credential_title_value(report, kind))
                  .small.text-muted= title_value
              %td
                = credential_account_state(report)
                - if (mark = credential_source_mark(report.in_use))
                  %span.badge.bg-info.text-dark.ms-1= mark
                - report.overridden_sources.each do |source|
                  - count = report.sources.find { |s| s.source == source }.versions.size
                  .small.text-muted
                    = t("#{scope}.list.overrides", source: credential_source_label(source), count: count)
              %td
                - stages = credential_other_stages(report)
                - if stages.empty?
                  –
                - else
                  = safe_join(stages.map { |stage, count| "#{stage}: #{count}" }, " · ")

  = render "credentials/keys"
