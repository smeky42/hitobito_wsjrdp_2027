-#
-#  Warnings about what is missing here: a key, or a readable local file.
- if overview.keys.active_fingerprint.nil?
  .alert.alert-warning#credentials-no-key= t("credentials.notices.no_key")
- file = overview.file
- if file.status == Wsjrdp::Credentials::LocalFile::OTHER_STAGE
  .alert.alert-warning#credentials-file-skipped
    - if file.file_stage
      = t("credentials.notices.file_skipped", source: file.source, stage: file.file_stage)
    - else
      = t("credentials.notices.file_skipped_other", source: file.source)
