-#
-#  The person's family links on a page of their own
-#  (Person::FamilyMembersController), the rows of the person form.
#main.row
  = standard_form person, url: person_family_members_path(person), method: :put, html: { class: 'form-striped' } do |f|
    = f.error_messages
    = form_buttons(f, cancel_url: person_base_path(group, person))
    %h2.mt-3 Familienmitglieder
    = render 'people/family_members_fields', f: f, show_label: false, remove_icon: :'trash-alt'
