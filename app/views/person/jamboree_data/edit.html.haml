#main.row
  = standard_form @person, url: jamboree_data_page_path(@group, @person), method: :put, html: { class: 'form-striped', data: { jamboree_data_form: true } } do |f|
    = f.error_messages
    = form_buttons(f, cancel_url: jamboree_data_page_path(@group, @person))

    = field_set_tag do
      %h3= t('people.jamboree_data.clothing')
      .text-muted.mw-90ch.mb-2= t('people.jamboree_data.clothing_help')
      = f.labeled_collection_select(:shirt_size, Settings.shirt_size, :to_s, :to_s, {include_blank: t('people.additional_info_fields.size_placeholder')}, class: 'span2')
      = f.labeled_collection_select(:uniform_size, Settings.uniform_size, :to_s, :to_s, {include_blank: t('people.additional_info_fields.size_placeholder')}, class: 'span2')
      -# Without an answer Langarm and ordering are ticked; Kurzarm and Nein
      -# are an explicit choice.
      = f.labeled(:uniform_long_sleeve) do
        - sleeve_options.each do |value, label|
          = f.inline_radio_button(:uniform_long_sleeve, value, label, true, checked: value == (f.object.uniform_long_sleeve != false))
      - if @person.uniform_order_available?
        = f.labeled(:uniform_order) do
          - yes_no_options.each do |value, label|
            = f.inline_radio_button(:uniform_order, value, label, true, checked: value == (f.object.uniform_order != false))
          .mw-90ch.mb-2
            = t('people.additional_info_fields.uniform_order_help')
      = f.labeled_collection_select(:headgear, Settings.headgear, :first, :last, { include_blank: true }, class: 'span2')

    .mt-3
      %h3= t('people.tabs.jamboree_data')
    .text-muted.mw-90ch.mb-2
      %p= t('people.jamboree_data.intro')
      %p.fw-bold= t('people.jamboree_data.intro_eng')
    = field_set_tag do
      %h3= t('people.jamboree_data.personal')
      -# Empty means the default (nickname, else first name), shown as placeholder.
      -# What an empty field stands for (known_as_name_default_with_source).
      - default, source = @person.known_as_name_default_with_source
      = f.labeled_input_field :known_as_name,
        help: source ? t("people.jamboree_data.known_as_name_leave_empty.#{source}", name: default) : t('people.jamboree_data.known_as_name_help')
      - if @person.jamboree_data_adult?
        = f.labeled_input_field :mothers_first_name
        = f.labeled_input_field :fathers_first_name
        = f.labeled_input_field :mothers_surname_at_birth
        = f.labeled_input_field :place_of_birth
      = f.labeled_country_select_field :country_of_birth
      -# Without an answer the main nationality of the registration.
      = f.labeled_country_select_field :nationality, value: @person.nationality_or_default

    -# One block per language, one row per skill: the level as numbered
    -# single-choice buttons (radios styled as buttons) with the legend above
    -# and the chosen level written out beside the buttons (below them on a
    -# phone; kept up to date by jamboree_data_form.js). The blocks stand side
    -# by side where the width allows.
    - levels = @person.jamboree_data_language_levels
    = field_set_tag do
      %h3= t('people.jamboree_data.languages')
      :css
        /* At most two columns of at least 28rem, filled top to bottom: the
           first column Englisch and Französisch, the second Spanisch and
           Arabisch. Narrower, one column. A block never splits. */
        .wsjrdp-languages { columns: 28rem 2; column-gap: 1.5rem; }
        .wsjrdp-language-block { break-inside: avoid; padding-bottom: .75rem; }
        /* A row: the skill (6rem, room for "Hörverstehen"), six buttons of
           2.2rem, the level name (7.5rem, room for "Konversationssicher",
           never wrapped). Together about 27.75rem; a narrower block puts the
           name below the buttons, which then fill the row. The switch follows
           the block's own width (container query), not the screen's. */
        .wsjrdp-language-block { container-type: inline-size; }
        .wsjrdp-level-row { display: grid; grid-template-columns: 6rem auto minmax(7.5rem, 1fr); align-items: center;
          gap: .1rem .5rem; margin-bottom: .5rem; }
        .wsjrdp-level-group { margin-bottom: 0; }
        .wsjrdp-level-value { white-space: nowrap; }
        .wsjrdp-level-group .btn { width: 2.2rem; padding: .15rem 0; }
        @container (max-width: 27.75rem) {
          .wsjrdp-level-row { grid-template-columns: 6rem 1fr; }
          .wsjrdp-level-row .wsjrdp-level-value { grid-column: 2; }
          .wsjrdp-level-row .wsjrdp-level-group { align-self: end; }
          .wsjrdp-level-group { display: flex; }
          .wsjrdp-level-group .btn { flex: 1 1 0; width: auto; }
        }
      .small.text-muted.mb-2
        = safe_join(levels.each_with_index.map { |(label, _), i| "#{i} #{label}" }, " · ")
      .wsjrdp-languages.mb-3
        - Wsjrdp2027::Person::JamboreeData::LANGUAGES.each do |language|
          - if language == :english || @person.jamboree_data_adult?
            .wsjrdp-language-block
              .fw-semibold.mb-1= t("people.jamboree_data.language_names.#{language}")
              - Wsjrdp2027::Person::JamboreeData::LANGUAGE_SKILLS.each do |skill|
                - attr_name = :"#{language}_#{skill}"
                -# Without an answer "Keine" is ticked, and saved with the form.
                - level_value = @person.public_send(attr_name).presence || "none"
                .wsjrdp-level-row
                  -# A break allowed after the slash of "hören/verstehen".
                  .wsjrdp-skill= safe_join(t("people.jamboree_data.language_skills.#{skill}").split("/"), "/".html_safe + tag(:wbr))
                  .btn-group.wsjrdp-level-group{role: "group", "aria-label": Person.human_attribute_name(attr_name)}
                    - levels.each_with_index do |(label, level), number|
                      - id = "person_#{attr_name}_#{level}"
                      = f.radio_button attr_name, level, id: id, class: "btn-check", autocomplete: "off", checked: level == level_value
                      %label.btn.btn-sm.btn-outline-primary{for: id, title: label, data: {level_label: label}}= number
                  .small.text-primary.wsjrdp-level-value= levels.to_h.invert[level_value]

    = field_set_tag do
      %h3= t('people.jamboree_data.travel')
      = f.labeled_collection_select :travel_document_type, @person.jamboree_data_options(:travel_document_type), :last, :first, {include_blank: true}, class: 'span4', help: t('people.jamboree_data.travel_document_type_help')
      -# Belongs to the select above, so further in on a wide screen (on a
      -# phone like the other fields). Required while shown, with the star of
      -# required labels; hidden, it is disabled (here and by the script), and
      -# a disabled field is neither sent nor checked.
      :css
        @media (min-width: 768px) { .wsjrdp-subfield { margin-left: 5rem; } }
      - other_travel_document = @person.travel_document_type == 'other_travel_document'
      .wsjrdp-subfield{ data: { jamboree_dependent_on: 'person_travel_document_type', jamboree_dependent_value: 'other_travel_document' }, hidden: !other_travel_document }
        = f.labeled_input_field :travel_document_other, required: true, disabled: !other_travel_document, label_class: 'col-md-3 col-xl-2 pb-1 required'
      = f.labeled_input_field :travel_document_number
      = f.labeled_date_field :travel_document_issue_date
      = f.labeled_date_field :travel_document_expiration_date
      = f.labeled_country_select_field :travel_document_country
      -# Without an answer "Nein" is chosen, and saved with the form.
      = f.labeled_collection_select :visa_needed, @person.jamboree_data_options(:visa_needed), :last, :first, {selected: @person.visa_needed.presence || "no"}, class: 'span4'
      .mt-3{ data: { jamboree_dependent_on: 'person_visa_needed', jamboree_dependent_value: 'yes_need_support' }, hidden: @person.visa_needed != 'yes_need_support' }
        - unless @person.jamboree_data_adult?
          = f.labeled_input_field :place_of_birth
        -# The visa choices show the template's English with a German
        -# translation. visa_information is no longer asked (kept as stored).
        = f.labeled_country_select_field :visa_nationality_at_birth, help: t('people.jamboree_data.visa_nationality_at_birth_help')
        -# Without an answer the further nationalities of the registration.
        = f.labeled_country_multi_select_field :visa_other_nationalities_codes, value: @person.visa_other_nationalities_codes_or_default
        -# Without an answer the one the person's gender suggests.
        = f.labeled_collection_select :visa_gender_as_in_travel_document, @person.jamboree_data_options(:visa_gender_as_in_travel_document), :last, :first, {include_blank: true, selected: @person.visa_gender_as_in_travel_document_or_default}, class: 'span4'
        = f.labeled_collection_select :visa_civil_status, @person.jamboree_data_options(:visa_civil_status), :last, :first, {include_blank: true}, class: 'span4'
        -# As the other travel document: further in, required while shown.
        - other_civil_status = @person.visa_civil_status == 'other'
        .wsjrdp-subfield{ data: { jamboree_dependent_on: 'person_visa_civil_status', jamboree_dependent_value: 'other' }, hidden: !other_civil_status }
          = f.labeled_input_field :visa_civil_status_other, required: true, disabled: !other_civil_status, label_class: 'col-md-3 col-xl-2 pb-1 required'
        = f.labeled(:visa_current_student_status) do
          - @person.jamboree_data_options(:visa_current_student_status).each do |label, value|
            = f.inline_radio_button(:visa_current_student_status, value, label, false)
        -# The EU family question with its relation (template CM, CU, CV)
        -# together, before the employer.
        = f.labeled(:visa_family_eu_citizen_relationship) do
          - @person.jamboree_data_options(:visa_family_eu_citizen_relationship).each do |label, value|
            = f.inline_radio_button(:visa_family_eu_citizen_relationship, value, label)
        -# The relation only with such a family member, its text only with
        -# Other; hidden, disabled here and by the script.
        - eu_family = @person.visa_family_eu_citizen_relationship == 'yes'
        - other_relation = eu_family && @person.visa_family_eu_citizen_relation == 'other'
        .wsjrdp-subfield{ data: { jamboree_dependent_on: 'person_visa_family_eu_citizen_relationship_yes' }, hidden: !eu_family }
          = f.labeled_collection_select :visa_family_eu_citizen_relation, @person.jamboree_data_options(:visa_family_eu_citizen_relation), :last, :first, {include_blank: true}, class: 'span4', disabled: !eu_family
          %div{ data: { jamboree_dependent_on: 'person_visa_family_eu_citizen_relation', jamboree_dependent_value: 'other' }, hidden: !other_relation }
            = f.labeled_input_field :visa_family_eu_citizen_relation_other, required: true, disabled: !other_relation, label_class: 'col-md-3 col-xl-2 pb-1 required'
        = f.labeled_input_field :visa_employer_name
        = f.labeled_input_field :visa_employer_address_1
        = f.labeled_input_field :visa_employer_address_2
        = f.labeled_input_field :visa_employer_city
        = f.labeled_input_field :visa_employer_postcode
        = f.labeled_input_field :visa_employer_state
        = f.labeled_country_select_field :visa_employer_country
        -# Ja/Nein as choices, so an unanswered question stays empty.
        = f.labeled(:visa_residence_other_than_nationality) do
          - yes_no_options.each do |value, label|
            = f.inline_radio_button(:visa_residence_other_than_nationality, value, label)
        .ms-3{ data: { jamboree_dependent_on: 'person_visa_residence_other_than_nationality_true' }, hidden: !@person.visa_residence_other_than_nationality }
          = f.labeled_country_select_field :visa_residence_country
          = f.labeled_input_field :visa_residence_permit
        = f.labeled_country_select_field :visa_schengen_first_entry, codes: Wsjrdp::CountryLookup::SCHENGEN_CODES
        = f.labeled(:visa_fingerprints_collected) do
          - yes_no_options.each do |value, label|
            = f.inline_radio_button(:visa_fingerprints_collected, value, label)
        .ms-3{ data: { jamboree_dependent_on: 'person_visa_fingerprints_collected_true' }, hidden: !@person.visa_fingerprints_collected }
          = f.labeled_date_field :visa_fingerprints_date
          = f.labeled_input_field :visa_fingerprints_visa_number

    = field_set_tag do
      %h3= t('people.jamboree_data.journey')
      %p.text-muted= t(@person.jamboree_data_journey_editable? ? 'people.jamboree_data.journey_self_help' : 'people.jamboree_data.journey_unit_help')
      - if @person.jamboree_data_journey_editable?
        = f.labeled_collection_select :arrival_location, @person.jamboree_data_options(:arrival_location), :last, :first, {include_blank: true}, class: 'span4'
        = f.labeled_date_field :arrival_date
        = f.labeled_input_field :arrival_time, type: :time
        = f.labeled_collection_select :arrival_type, @person.jamboree_data_options(:arrival_type), :last, :first, {include_blank: true}, class: 'span4'
        = f.labeled_input_field :arrival_number
        = f.labeled_collection_select :departure_location, @person.jamboree_data_options(:departure_location), :last, :first, {include_blank: true}, class: 'span4'
        = f.labeled_date_field :departure_date
        = f.labeled_input_field :departure_time, type: :time
        = f.labeled_collection_select :departure_type, @person.jamboree_data_options(:departure_type), :last, :first, {include_blank: true}, class: 'span4'
        = f.labeled_input_field :departure_number
      - else
        = render_attrs(@person, *Wsjrdp2027::Person::JamboreeData::JOURNEY_ATTRS)

    = field_set_tag do
      %h3= t('people.jamboree_data.activities')
      .text-muted.mw-90ch.mb-2= t('people.jamboree_data.activities_help')
      :css
        .wsjrdp-comfort-row { display: grid; grid-template-columns: 26rem auto; justify-content: start; align-items: center;
          gap: .1rem .75rem; margin-bottom: .5rem; }
        .wsjrdp-comfort-row > :first-child { text-align: left; }
        .wsjrdp-comfort-group { margin-bottom: 0; }
        .wsjrdp-comfort-group .btn { width: 6.5rem; }
        .wsjrdp-comfort-block { container-type: inline-size; }
        @container (max-width: 28rem) {
          .wsjrdp-comfort-row { grid-template-columns: 1fr; }
          .wsjrdp-comfort-group { display: flex; }
          .wsjrdp-comfort-group .btn { flex: 1 1 0; width: auto; }
        }
      .wsjrdp-comfort-block
        - Wsjrdp2027::Person::JamboreeData::COMFORT_ATTRS.each do |attr|
          - selected = @person.public_send(attr)
          .wsjrdp-comfort-row
            %div= Person.human_attribute_name(attr)
            .btn-group.wsjrdp-comfort-group{role: "group", "aria-label": Person.human_attribute_name(attr)}
              - comfort_options.each do |value, label|
                - id = "person_#{attr}_#{value}"
                = f.radio_button attr, value, id: id, class: "btn-check", autocomplete: "off", checked: value == selected
                %label.btn.btn-sm.btn-outline-primary{for: id}= label
      - if @person.jamboree_data_adult?
        = f.labeled_input_field :prior_wsj_experience
        - if @person.effective_wsj_role == 'UL'
          = f.labeled_input_field :vehicle_registration_number
        - else
          = f.labeled_input_field :vehicle_registration_number, help: t('people.jamboree_data.vehicle_registration_number_help')

    = field_set_tag do
      %h3= t('people.jamboree_data.diet')
      = f.labeled_collection_select(:diet, Settings.diets, :first, :last, {}, class: 'span4')
      = f.labeled_input_field :dietary_details

    = field_set_tag do
      %h3= t('people.jamboree_data.allergies')
      -# One row per allergy: keine, mild, mittel or schwer as single-choice
      -# buttons (allergy_<key>_level, see Wsjrdp2027::Person::JamboreeData),
      -# the severities explained once above. Two columns where the width
      -# allows; a narrow row puts the name above the buttons, which then fill it.
      :css
        .wsjrdp-allergies { columns: 24rem 2; column-gap: 4rem; }
        .wsjrdp-allergy { break-inside: avoid; container-type: inline-size; padding-bottom: .5rem; }
        .wsjrdp-allergy-row { display: grid; grid-template-columns: 8.5rem auto; justify-content: start; align-items: center; gap: .1rem .75rem; }
        .wsjrdp-allergy-row > :first-child { text-align: right; }
        .wsjrdp-allergy-row .btn-group { margin-bottom: 0; }
        @container (max-width: 23.75rem) {
          .wsjrdp-allergy-row { grid-template-columns: 1fr; justify-content: stretch; }
          .wsjrdp-allergy-row > :first-child { text-align: left; }
          .wsjrdp-allergy-row .btn-group { display: flex; }
          .wsjrdp-allergy-row .btn { flex: 1 1 0; }
        }
      - level_labels = Wsjrdp2027::Person::JamboreeData::ALLERGY_LEVELS.index_with { |level| t("people.jamboree_data.allergy_levels.#{level}") }
      - severity_texts = Wsjrdp2027::Person::JamboreeData::ALLERGY_SEVERITIES.index_with { |level| t("activerecord.attributes.person.jamboree_allergy_severities.#{level}") }
      .small.text-muted.mb-2
        = safe_join(Wsjrdp2027::Person::JamboreeData::ALLERGY_SEVERITIES.reverse.map { |level| "#{level_labels[level]}: #{severity_texts[level]}" }, " · ")
      .wsjrdp-allergies.mb-3
        - Wsjrdp2027::Person::JamboreeData::ALLERGIES.each do |allergy_key|
          - attr_name = :"allergy_#{allergy_key}_level"
          - level_value = @person.public_send(attr_name)
          .wsjrdp-allergy
            .wsjrdp-allergy-row
              %div= Person.human_attribute_name(:"allergy_#{allergy_key}")
              .btn-group{role: "group", "aria-label": Person.human_attribute_name(:"allergy_#{allergy_key}")}
                - level_labels.each do |level, label|
                  - id = "person_#{attr_name}_#{level}"
                  = f.radio_button attr_name, level, id: id, class: "btn-check", autocomplete: "off", checked: level == level_value
                  %label.btn.btn-sm.btn-outline-primary{for: id, title: severity_texts[level]}= label
            - if level_value.nil?
              .alert.alert-warning.py-1.px-2.mt-1.mb-0.small= t('people.jamboree_data.allergy_severity_missing')

    = field_set_tag do
      %h3= t('people.jamboree_data.health')
      .text-muted.mw-90ch.mb-2= t('people.jamboree_data.health_help')
      = f.labeled_boolean_field :refrigerated_medication_needed
      = f.labeled_input_field :religious_health_beliefs
      .mb-3
        %label.form-label= Person.human_attribute_name(:medical_equipment_needs)
        -# The empty value lets an untick of all boxes reach the model.
        = hidden_field_tag 'person[medical_equipment_needs][]', '', id: nil
        - @person.jamboree_data_medical_equipment_options.each do |label, value|
          - checkbox_id = "person_medical_equipment_needs_#{value}"
          .form-check
            = check_box_tag 'person[medical_equipment_needs][]', value, Array(@person.medical_equipment_needs).include?(value), id: checkbox_id, class: 'form-check-input'
            = label_tag checkbox_id, label, class: 'form-check-label'
      .mt-2{ data: { jamboree_dependent_on: 'person_medical_equipment_needs_other' }, hidden: !Array(@person.medical_equipment_needs).include?('other') }
        = f.labeled_input_field :medical_equipment_details
      = f.labeled_boolean_field :mobility_restricted
      = f.labeled_boolean_field :uses_wheelchair
      .mt-2{ data: { jamboree_dependent_on: 'person_uses_wheelchair' }, hidden: !@person.uses_wheelchair }
        = f.labeled_collection_select :wheelchair_type, @person.jamboree_data_options(:wheelchair_type), :last, :first, {include_blank: true}, class: 'span4'
      = f.labeled_boolean_field :uses_mobility_frame
      = f.labeled_boolean_field :other_mobility_needs
      .mt-2{ data: { jamboree_dependent_on: 'person_other_mobility_needs' }, hidden: !@person.other_mobility_needs }
        = f.labeled_input_field :other_mobility_details
      = f.labeled_boolean_field :sensory_sensitivities
      = f.labeled_boolean_field :non_visible_disability
      .mt-2{ data: { jamboree_dependent_on: 'person_non_visible_disability' }, hidden: !@person.non_visible_disability }
        = f.labeled_input_field :non_visible_disability_details

    = field_set_tag do
      %h3= t('people.jamboree_data.legal')
      .form-check.mb-3
        = f.check_box :gdpr_agreement, class: 'form-check-input', id: 'person_gdpr_agreement'
        = f.label :gdpr_agreement, class: 'form-check-label' do
          = raw(t('people.jamboree_data.gdpr_agreement'))
      .form-check
        = f.check_box :jamboree_data_confirmed, class: 'form-check-input', id: 'person_jamboree_data_confirmed'
        = f.label :jamboree_data_confirmed, class: 'form-check-label' do
          = t('people.jamboree_data.confirmed')

    = form_buttons(f, cancel_url: jamboree_data_page_path(@group, @person))

-# Shows and hides the blocks that depend on a box (wheelchair type, ...).
= javascript_include_tag "hitobito_wsjrdp_2027/jamboree_data_form", "data-turbo-track": true
