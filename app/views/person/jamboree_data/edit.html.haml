#main.row
  = standard_form @person, url: jamboree_data_group_person_path, method: :put, html: { class: 'form-striped', data: { jamboree_data_form: true } } do |f|
    = f.error_messages
    = form_buttons(f, cancel_url: jamboree_data_group_person_path)

    .mt-3
      %h3= t('people.tabs.jamboree_data')
    .text-muted.mw-90ch.mb-2
      %p Bitte fülle die Zusatzdaten so vollständig wie möglich aus. Die Angaben werden für Reise, Visa, Gesundheit und Notfallplanung verwendet.

    = field_set_tag do
      %h3= t('people.jamboree_data.personal')
      = f.labeled_input_field :known_as_name
      = f.labeled_input_field :mothers_first_name
      = f.labeled_input_field :fathers_first_name
      = f.labeled_input_field :mothers_surname_at_birth
      = f.labeled_input_field :place_of_birth
      = f.labeled_input_field :country_of_birth
      = f.labeled_input_field :nationality

    = field_set_tag do
      %h3= t('people.jamboree_data.languages')
      - language_labels = { english: 'Englisch', french: 'Französisch', spanish: 'Spanisch', arabic: 'Arabisch' }
      - Wsjrdp2027::Person::JAMBOREE_LANGUAGES.each do |language|
        %h4.mt-3= language_labels.fetch(language)
        - Wsjrdp2027::Person::JAMBOREE_LANGUAGE_SKILLS.each do |skill|
          - attr_name = :"#{language}_#{skill}"
          = f.labeled_collection_select(attr_name, Wsjrdp2027::Person::JAMBOREE_LANGUAGE_LEVEL_OPTIONS, :last, :first, {}, class: 'span4')

    = field_set_tag do
      %h3= t('people.jamboree_data.travel')
      = f.labeled_collection_select :travel_document_type, Wsjrdp2027::Person::JAMBOREE_TRAVEL_DOCUMENT_TYPE_OPTIONS, :last, :first, {}, class: 'span4'
      = f.labeled_input_field :travel_document_number
      = f.labeled_date_field :travel_document_issue_date
      = f.labeled_date_field :travel_document_expiration_date
      = f.labeled_input_field :travel_document_country
      = f.labeled_collection_select :visa_needed, Wsjrdp2027::Person::JAMBOREE_VISA_NEEDED_OPTIONS, :last, :first, {}, class: 'span4'
      = f.labeled_input_field :visa_information

    = field_set_tag do
      %h3= t('people.jamboree_data.activities')
      = f.labeled_boolean_field :comfortable_on_water
      = f.labeled_boolean_field :comfortable_in_water
      = f.labeled_boolean_field :comfortable_without_balance
      = f.labeled_boolean_field :comfortable_in_crowd
      = f.labeled_boolean_field :comfortable_flashing_lights
      = f.labeled_boolean_field :comfortable_loud_noise
      = f.labeled_boolean_field :comfortable_confined_space
      = f.labeled_input_field :prior_wsj_experience
      = f.labeled_input_field :vehicle_registration_number

    = field_set_tag do
      %h3= t('people.jamboree_data.diet')
      = f.labeled_input_field :dietary_requirements
      = f.labeled_input_field :dietary_details
      - Wsjrdp2027::Person::JAMBOREE_ALLERGIES.each do |allergy_key, allergy_label|
        - checkbox_id = "person_allergy_#{allergy_key}"
        .mb-3
          .form-check
            = check_box_tag "person[allergy_#{allergy_key}]", '1', @person.public_send("allergy_#{allergy_key}"), id: checkbox_id, class: 'form-check-input'
            = label_tag checkbox_id, allergy_label, class: 'form-check-label'
          .mt-2{ data: { jamboree_dependent_on: checkbox_id }, hidden: !@person.public_send("allergy_#{allergy_key}") }
            = f.labeled_collection_select :"allergy_#{allergy_key}_severity", Wsjrdp2027::Person::JAMBOREE_ALLERGY_SEVERITY_OPTIONS, :last, :first, {}, class: 'span4'

    = field_set_tag do
      %h3= t('people.jamboree_data.health')
      = f.labeled_boolean_field :refrigerated_medication_needed
      = f.labeled_input_field :religious_health_beliefs
      .mb-3
        %label.form-label= Person.human_attribute_name(:medical_equipment_needs)
        - Wsjrdp2027::Person::JAMBOREE_MEDICAL_EQUIPMENT_OPTIONS.each do |label, value|
          - checkbox_id = "person_medical_equipment_needs_#{value}"
          .form-check
            = check_box_tag 'person[medical_equipment_needs][]', value, Array(@person.medical_equipment_needs).include?(value), id: checkbox_id, class: 'form-check-input'
            = label_tag checkbox_id, label, class: 'form-check-label'
      .mt-2{ data: { jamboree_dependent_on: 'person_medical_equipment_needs_other' }, hidden: !Array(@person.medical_equipment_needs).include?('other') }
        = f.labeled_input_field :medical_equipment_details
      = f.labeled_boolean_field :mobility_restricted
      = f.labeled_boolean_field :uses_wheelchair
      .mt-2{ data: { jamboree_dependent_on: 'person_uses_wheelchair' }, hidden: !@person.uses_wheelchair }
        = f.labeled_collection_select :wheelchair_type, Wsjrdp2027::Person::JAMBOREE_WHEELCHAIR_TYPE_OPTIONS, :last, :first, {}, class: 'span4'
      = f.labeled_boolean_field :uses_mobility_frame
      = f.labeled_boolean_field :other_mobility_needs
      .mt-2{ data: { jamboree_dependent_on: 'person_other_mobility_needs' }, hidden: !@person.other_mobility_needs }
        = f.labeled_input_field :other_mobility_details
      = f.labeled_boolean_field :sensory_sensitivities
      = f.labeled_boolean_field :non_visible_disability
      .mt-2{ data: { jamboree_dependent_on: 'person_non_visible_disability' }, hidden: !@person.non_visible_disability }
        = f.labeled_input_field :non_visible_disability_details

    = field_set_tag do
      %h3= t('people.jamboree_data.legal')
      .form-check.mb-3
        = f.check_box :gdpr_agreement, class: 'form-check-input', id: 'person_gdpr_agreement'
        = f.label :gdpr_agreement, class: 'form-check-label' do
          = raw(t('people.jamboree_data.gdpr_agreement'))
      .form-check
        = f.check_box :jamboree_data_confirmed, class: 'form-check-input', id: 'person_jamboree_data_confirmed'
        = f.label :jamboree_data_confirmed, class: 'form-check-label' do
          = t('people.jamboree_data.confirmed')

    = form_buttons(f, cancel_url: jamboree_data_group_person_path)