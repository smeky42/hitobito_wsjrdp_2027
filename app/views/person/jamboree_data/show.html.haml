- content_for(:toolbar, render('actions_show'))

= render 'missing_confirmations', person: @person, edit_hint: true
#main.row
  %article.col-lg
    %h3= t('people.jamboree_data.clothing')
    .text-muted.mw-90ch.mb-2= t('people.jamboree_data.clothing_help')
    - clothing_attrs = [:shirt_size, :uniform_size, :uniform_long_sleeve]
    - clothing_attrs << :uniform_order if @person.uniform_order_available?
    = render_attrs(@person, *clothing_attrs, :headgear)

    %h3= t('people.jamboree_data.personal')
    -# The name tag: without a given name the default, grey, with where it
    -# comes from (Wsjrdp2027::Person::JamboreeData#known_as_name_default_with_source).
    %dl.dl-horizontal.m-0.p-2.border-top
      = labeled(captionize(:known_as_name, Person)) do
        - if @person.known_as_name.present?
          = @person.known_as_name
        - else
          - default, source = @person.known_as_name_default_with_source
          - if default
            %span.text-muted.fw-light= default
            .small.text-muted.fw-light= t("people.jamboree_data.known_as_name_not_chosen.#{source}")
    - personal_attrs = [:country_of_birth, :nationality]
    - personal_attrs.unshift(:place_of_birth) if @person.jamboree_data_adult? || @person.visa_needed == 'yes_need_support'
    - personal_attrs.unshift(:mothers_first_name, :fathers_first_name, :mothers_surname_at_birth) if @person.jamboree_data_adult?
    = render_attrs(@person, *personal_attrs)

    -# As in the form: one block per language, the skills as labels.
    %h3= t('people.jamboree_data.languages')
    - Wsjrdp2027::Person::JamboreeData::LANGUAGES.each do |language|
      - if language == :english || @person.jamboree_data_adult?
        .fw-semibold.mt-2= t("people.jamboree_data.language_names.#{language}")
        %dl.dl-horizontal.m-0.p-2.border-top
          - Wsjrdp2027::Person::JamboreeData::LANGUAGE_SKILLS.each do |skill|
            = labeled(t("people.jamboree_data.language_skills.#{skill}"), format_attr(@person, :"#{language}_#{skill}"))

    %h3= t('people.jamboree_data.travel')
    = render_attrs(@person,
      :travel_document_type,
      *(:travel_document_other if @person.travel_document_type == 'other_travel_document'),
      :travel_document_number,
      :travel_document_issue_date,
      :travel_document_expiration_date,
      :travel_document_country,
      :visa_needed)
    - if @person.visa_needed == 'yes_need_support'
      -# The free texts, the relation and the details of a Ja/Nein question
      -# only where their choice asks for them.
      - unasked = []
      - unasked << :visa_civil_status_other unless @person.visa_civil_status == 'other'
      - unasked << :visa_family_eu_citizen_relation unless @person.visa_family_eu_citizen_relationship == 'yes'
      - unasked << :visa_family_eu_citizen_relation_other unless @person.visa_family_eu_citizen_relation == 'other'
      - unasked.push(:visa_residence_country, :visa_residence_permit) unless @person.visa_residence_other_than_nationality
      - unasked.push(:visa_fingerprints_date, :visa_fingerprints_visa_number) unless @person.visa_fingerprints_collected
      = render_attrs(@person,
        *(Wsjrdp2027::Person::JamboreeData::VISA_DISPLAY_ATTRS - unasked))

    %h3= t('people.jamboree_data.journey')
    %p.text-muted= t(@person.jamboree_data_journey_editable? ? 'people.jamboree_data.journey_self_help' : 'people.jamboree_data.journey_unit_help')
    = render_attrs(@person, *Wsjrdp2027::Person::JamboreeData::JOURNEY_ATTRS)

    %h3= t('people.jamboree_data.activities')
    = render_attrs(@person,
      :comfortable_on_water,
      :comfortable_in_water,
      :comfortable_without_balance,
      :comfortable_in_crowd,
      :comfortable_flashing_lights,
      :comfortable_loud_noise,
      :comfortable_confined_space)
    - if @person.jamboree_data_adult?
      = render_attrs(@person, :prior_wsj_experience, :vehicle_registration_number)

    %h3= t('people.jamboree_data.diet')
    = render_attrs(@person, :diet, :dietary_details)

    -# Only the allergies with an allergy, each with its severity; the others
    -# in one line.
    %h3= t('people.jamboree_data.allergies')
    - with_allergy, without_allergy = @person.jamboree_data_allergies
    %dl.dl-horizontal.m-0.p-2.border-top
      - with_allergy.each do |allergy, severity|
        = labeled(Person.human_attribute_name(:"allergy_#{allergy}")) do
          - if severity
            = t("people.jamboree_data.allergy_levels.#{severity}")
            %span.small.text-muted.fw-light
              – #{t("activerecord.attributes.person.jamboree_allergy_severities.#{severity}")}
          - else
            %span.text-warning= t('people.jamboree_data.allergy_severity_not_given')
    - if without_allergy.any?
      .text-muted.fw-light.px-2.pb-2
        = t('people.jamboree_data.no_allergies', allergies: without_allergy.map { |allergy| Person.human_attribute_name(:"allergy_#{allergy}") }.join(", "))

    %h3= t('people.jamboree_data.health')
    = render_attrs(@person,
      :refrigerated_medication_needed,
      :religious_health_beliefs,
      :medical_equipment_needs,
      :medical_equipment_details,
      :mobility_restricted,
      :uses_wheelchair,
      :wheelchair_type,
      :uses_mobility_frame,
      :other_mobility_needs,
      :other_mobility_details,
      :sensory_sensitivities,
      :non_visible_disability,
      :non_visible_disability_details)

    %h3= t('people.jamboree_data.legal')
    = render_attrs(@person,
      :gdpr_agreement,
      :jamboree_data_confirmed)