-# The declaration the person signs, with what this page knows filled in --
-# whether it names the compensation of section 7.2 T&R included, which is part
-# of the deregistration and edited on the form. The document leads the section
-# as a picture with its facts and its buttons; where the page has no document to
-# offer, a greyed-out button with the reasons stands in its place.
- if @deregistration_form.available?
  -# Without an agreed compensation the form leaves both amounts to be filled
  -# in by hand, and the script refuses to send it: said before it is made, and
  -# asked again as it is.
  - no_compensation = !@deregistration_form.created? && @person.deregistration_actual_compensation_cents.nil?
  - if no_compensation
    .alert.alert-warning.mx-2.mb-2#deregistration_form_no_compensation= t('people.deregistration_form.no_compensation_hint')
  = render 'document_preview', key: 'form_preview',
    create_confirm: (t('people.deregistration_form.no_compensation_confirm') if no_compensation),
    file_name: @deregistration_form.file_name,
    facts: deregistration_form_facts(@deregistration_form),
    document_path: form_person_deregistration_path(@person),
    thumbnail_path: form_person_deregistration_path(@person, format: :png),
    open: @dereg_open_sections.include?('form_preview'),
    section_open: @dereg_open_sections.include?('form'),
    frame_title: t('people.deregistration_form.title'),
    create_path: create_form_person_deregistration_path(@person),
    created: @deregistration_form.created?,
    extra_actions: (button_to(discard_form_person_deregistration_path(@person), method: :post,
      class: 'btn btn-sm btn-outline-danger',
      form: {class: 'd-inline', data: {turbo_confirm: t('people.deregistration_form.discard_confirm')}}) { t('people.deregistration_form.discard') } if @deregistration_form.created? && @person.deregistration_editable?)
  -# Further facts below the document, in the page's field list: whom the
  -# script create_deregistration_form.py sends the form to, and the mails it
  -# has sent it with.
  #deregistration_form_mailing
    = render_attrs_list do
      = labeled(t('people.deregistration_form_mailing.from_label')) do
        %span#deregistration_form_from= deregistration_mail_addresses([@recipients.from])
      = labeled(t('people.deregistration_form_mailing.to_label')) do
        %span#deregistration_form_to= deregistration_mail_addresses(@recipients.to)
      = labeled(t('people.deregistration_form_mailing.cc_label')) do
        %span#deregistration_form_cc= deregistration_mail_addresses(@recipients.cc)
      = labeled(t('people.deregistration_form_mailing.bcc_label')) do
        %span#deregistration_form_bcc= deregistration_mail_addresses(@recipients.bcc, none: t('people.deregistration_form_mailing.no_addresses'))
        - if (source = deregistration_bcc_source(@recipients))
          %span.muted#deregistration_form_bcc_source(style="margin-left: 6px;")= source
      - if @recipients.reply_to.any?
        = labeled(t('people.deregistration_form_mailing.reply_to_label')) do
          %span#deregistration_form_reply_to= deregistration_mail_addresses(@recipients.reply_to)
      - mailings = deregistration_form_mailing_lines(@person)
      - if mailings.any?
        = labeled(t('people.deregistration_form_mailing.sent_label')) do
          - mailings.each do |line|
            .deregistration-form-mailing= line
      -# The stored PDF and the mails as they went out (EML).
      - documents = deregistration_form_document_lines(@person)
      - if documents.any?
        = labeled(t('people.deregistration_form_mailing.documents_label')) do
          #deregistration_form_documents= safe_join(documents)
- else
  .p-2
    - unavailable_text = deregistration_form_unavailable_text(@deregistration_form)
    = action_button(t("people.deregistration_form.button"), nil, :"file-pdf", disabled: unavailable_text, id: "deregistration_form_submit")
    .muted.mt-2#deregistration_form_hint= unavailable_text
