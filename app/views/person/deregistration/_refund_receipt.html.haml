-# The slip the finance team pays the refund from: what it will say, and below
-# that the document itself as a picture with its facts and its buttons. What it
-# carries beyond that -- the text above its table and whether the explanation
-# paragraph is printed -- belongs to the deregistration and is edited on the
-# form.
= render_attrs_list do
  = labeled(t("people.refund_receipt.team_unit")) do
    = @refund_receipt.team_unit
  = labeled(t("people.refund_receipt.role_name")) do
    = @refund_receipt.role_name
  -# The fee names its own reduction, so the label is the receipt's, not a
  -# fixed caption.
  = labeled(@refund_receipt.total_fee_label) do
    = @refund_receipt.total_fee_text
  = labeled(t("people.refund_receipt.amount_paid")) do
    = @refund_receipt.amount_paid_text
  = labeled(t("people.refund_receipt.booking_text")) do
    = @refund_receipt.booking_text
  = labeled(t("people.refund_receipt.purpose")) do
    = @refund_receipt.purpose
  = labeled(t("people.refund_receipt.account_holder")) do
    = @refund_receipt.account_holder
  = labeled(t("people.refund_receipt.iban")) do
    = @refund_receipt.iban
= render 'document_preview', key: 'receipt_preview',
  file_name: @refund_receipt.file_name,
  facts: deregistration_receipt_facts(@refund_receipt),
  document_path: refund_receipt_person_deregistration_path(@person),
  thumbnail_path: refund_receipt_person_deregistration_path(@person, format: :png),
  open: @dereg_open_sections.include?('receipt_preview'),
  section_open: @dereg_open_sections.include?('receipt'),
  frame_title: t('people.refund_receipt.title')
