#main.row
  = standard_form @person, url: status_group_person_path,  method: :put, html: { class: 'form-striped' } do |f|
    = f.error_messages
    = form_buttons(f, cancel_url: status_group_person_path)

    .mt-3
      -# %h3= t('people.attributes.status')
    = field_set_tag do
      = f.labeled_collection_select(:status, Settings.status, :first, :last, {}, class: 'span2')
      = f.labeled_input_fields :birthday, :first_name, :last_name, :print_at, :contract_upload_at, :complete_document_upload_at
      = f.labeled_collection_select(:wsj_role, wsj_role_options, :first, :last, {}, class: 'span2')
      - if @person.ist?
        = f.labeled_boolean_field :is_preallocated_ist
      = f.labeled_input_field :unit_code
    = field_set_tag do
      - deregistration_issue_help = "Bisheriger Wert: ".html_safe + auto_link_escaped_multiline(@person.deregistration_issue) unless @person.deregistration_issue.blank?
      = f.labeled_input_fields :deregistration_issue, help_inline: deregistration_issue_help
      = f.labeled_date_field :deregistration_requested_date, label: @person.deregistration_requested_date_label
      = f.labeled_date_field :deregistration_effective_date
    = field_set_tag do
      %p
        Beitragsreduktion: #{@person.total_fee_reduction_text || "keine"}
        = link_to(t("people.fee_reduction.status_link"), person_fee_path(@person), class: "ms-2")
    = field_set_tag do
      -# The plans, each written out below its line (installments_text).
      - if @person.active_custom_installments?
        = render_installment_attrs(@person, %i[active_custom_installments_issue_display active_custom_installments_display active_custom_installments_payment_method_display active_custom_installments_comment],
          {active_custom_installments_display: @person.active_fee_rule.yme_list})
      - else
        = render_installment_attrs(@person, %i[installments_string], {installments_string: @person.yme_list})
      = f.labeled_input_field :planned_custom_installments_issue
      = f.labeled_input_field :planned_custom_installments_string, help_inline: installments_text(@person.planned_fee_rule&.yme_list)
      = f.labeled_collection_select(:planned_custom_installments_payment_method, Wsjrdp2027::ParticipationFee.payment_method_options, :first, :last, {}, class: 'span2')
      = f.labeled_input_fields :planned_custom_installments_comment
      = f.help_block(raw(t('people.check_status_help.edit_custom_installments_help')))
    = form_buttons(f, cancel_url: status_group_person_path)
