-# The buttons of the "Ratenplan" section (installments_actions_id): with a
-# planned plan activate, discard or edit it, without one plan a new one --
-# blank, from the active plan, or from the standard plan of the role. All go
-# through Turbo: the form comes as a stream in their place, activating and
-# discarding come back as a page refresh.
- planned = person.planned_fee_rule&.custom_installments_plan?
-# Where the section is shown ("person" or "fin"); every request passes it on.
- ctx = local_assigns.fetch(:context, "person")
.mt-2
  - if planned
    = action_button("Aktivieren", activate_person_installments_path(person, context: ctx), "check",
        data: {turbo_method: :post, turbo_confirm: t("people.installments.activate_confirm")},
        title: t("people.installments.activate_help"))
    = action_button("Verwerfen", discard_person_installments_path(person, context: ctx), "trash-alt",
        class: "btn-danger",
        data: {turbo_method: :post, turbo_confirm: t("people.installments.discard_confirm")})
    = action_button("Bearbeiten",
        edit_person_installments_path(person, mode: "edit", context: ctx),
        :edit, remote: false, data: {turbo_stream: true})
  - else
    = action_button("Neuen Ratenplan planen",
        edit_person_installments_path(person, mode: "new", context: ctx),
        :plus, remote: false, data: {turbo_stream: true})
    - if person.wsjrdp_raw_installments_eur.present?
      = action_button("Aus aktivem Plan planen",
          edit_person_installments_path(person, mode: "from_active", context: ctx),
          :copy, remote: false, data: {turbo_stream: true})
    - if person.participation_fee.standard_payment_plan
      = action_button("Aus Standard-Plan planen",
          edit_person_installments_path(person, mode: "from_standard", context: ctx),
          :copy, remote: false, data: {turbo_stream: true})
