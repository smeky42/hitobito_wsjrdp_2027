<%= javascript_tag nonce: true do %>
// The mandate of the bank account form (person/bank_account/_form): the
// previous date's button fills the date in, a hint shows while the date lies
// in the past, and another while a new IBAN keeps the stored mandate
// reference. Listens on the document, as the form comes in by Turbo stream.
(function () {
  const INPUT = "input[data-sepa-mandate-date]"
  const IBAN = "input[data-sepa-iban]"
  const MANDATE_ID = "input[data-sepa-mandate-id]"

  function compact(value) {
    return (value || "").replace(/\s+/g, "").toUpperCase()
  }

  function syncMandateIdHint(form) {
    const iban = form.querySelector(IBAN)
    const mandateId = form.querySelector(MANDATE_ID)
    const hint = form.querySelector("[data-sepa-mandate-id-hint]")
    if (!iban || !mandateId || !hint) return
    const newIban = compact(iban.value) !== "" && compact(iban.value) !== iban.getAttribute("data-sepa-iban")
    const keptId = mandateId.value.trim().toLowerCase() === mandateId.getAttribute("data-sepa-mandate-id")
    hint.hidden = !(newIban && keptId)
  }

  function today() {
    const now = new Date()
    return new Date(now.getFullYear(), now.getMonth(), now.getDate())
  }

  // "25.10.2026" as a date; null for anything else.
  function parse(value) {
    const match = /^(\d{1,2})\.(\d{1,2})\.(\d{4})$/.exec((value || "").trim())
    return match ? new Date(Number(match[3]), Number(match[2]) - 1, Number(match[1])) : null
  }

  function syncHint(input) {
    const hint = input.closest("form").querySelector("[data-sepa-mandate-date-past]")
    const date = parse(input.value)
    if (hint) hint.hidden = !(date && date < today())
  }

  function onClick(event) {
    const button = event.target.closest("[data-sepa-mandate-date-set]")
    if (!button) return
    const input = button.closest("form").querySelector(INPUT)
    if (!input) return
    input.value = button.getAttribute("data-sepa-mandate-date-set")
    input.dispatchEvent(new Event("change", { bubbles: true }))
  }

  function onChange(event) {
    if (!event.target.matches) return
    if (event.target.matches(INPUT)) syncHint(event.target)
    if (event.target.matches(IBAN) || event.target.matches(MANDATE_ID)) {
      syncMandateIdHint(event.target.closest("form"))
    }
  }

  if (!window.wsjrdpBankAccountFormBound) {
    window.wsjrdpBankAccountFormBound = true
    document.addEventListener("click", onClick)
    document.addEventListener("change", onChange)
    document.addEventListener("input", onChange)
  }
})()
<% end %>
