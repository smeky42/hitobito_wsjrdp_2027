- title(t('groups.patrols.title'))

:css
  .patrol-list { min-height: 12rem; }
  .patrol-card.drag-over { background: #f0f6ff; }
  .patrol-item { cursor: grab; user-select: none; }
  .patrol-item.dragging { opacity: 0.5; }
  .patrol-card.patrol-invalid { border-color: #dc3545; }

= form_tag group_patrols_path(@group), method: :put, id: "patrols-form" do
  %p.text-muted
    Personen per Drag & Drop in die Patrols ziehen. Änderungen werden erst mit
    „Speichern“ übernommen. In jeder Patrol muss mindestens ein UL sein,
    maximal #{@max_patrol_size} Personen pro Patrol.

  .row.row-cols-1.row-cols-md-3.row-cols-xl-5.g-3{ data: { max: @max_patrol_size } }
    - ([nil] + @patrols).each do |patrol|
      .col
        .card.h-100.patrol-card{ data: { patrol: patrol.to_s } }
          .card-header.d-flex.justify-content-between
            %strong= patrol ? "Patrol #{patrol}" : "None"
            %span.patrol-count.badge.bg-secondary
          .card-body.p-2
            .patrol-list.list-group{ data: { patrol: patrol.to_s } }
              - @people.select { |p| (@patrols.include?(p.patrol) ? p.patrol : nil) == patrol }.each do |p|
                - ul = @ul_ids.include?(p.id)
                .patrol-item.list-group-item.list-group-item-action.d-flex.justify-content-between{ draggable: "true", data: { ul: ul.to_s, name: "#{p.first_name} #{p.last_name}" } }
                  %span= "#{p.first_name} #{p.last_name}"
                  %span.badge{ class: ul ? "bg-primary" : "bg-light text-dark" }= ul ? "UL" : "YP"
                  = hidden_field_tag "patrols[#{p.id}]", patrol.to_s, id: nil, class: "patrol-input"
            .patrol-errors.small.text-danger.mt-2

  .mt-3.d-flex.align-items-center.gap-3
    = submit_tag "Speichern", class: "btn btn-primary", id: "patrols-save"
    %span#patrols-dirty.text-warning.d-none Ungespeicherte Änderungen

:javascript
  (function () {
    var form = document.getElementById("patrols-form");
    if (!form) return;

    var max = parseInt(form.querySelector("[data-max]").dataset.max, 10);
    var saveBtn = document.getElementById("patrols-save");
    var dirtyHint = document.getElementById("patrols-dirty");
    var dragging = null;

    function sortList(list) {
      Array.prototype.slice.call(list.querySelectorAll(".patrol-item"))
        .sort(function (a, b) { return a.dataset.name.localeCompare(b.dataset.name); })
        .forEach(function (item) { list.appendChild(item); });
    }

    function validate() {
      var valid = true;
      form.querySelectorAll(".patrol-card").forEach(function (card) {
        var items = card.querySelectorAll(".patrol-item");
        var errors = [];
        card.querySelector(".patrol-count").textContent = items.length;
        if (card.dataset.patrol) {
          if (items.length > max) errors.push("Maximal " + max + " Personen.");
          if (!card.querySelector(".patrol-item[data-ul='true']")) errors.push("Kein UL in der Patrol.");
        }
        card.querySelector(".patrol-errors").textContent = errors.join(" ");
        card.classList.toggle("patrol-invalid", errors.length > 0);
        if (errors.length > 0) valid = false;
      });
      saveBtn.disabled = !valid;
    }

    form.querySelectorAll(".patrol-item").forEach(function (item) {
      item.addEventListener("dragstart", function (e) {
        dragging = item;
        item.classList.add("dragging");
        e.dataTransfer.effectAllowed = "move";
      });
      item.addEventListener("dragend", function () {
        item.classList.remove("dragging");
        dragging = null;
      });
    });

    form.querySelectorAll(".patrol-card").forEach(function (card) {
      var list = card.querySelector(".patrol-list");
      card.addEventListener("dragover", function (e) {
        if (!dragging) return;
        e.preventDefault();
        card.classList.add("drag-over");
      });
      card.addEventListener("dragleave", function (e) {
        if (!card.contains(e.relatedTarget)) card.classList.remove("drag-over");
      });
      card.addEventListener("drop", function (e) {
        e.preventDefault();
        card.classList.remove("drag-over");
        if (!dragging || dragging.parentElement === list) return;
        dragging.querySelector(".patrol-input").value = list.dataset.patrol;
        list.appendChild(dragging);
        sortList(list);
        dirtyHint.classList.remove("d-none");
        validate();
      });
    });

    validate();
  })();
