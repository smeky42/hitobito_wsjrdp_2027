#main
  %h1 Buchungsstapel
  %p.text-muted
    Übersicht der DATEV-Buchungsstapel (Primanota-Exporte) mit der Anzahl der enthaltenen Buchungen.
    Klick auf eine Zeile öffnet die Detailseite des Stapels.

  = wsjrdp_expandable_table do |t|
    - t.rows   booking_batches, id: "batch"
    - t.columns buchungsstapel_columns, menu: true
    - t.row_key { |b| b.id }
    - t.detail_page { |b| booking_batch_path(b) }
    - t.detail_src { |b| booking_batch_path(b) }
    - t.paging  per_options: [10, 25, 50, 100, :all]
    - t.filter  apply_url: apply_booking_batches_path

  %p.text-muted.small.mt-2
    #{booking_batches.total_count} Buchungsstapel angezeigt · #{shown_booking_count} Buchungen
