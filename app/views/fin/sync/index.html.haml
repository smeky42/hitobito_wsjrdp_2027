-#
-#  The overview: the newest runs of every source, and the button that
-#  deletes old files (it asks first).
- scope = "fin.sync.overview"
- days = Wsjrdp::Sync::Purge::KEEP.in_days.to_i

#main
  %h2.h4= t("fin.sync.runs.title")
  = render("fin/sync/runs", rows: sync_runs)

  %h2.h4.mt-4= t("#{scope}.files")
  %p= t("#{scope}.files_kept", days: days)
  = button_to(t("#{scope}.purge", days: days), fin_sync_purge_path, class: "btn btn-outline-danger btn-sm",
    form: {id: "sync-purge", data: {turbo_confirm: t("#{scope}.purge_confirm", days: days)}})
