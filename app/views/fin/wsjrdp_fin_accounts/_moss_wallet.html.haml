-#
-#  The statement of the MOSS WALLET: one row per MossBooking, on the shared
-#  expandable table (doc/wsjrdp/expandable_table.md) with the generic CNF filter
-#  above it and a quick-select preset per Moss kind. The kind is marked twice in
-#  every row -- the chip in "Art" and the coloured rail on the row's first cell
-#  (shared/wsjrdp/_moss_kind_styles paints both).
-#
-#  The two BALANCE lines sit OUTSIDE the table on purpose: they are not
-#  bookings, so they must not be sorted, filtered, paged or counted with them.
-#  Aktuelles Saldo stays above the rows, Eröffnungs-Saldo below -- the reading
-#  order of a statement, and the same order the camt table shows them in.
-#
-#  A row has no detail of its own -- it already shows everything the booking's
-#  page would repeat -- so opening it reveals nothing but the header line of
-#  links: the booking's page and the transaction's record in Moss. A top-up has
-#  no such record page (MossTopUp#moss_record_url), so its line is "Detailseite"
-#  alone.
:css
  /* Line 1 of the description: the payment's name, a touch heavier than the
     party and the Buchungstext next to it. Bootstrap < 5.3 has no .fw-medium. */
  .mw-name { font-weight: 500; }
  /* The green of a linked contribution booking, as on the camt statement. */
  .ae-linked { color: #00a030; }
  /* The balance lines: label left, amount right, in the table's own rhythm.
     Only the vertical padding is set here: the line is a direct child of the
     Bootstrap .row, whose gutter padding keeps it flush with "Zurück" and the
     table -- overriding it would push the line into the row's negative margin. */
  .mw-balance { display: flex; justify-content: space-between; align-items: baseline;
    gap: 1rem; max-width: 28rem; padding-top: .25rem; padding-bottom: .25rem; }
  .mw-balance-amount { font-variant-numeric: tabular-nums; }

= render "shared/wsjrdp/moss_kind_styles"

#main.row
  %p
    %a{href: return_url} Zurück

  -# The closing balance is the sum over EVERY booking of the wallet, so it is
  -# shown only while the table shows every booking too: with a filter applied
  -# the rows below would not add up to it. (Paging does not narrow the set,
  -# only the page.)
  - if wallet_bookings.state.filter.effective_slots.empty?
    .mw-balance.fw-semibold.mb-3
      %span Aktuelles Saldo
      %span.mw-balance-amount= fin_money(@wsjrdp_fin_account.closing_balance_eur)

  = wsjrdp_expandable_table do |t|
    - t.rows    wallet_bookings, id: "wallet"
    - t.columns moss_wallet_table_columns, menu: true
    - t.row_key { |booking| booking.id }
    -# The coloured rail: the row carries its kind's class, the stylesheet paints
    -# the 3px line inside the first cell.
    - t.row_class { |booking| moss_kind_css_class(booking.moss_transaction.type) }
    - t.detail_page { |booking| url_for(booking) }
    -# The transaction is preloaded with the page (the controller's
    -# wallet_bookings). A top-up answers nil here and gets no "In Moss" group.
    - moss_url = ->(booking) { booking.moss_transaction&.moss_record_url }
    - t.detail_link label: "In Moss", icon: :wallet, title: "Transaktion in Moss öffnen",
        title_new_tab: "Transaktion in Moss in neuem Tab öffnen", &moss_url
    - t.paging
    - t.filter  apply_url: apply_wsjrdp_fin_account_path(fin_account)
    - t.summary "#{wallet_bookings.total_count} Buchungen"

  .mw-balance.mt-2
    %span Eröffnungs-Saldo
    %span.mw-balance-amount= fin_money(fin_account.opening_balance_eur)

  = render "fin/wsjrdp_fin_accounts/account_form"
