-#
-#  The answer of #show to a frame request: the account's detail in the frame
-#  that asked -- a row of the list (an embedded pane) or the frame on the
-#  account's own page. "Bearbeiten" opens the form in that same frame.
= wsjrdp_detail_frame(Fin::WsjrdpFinAccountsController::PAGE_FRAME_PREFIX, fin_account.id) do
  = render "fin/wsjrdp_fin_accounts/detail", account: fin_account, ctx: detail_format_context,
    edit_url: (edit_wsjrdp_fin_account_path(fin_account) if can?(:update, fin_account)),
    edit_turbo_frame: turbo_frame_request_id
