-#
-#  The statement of a BANK account: its camt transactions as an expandable
-#  table (Fin::WsjrdpFinAccountsController#camt_transactions), the opening
-#  balance below it. The current balance is the page's head line (_summary).
-#  A row opens the transaction's detail with its inline edit; the description
-#  cell carries the buttons that link a person or a contribution booking.
:css
  .ae-linked { color: #00a030; }
-# The colours of the kind buttons in the quick choice.
= render "shared/wsjrdp/moss_kind_styles"

- may_edit = can?(:update, WsjrdpCamtTransaction)
#main.row
  %p
    %a{href: return_url} Zurück
    -# The payment orders sent from this account.
    %span.ms-3
      = link_to t("fin.payments.account_orders"), payment_orders_filtered_path(["account", "in", fin_account.id.to_s])

  = wsjrdp_expandable_table do |t|
    - t.rows camt_transactions, id: "ctx"
    - t.columns camt_transaction_table_columns(may_edit: may_edit,
      state: camt_transactions.state), menu: true
    - t.row_key(&:id)
    - t.detail_page(column: true) { |tx| wsjrdp_camt_transaction_path(tx) }
    - t.detail_src { |tx| wsjrdp_camt_transaction_path(tx) }
    - t.detail_links_aside
    - t.paging
    - t.filter apply_url: apply_wsjrdp_fin_account_path(fin_account)
    - t.summary "#{camt_transactions.total_count} Kontobewegungen · Summe (gefiltert): #{fin_money(camt_transactions.total_sum, "EUR")}"

  = render "fin/wsjrdp_fin_accounts/opening_balance"
