-#
-#  The head line of an account's page, the way online banking shows an account:
-#  name and IBAN on the left, the balance on the right. Closed by default, and
-#  open after a save (?details=open); open it shows the account's detail
-#  (_detail), and "Bearbeiten" swaps the form in for it (edit, in the frame).
-#
-#  Locals: account (WsjrdpFinAccount)
-#          edit_url: passed on to _detail
:css
  .fin-account-summary > summary { display: flex; align-items: center; gap: .75rem; padding: .75rem 1rem;
    cursor: pointer; list-style: none; }
  .fin-account-summary > summary::-webkit-details-marker { display: none; }
  .fin-account-summary-chevron { transition: transform .15s; }
  .fin-account-summary[open] .fin-account-summary-chevron { transform: rotate(90deg); }
  .fin-account-summary-identity { flex: 1; min-width: 0; overflow-wrap: anywhere; }
  .fin-account-summary-balance { font-variant-numeric: tabular-nums; white-space: nowrap; }

%details.fin-account-summary.border.rounded.mb-3{open: params[:details] == "open"}
  %summary
    %span.fin-account-summary-chevron.text-muted= icon(:"chevron-right")
    %span.fin-account-summary-identity
      %span.d-block.fw-semibold= fin_account_label(account)
      - if (identifier = fin_account_summary_identifier(account))
        %span.d-block.small.text-muted= identifier
    %span.fin-account-summary-balance.fs-4.fw-semibold= fin_money(account.closing_balance_eur)
  .border-top
    - frame_id = wsjrdp_detail_frame_id(Fin::WsjrdpFinAccountsController::PAGE_FRAME_PREFIX, account.id)
    = turbo_frame_tag(frame_id, class: "d-block") do
      = render "fin/wsjrdp_fin_accounts/detail", account: account, ctx: Fin::AttrFormatContext.regular,
        edit_url: local_assigns[:edit_url], edit_turbo_frame: frame_id
