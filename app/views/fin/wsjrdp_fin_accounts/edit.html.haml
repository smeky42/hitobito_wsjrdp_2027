-#
-#  The edit page of one finance account: a page of its own, and the frame that
-#  "Bearbeiten" opens in place of the detail -- on the account's page or in a
-#  row of the list. A failed save shows its errors right there; saving and
-#  "Abbrechen" return to the reading view. Turbo swaps only the frame's
-#  content, so the padding sits inside it.
- if turbo_frame_request?
  = wsjrdp_detail_frame(Fin::WsjrdpFinAccountsController::PAGE_FRAME_PREFIX, fin_account.id) do
    .px-3.pt-2.pb-3= render "fin/wsjrdp_fin_accounts/account_form"
- else
  = render "fin/wsjrdp_fin_accounts/account_form"
