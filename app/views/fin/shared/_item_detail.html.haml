-#
-#  Detail view of a Buchhaltung item (ledger account / cost center / supplier):
-#  its metadata fields plus the embedded, paged bookings. Rendered inside a lazy
-#  turbo frame for the inline expandable rows and directly on the dedicated detail
-#  page -- the same view either way. The .bk-item-detail wrapper suppresses hover
-#  highlighting inside the detail view.
-# This detail is rendered directly on the dedicated /bookkeeping/... page
-# (level 0) and lazily inside the list's expandable row (the widget puts the
-# depth into the frame URL as `_lvl`). Either way the embedded bookings table
-# is told its nesting level, so ITS rows' details count one deeper.
- level = params[:_lvl].to_i
.bk-item-detail
  = render "shared/detail_fields", fields: fields

  = render "fin/bookings/embedded", query: query, show_all_path: show_all_path,
    all_label: all_label, detail_level: level
