-#
-#  The edit page of a Moss transaction: the same detail (_detail) in the kit's
-#  :edit mode, with an input for the comment. A save goes back to the page the
-#  reader came from (`return_url`), else to the reading page; "Abbrechen" to
-#  the reading page.
- tx = @transaction
= wsjrdp_detail_frame("mtx", tx.id) do
  = render "detail", transaction: tx, ctx: @ctx, editing: true, return_path: return_path,
    form_url: moss_transaction_path(tx, return_url: return_path),
    cancel_url: moss_transaction_path(tx, return_url: return_path)
