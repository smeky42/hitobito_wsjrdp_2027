-#
-#  The detail of one Moss transaction, built on the finance detail kit
-#  (doc/fin/detail_partials.md): the reading page (show), the edit page (edit),
-#  the lazy row detail of the transactions tables and the Moss leg of an
-#  Umbuchung are this one list of fields. The values come from
-#  Fin::MossTransactionsHelper, the labels from
-#  de.activerecord.attributes.moss_transaction.
-#
-#  Locals: transaction (MossTransaction)
-#          ctx (Fin::AttrFormatContext; default: a table row's)
-#          editing:    false the reading page (default), true the edit page,
-#                      nil a table row (inline edit)
-#          form_url:   the PATCH target; its presence makes the comment editable
-#          edit_url, cancel_url: as the detail kit takes them
-#          return_path: the page the reader came from; the header leads back
- tx = transaction
- ctx = local_assigns[:ctx] || Fin::AttrFormatContext.embedded(Wsjrdp::TableContext.new(level: 1))
- edit = moss_comment_edit_options(local_assigns[:form_url].present?)
= render "shared/wsjrdp/moss_kind_styles"
= fin_detail(tx, ctx, editing: local_assigns.fetch(:editing, false), form_url: local_assigns[:form_url],
    edit_url: local_assigns[:edit_url], cancel_url: local_assigns[:cancel_url], sticky_actions: true) do |d|
  - d.header label: "#{moss_kind_label(tx.type)} ##{tx.id}", title: tx.display_name.presence,
      back: local_assigns[:return_path], back_label: t("global.button.back")
  - d.attrs :type, :moss_status, :signed_total_base_amount, :original_amount, :exchange_rate, blank: :hide
  - d.attrs :payment_date, :booking_date, :approval_date, :invoice_date, :delivery_date, :due_date,
      :submitted_on, blank: :hide
  - d.attrs :display_name, :display_text, blank: :hide
  - d.attrs :party, :supplier_account_number, :payment_reference, :invoice_number, :approver_name,
      :submitted_by, blank: :hide
  - d.attrs :comment, comment: {blank: :hide}.merge(edit.fetch(:comment, {}))
  - d.section title: "Verknüpfungen", blank: :dash do
    - d.attrs :moss_record, :clearing_datev_booking, :fin_account
  -# The person side of every booking that has one, read-only: the buttons sit
  -# in the listing's row, and after one of them is used this detail reloads as
  -# a whole (the `reload_frames` stream action).
  - d.custom title: "Personen", key: :persons do
    - person_bookings = tx.bookings.select { |booking| booking.accounting_entries.any? || booking.subject.present? }
    - if person_bookings.empty?
      .small.text-muted Keine Person verknüpft.
    - person_bookings.each do |booking|
      .small.mb-1
        - if tx.bookings.size > 1
          .text-muted= moss_transaction_booking_label(booking)
        = render "fin/moss_bookings/subject_links", booking: booking, actions: false
  -# On the page, the expenses and the bookings each as an expandable table
  -# where there is more than one (a row's detail has the expense sub-rows
  -# above it instead). Each row opens its own detail, lazily.
  - expense_count = ctx.regular? ? tx.expenses.size : 0
  - if expense_count > 1
    - d.custom title: "Ausgaben (#{expense_count})", key: :expenses do
      = wsjrdp_expandable_table do |t|
        - t.rows transaction_expenses_rows(tx), id: "mte"
        - t.columns moss_expense_table_columns, menu: true
        - t.row_key(&:id)
        - t.detail_page { |expense| moss_expense_path(expense) }
        - t.detail_src { |expense| moss_expense_path(expense) }
        - t.detail_links_aside
  - if ctx.regular? && tx.bookings.size > 1
    - d.custom title: "Buchungen (#{tx.bookings.size})", key: :bookings do
      = render "fin/moss_bookings/parent_table", rows: transaction_bookings_rows(tx), id: "mtb", kind: tx.type
  - d.raw_data do
    - d.raw_entries :other_moss_columns, title: "Moss Rohdaten"
