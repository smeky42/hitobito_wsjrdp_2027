-#
-#  The reading page of a Moss transaction: its detail (_detail), with
-#  "Bearbeiten" for whoever may change it (edit). Also the detail the
-#  transactions tables lazy-load into a row (@ctx embedded): there it carries
-#  the kit's inline edit, whose save comes back to the row.
- tx = @transaction
-# The `replace_all` / `reload_frames` answers of the person-linking buttons in
-# the bookings table (Fin::MossBookingsController#respond_after_subject_link).
- if @ctx.regular?
  - content_for :head do
    = javascript_include_tag "hitobito_wsjrdp_2027/turbo_stream_actions", "data-turbo-track": true
- may_update = can?(:update, tx)
= wsjrdp_detail_frame("mtx", tx.id) do
  = render "detail", transaction: tx, ctx: @ctx, return_path: return_path,
    editing: (@ctx.regular? ? false : nil),
    edit_url: (@ctx.regular? && may_update ? edit_moss_transaction_path(tx, return_url: return_path) : nil),
    form_url: (!@ctx.regular? && may_update ? moss_transaction_path(tx) : nil)
