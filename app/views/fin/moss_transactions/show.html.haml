-#
-#  Standalone, bookmarkable detail page of one Moss transaction. Reuses the
-#  shared _detail partial inside a plain page shell.

#main
  = link_to moss_transactions_path, class: "btn btn-sm btn-link px-0 mb-2" do
    = icon(:"arrow-left")
    Zurück zur Liste

  -# Title on one line: the kind + id light + muted, then the transaction's
  -# name in the normal heading weight.
  %h1.mb-3
    %span.text-muted.fw-light= "#{moss_kind_label(@transaction.type)} ##{@transaction.id}"
    - if @transaction.display_name.present?
      %span.ms-2= @transaction.display_name

  = render "fin/moss_transactions/detail", transaction: @transaction
