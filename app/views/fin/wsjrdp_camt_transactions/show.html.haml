-#
-#  The reading page of a bank transaction: its detail (_detail), with
-#  "Bearbeiten" for whoever may change one (edit). Also the detail a table
-#  lazy-loads into a row (@ctx embedded): there it carries the kit's inline
-#  edit, whose save comes back to the row.
- tx = camt_transaction
- may_update = can?(:update, tx)
= wsjrdp_detail_frame(Fin::WsjrdpCamtTransactionsController::FRAME_PREFIX, tx.id) do
  = render "detail", tx: tx, ctx: @ctx, return_path: return_path,
    editing: (@ctx.regular? ? false : nil),
    edit_url: (@ctx.regular? && may_update ? edit_wsjrdp_camt_transaction_path(tx, return_url: return_path) : nil),
    form_url: (!@ctx.regular? && may_update ? wsjrdp_camt_transaction_path(tx) : nil)
