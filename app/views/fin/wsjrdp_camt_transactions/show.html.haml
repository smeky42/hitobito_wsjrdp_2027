#main.row
  = standard_form(camt_transaction, {url: camt_transaction_path, method: :put, data: {turbo: false}}) do |f|
    = hidden_field_tag("fin_admin", can_fin_admin?)
    = hidden_field_tag("return_url", return_url)
    = f.error_messages
    = form_buttons_if_editable(f, cancel_url: cancel_url)

    .mt-3
    = field_set_tag do
      %div.border-top.py-2
      -# = input_or_render_attrs(f, :camt_type)
      = input_or_render_attrs(f, :fin_account, display_link: true)
      -# = input_or_render_attrs(f, :account_servicer_reference, :credit_debit_indication)
      = input_or_render_attrs(f, :amount_eur, :base_currency)
      = input_or_render_attrs(f, :value_date, :booking_date)
      = input_or_render_attrs(f, :description, :comment)
      -# %div.border-top.py-2
      -# = input_or_render_attrs(f, :message_identification, :message_creation_date_time)
      -# %div.border-top.py-2
      -# = input_or_render_attrs(f, :report_identification, :report_creation_date_time)
      -# = input_or_render_attrs(f, :report_electronic_sequence_number, :report_legal_sequence_number, :report_page_number)
      -# %div.border-top.py-2
      -# = input_or_render_attrs(f, :status)
      %div.border-top.py-2
      = input_or_render_attrs(f, :subject, show_previous_as_help_inline: true)
      - accounting_entries = f.object.accounting_entries
      = form_like_labeled(if accounting_entries.size == 1 then "Buchung" else "Buchungen" end) do
        -# Both halves are links only for whoever may see the entry's person --
        -# see Fin::LinkedEntryHelper for the rule.
        - accounting_entries.each do |ae|
          %div
            %span= fin_entry_link(ae)
            %span.muted= " • "
            %span.fw-light.muted Person:
            %span= fin_subject_link(ae.subject)
      %div.border-top.py-2
      -# = input_or_render_attrs(f, :transaction_details_index)
      -# -#= input_or_render_attrs(f, :references)
      = input_or_render_attrs(f, :endtoend_id)
      = input_or_render_attrs(f, :mandate_id)
      -# -#= input_or_render_attrs(f, :bank_transaction_code)
      -# = input_or_render_attrs(f, :bank_transaction_code_dk)
      - if f.object.return_reason.present?
        = input_or_render_attrs(f, :return_reason)
        -# The select does not go through input_or_render_attrs, so it needs the
        -# permitted_attrs gate by hand
        - if permitted_attrs.include?(:return_status)
          = f.labeled_collection_select(:return_status, Settings.return_debit_status, :first, :last, {})
        - else
          = input_or_render_attrs(f, :return_status)
      %div.border-top.py-2
      = input_or_render_attrs(f, :status, :additional_entry_info)
      %div.border-top.py-2
      = input_or_render_attrs(f, :cdtr_name, :cdtr_iban, :cdtr_bic, :cdtr_address)
      %div.border-top.py-2
      = input_or_render_attrs(f, :dbtr_name, :dbtr_iban, :dbtr_bic, :dbtr_address)
      -# %div.border-top.py-2
      -# = input_or_render_attrs(f, :created_at, :updated_at)

    = form_buttons_if_editable(f, cancel_url: cancel_url)
