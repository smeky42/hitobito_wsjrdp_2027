-#
-#  The read-only detail of an AccountingEntry (Beitragsbuchung), built on the
-#  finance detail kit (doc/fin/detail_partials.md): on its own page (/fin/ae/:id)
-#  as the list, inside the reconciliation table's row as its compact rows. The
-#  form is the edit page's (edit). The values come from
-#  Fin::AccountingEntriesHelper, the labels from
-#  de.activerecord.attributes.accounting_entry.
-#
-#  Locals:
-#    entry -- the AccountingEntry
-#    ctx   -- Fin::AttrFormatContext (default: the page's)
-#    hide  -- Array of element keys to omit (default []). Recognised:
-#               :excluded_flag  the "von der Abstimmung ausgenommen" row
- e = entry
-# A Beitragsbuchung is one person's fee data (amount, mandate and end-to-end
-# reference, debtor and creditor IBAN), so this detail follows the same gate as
-# its own page: whoever may not :show the entry -- the read tier, see
-# doc/roles.md "Finance tiers" -- gets nothing. Every host is expected to leave
-# the block out in the first place; this is the backstop for a new one.
- return unless can?(:show, e)
- ctx = local_assigns[:ctx] || Fin::AttrFormatContext.regular
- hide = Array(local_assigns.fetch(:hide, []))
= fin_detail(e, ctx, editing: false) do |d|
  - d.attrs :booking_date, :value_date, :description, :comment, :amount_cents, :pre_notified_amount_cents,
      :subject, :source, :new_sepa_status, :return_reason,
      description: {span: 2}, comment: {span: 2},
      new_sepa_status: {label: "Finanzstatus"}
  - d.section title: "Verknüpfungen" do
    -# The bank transaction's summary may take the full width (span: 2).
    - d.attrs :id, :camt_transaction_id, :datev_booking_id, :direct_debit_pre_notification_id,
      :direct_debit_payment_info_id, :moss_booking_id, :payment_order, :reverses_id, :reversed_by_id,
      camt_transaction_id: {span: 2}, datev_booking_id: {span: 2}
  - d.section title: "SEPA-Lastschrift" do
    - d.attrs :mandate_id, :mandate_date, :debit_sequence_type, :endtoend_id,
      mandate_id: {label: "Mandats-ID"}, mandate_date: {label: "Mandatsdatum"},
      debit_sequence_type: {label: "Sequenztyp"}, endtoend_id: {label: "Ende-zu-Ende-ID"}
  - d.section title: "Debitor (Zahlungspflichtig)" do
    - d.attrs :dbtr_name, :dbtr_iban, :dbtr_bic, :dbtr_address,
      dbtr_name: {label: "Name"}, dbtr_iban: {label: "IBAN"}, dbtr_bic: {label: "BIC"},
      dbtr_address: {label: "Anschrift"}
  - d.section title: "Kreditor (Zahlungsempfänger*in)" do
    - d.attrs :cdtr_name, :cdtr_iban, :cdtr_bic, :cdtr_address, :creditor_id,
      cdtr_name: {label: "Name"}, cdtr_iban: {label: "IBAN"}, cdtr_bic: {label: "BIC"},
      cdtr_address: {label: "Anschrift"}, creditor_id: {label: "Gläubiger-ID"}
  - d.attrs :excluded_from_fee_reconciliation,
      excluded_from_fee_reconciliation: {hide: hide.include?(:excluded_flag)}
  - d.attrs :created_at, :author, :updated_at, updated_at: {label: "Zuletzt geändert"}
  -# The mails a script sent about this entry as a returned direct debit.
  - d.custom key: :debit_return_notices do
    = render "fin/accounting_entries/debit_return_notices", entry: e, ctx: ctx
