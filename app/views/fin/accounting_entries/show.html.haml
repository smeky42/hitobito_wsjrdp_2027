-#
-#  The reading page of a Beitragsbuchung: its detail (_detail, also the row
-#  detail of the reconciliation tables), with "Bearbeiten" for whoever may
-#  change one (edit).
#main.row
  .col-12
    - if can?(:update, AccountingEntry)
      .mb-3
        = link_to("Bearbeiten", edit_accounting_entry_path(accounting_entry), class: "btn btn-sm btn-outline-primary")
    = render "fin/accounting_entries/detail", entry: accounting_entry
