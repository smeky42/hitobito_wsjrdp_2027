-#
-#  The reading page of a Moss booking: its detail (_detail), with "Bearbeiten"
-#  for whoever may change it (edit). Also the detail the Buchungen list
-#  lazy-loads into a row (@ctx embedded): there it carries the kit's inline
-#  edit, whose save comes back to the row.
- booking = moss_booking
- may_update = can?(:update, booking)
= wsjrdp_detail_frame(Fin::MossBookingsController::FRAME_PREFIX, booking.id) do
  = render "detail", booking: booking, ctx: @ctx, return_path: return_path,
    editing: (@ctx.regular? ? false : nil),
    edit_url: (@ctx.regular? && may_update ? edit_moss_booking_path(booking, return_url: return_path) : nil),
    form_url: (!@ctx.regular? && may_update ? moss_booking_path(booking) : nil)
