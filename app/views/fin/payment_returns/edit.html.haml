-#
-#  The edit page of a return (its detail in edit mode): its status and comment
-#  as inputs (Fin::ReturnEditing).
= wsjrdp_detail_frame("pr", @return.id) do
  = render (@return.return_kind == "direct_debit") ? "detail" : "other_detail", entry: @return, ctx: @ctx,
    editing: true, form_url: payment_return_path(@return), cancel_url: payment_return_path(@return)
