-#
-#  The detail of a return that is no return of our direct debits (a returned
-#  credit transfer, ..., doc/fin/payments.md): what came back, the return
-#  with its processing status and comment, the other party, the bank's codes
-#  and the bank transaction itself. The values come from
-#  Fin::PaymentDetailsHelper, the labels from
-#  de.activerecord.attributes.wsjrdp_camt_transaction.
-#
-#  Locals: entry (a row of Fin::PaymentQueries.other_returns), ctx
-#          editing:    the kit's edit mode -- nil a list row, false the
-#                      reading page, true the edit page (Fin::ReturnEditing)
-#          form_url:   the PATCH target -- the edit page, or a list row's
-#                      inline edit; its presence makes status and comment
-#                      editable
-#          edit_url, cancel_url: as the detail kit takes them
- editing = local_assigns.fetch(:editing, nil)
= render "fin/payments/styles"
= fin_detail(entry, ctx, editing: editing, form_url: local_assigns[:form_url], edit_url: local_assigns[:edit_url],
    cancel_url: local_assigns[:cancel_url], sticky_actions: true) do |d|
  - d.header label: t("fin.payments.return_label", id: entry.id),
      title: t("fin.payments.return_kinds.#{entry.return_kind}")
  - d.attrs :return_kind, :return_date, :amount_cents, :return_reason, :return_status, :comment,
      :counterparty, :description, **{comment: {blank: :dash}}.deep_merge(payment_return_edit_options(local_assigns[:form_url].present?))
  -# The original: on the edit page the candidates to choose from
  -# (fin/payment_returns/_original_candidates).
  - original_input = editing ? {editable: true, input: :helper, options: :payment_return_original_input} : {}
  - d.attrs :original, :bank_transaction_code, :bank_transaction_code_dk, :camt_transaction,
      original: {span: 2, **original_input},
      bank_transaction_code: {span: 2}, bank_transaction_code_dk: {span: 2}
