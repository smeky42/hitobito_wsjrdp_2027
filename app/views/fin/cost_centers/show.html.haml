-#
-#  A Kostenstelle's detail page. The same frame the Kostenstellen list
-#  lazy-loads into its expandable row, so a frame request answers with the frame
-#  alone; back link and heading belong to the partial's header (d.header), which
-#  renders in :regular mode only.
- frame = turbo_frame_tag("bkframe-cost_center-#{@cost_center.number}") do
  = render "fin/cost_centers/detail", cost_center: @cost_center, ctx: @ctx

- if turbo_frame_request?
  = frame
- else
  #main= frame
