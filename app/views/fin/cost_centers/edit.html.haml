-#
-#  The edit page of one Kostenstelle: the same detail in the kit's :edit mode,
-#  with the cost center's own path as the PATCH target. "Abbrechen" goes back to
-#  the reading page.
= wsjrdp_detail_frame("cost_center", @cost_center.number) do
  = render "fin/cost_centers/detail", cost_center: @cost_center, ctx: @ctx, editing: true,
    form_url: cost_center_path(@cost_center.number),
    cancel_url: cost_center_path(@cost_center.number)
