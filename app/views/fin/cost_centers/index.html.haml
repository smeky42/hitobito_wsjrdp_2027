= render "shared/wsjrdp/moss_status_styles"

#main
  %h1 Kostenstellen
  %p.text-muted Übersicht der Kostenstellen mit deren Buchungen.

  -# The filter (and its "Schnellauswahl" preset) comes from the controller's
  -# policy: this view passes only the apply URL. Sorting, paging and the column
  -# hamburger are the widget's own links and keep the filter.
  -# The view switch (WsjrdpCostCenter::VIEWS) decides which cost center the
  -# sums count by; a detail opened from a row follows it (`?v=`).
  - view = cost_centers.state.view
  - view_param = {cost_centers.state.param_name(:view) => view}
  - if view == "any"
    .alert.alert-warning.py-1.px-2.small
      Buchungen mit zwei verschiedenen Kostenstellen zählen in beiden Zeilen
      und in den Summen unten mehrfach.
  = wsjrdp_expandable_table do |t|
    - t.rows   cost_centers, id: "cost_center"
    - t.columns kostenstellen_columns, menu: true
    - t.row_key { |c| c.number }
    - t.detail_link(**fin_unit_group_bookkeeping_link.except(:url), &fin_unit_group_bookkeeping_link[:url])
    - t.detail_page { |c| cost_center_path(c.number, view_param) }
    - t.detail_src { |c| cost_center_path(c.number, view_param) }
    - t.view label: "Summen nach", options: fin_cost_center_view_options
    - t.paging  per_options: [10, 25, 50, 100, :all]
    - t.filter  apply_url: apply_cost_centers_path

  %p.text-muted.small.mt-2
    #{cost_centers.total_count} Kostenstellen angezeigt · #{shown_booking_count} Buchungen · Summe #{fin_money(shown_booking_sum)}
