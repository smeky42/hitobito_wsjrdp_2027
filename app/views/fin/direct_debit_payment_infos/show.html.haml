-#
-#  The page of a Sammler (fin/direct_debit_payment_infos/_detail), also the
-#  row detail of the Sammler list; on its own page its debits
-#  (fin/direct_debits/_section).
= wsjrdp_detail_frame("dpi", @info.id) do
  = render "detail", info: @info, ctx: @ctx
  - if @ctx.regular?
    = render "fin/direct_debits/section", apply_url: apply_debits_direct_debit_payment_info_path(@info)
