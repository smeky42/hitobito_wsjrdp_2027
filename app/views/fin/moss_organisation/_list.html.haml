-#
-#  The list of a Moss tab: the expandable table, a row opening the record's
-#  detail.
-#
-#  Locals: columns: the table's columns with their cells
-#          title:   the page's heading
-#          empty:   what an empty list says
-#          noun:    the plural for the count line
-# The stream action redirect_top, which a save from a row's detail answers with.
- content_for :head do
  = javascript_include_tag "hitobito_wsjrdp_2027/turbo_stream_actions", "data-turbo-track": true
#main
  %h1= title
  = render "fin/moss_organisation/table", rows: rows, columns: columns, noun: noun, empty: empty,
    id: row_id_prefix, apply_url: apply_path
