-#
-#  The heading of a Moss record's page and edit page.
%h1.mb-3.d-flex.align-items-baseline.flex-wrap.gap-2
  %span.text-muted.fw-light= entry.class.model_name.human
  %span= entry.to_s
  - if entry.removed_from_moss?
    %span.badge.text-bg-secondary.fs-6{title: "Seit #{fin_date_time(entry.moss_removed_at)} nicht mehr in Moss"}
      nicht mehr in Moss
