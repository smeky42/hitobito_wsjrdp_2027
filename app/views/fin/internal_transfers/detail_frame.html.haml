-#
-#  The answer of #show to a frame request: the detail in the frame that asked
-#  -- a row of the list or the frame on the transfer's own page.
= wsjrdp_detail_frame(Fin::InternalTransfersController::PAGE_FRAME_PREFIX, transfer.id) do
  = render "fin/internal_transfers/detail", transfer: transfer,
    edit_url: (edit_internal_transfer_path(transfer) if can?(:update, transfer)),
    edit_turbo_frame: turbo_frame_request_id
