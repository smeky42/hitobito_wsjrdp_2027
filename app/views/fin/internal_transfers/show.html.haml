-#
-#  The page of one Umbuchung: the h1 (the finance detail header, no back
-#  link -- the Umbuchungen tab stands above it), then the detail in the frame that
-#  "Bearbeiten" swaps the form into (wsjrdp_detail_frame with the page's prefix).
- content_for :head do
  = javascript_include_tag "hitobito_wsjrdp_2027/turbo_stream_actions", "data-turbo-track": true
#main
  = render "fin/shared/detail_header", back: nil, back_label: nil, toolbar: nil,
    label: internal_transfer_page_label(transfer), title: internal_transfer_page_title(transfer)
  .border.rounded
    = turbo_frame_tag(page_frame_id(transfer), class: "d-block") do
      = render "fin/internal_transfers/detail", transfer: transfer,
        edit_url: (edit_internal_transfer_path(transfer) if can?(:update, transfer)),
        edit_turbo_frame: page_frame_id(transfer)
