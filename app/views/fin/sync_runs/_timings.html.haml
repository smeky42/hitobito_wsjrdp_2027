-#
-#  The phases of a run and of its parts: start, end and duration.
-#
-#  Locals: run (WsjrdpSyncRun), open (whether it starts unfolded)
- if run.timings.any?
  %details.mb-3{open: open, data: {keep_open: "sync-timings-#{run.id}"}}
    %summary= t("fin.sync.timings.title")
    = wsjrdp_expandable_table do |t|
      - t.rows timing_rows(run), id: "st#{run.id}"
      - t.columns fin_sync_timings_columns(run)
      - t.gaps max: "2rem", grow_max: "40rem", except: [%w[duration_ms duration]]
      - t.row_key { |row| row.position }
