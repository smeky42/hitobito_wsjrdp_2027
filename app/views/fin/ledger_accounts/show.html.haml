-#
-#  Rendered as a full page for a direct visit (eye icon), and as just the turbo
-#  frame when lazy-loaded into the inline expandable row on the Sachkonten list.
- frame = turbo_frame_tag("bkframe-account-#{@number}") do
  = account_item_detail(@number)

- if turbo_frame_request?
  = frame
- else
  #main
    %p.mb-1
      = link_to ledger_accounts_path, class: "small text-decoration-none" do
        ← Zurück zu Sachkonten
    %h1.mb-3
      Sachkonto #{@number}
      - name = ledger_account_records[@number]&.name
      - if name.present?
        %span.text-muted.fs-5.ms-2= name
    = frame
