-#
-#  The edit page of one Sachkonto: the same central detail, in the kit's :edit
-#  mode, with the account's own path as the PATCH target. "Abbrechen" goes back
-#  to the reading page.
= wsjrdp_detail_frame("account", @account.number) do
  = render "detail", account: @account, ctx: @ctx, editing: true,
    form_url: ledger_account_path(@account.number),
    cancel_url: ledger_account_path(@account.number)
