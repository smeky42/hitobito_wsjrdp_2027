-#
-#  The all-transactions page: every own account's transactions in one table
-#  (Fin::AccountTransactionsController). A row opens the bank or Moss
-#  transaction's own detail, with its inline edit; its description cell is the
-#  one of the row's own table.
= render "shared/wsjrdp/moss_kind_styles"
-# The description cells: a Moss row's and a bank row's (its linked entries).
= render "fin/moss_transactions/description_styles"
#main
  %h1= t("fin.tabs.all_transactions")

  = wsjrdp_expandable_table do |t|
    - t.rows transactions, id: "at"
    - t.columns account_transaction_table_columns(transactions.state), menu: true
    - t.row_key(&:row_key)
    - t.row_class { |row| Fin::AccountKinds.css_class(row.kind) }
    - t.detail_page(column: true) { |row| account_transaction_path(row) }
    - t.detail_src { |row| account_transaction_path(row) }
    - t.detail_links_aside
    - t.paging
    - t.filter apply_url: apply_fin_account_transactions_path
    - t.summary "#{transactions.total_count} Transaktionen · Summe (gefiltert): #{fin_money(transactions.total_sum, "EUR")}"
