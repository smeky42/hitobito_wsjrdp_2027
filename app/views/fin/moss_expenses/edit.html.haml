-#
-#  The edit page of a Moss expense: the same detail (_detail) in the kit's
-#  :edit mode, with an input for the comment.
= wsjrdp_detail_frame(Fin::MossExpensesController::FRAME_PREFIX, @moss_expense.id) do
  = render "detail", expense: @moss_expense, ctx: @ctx, editing: true, return_path: return_path,
    form_url: moss_expense_path(@moss_expense, return_url: return_path),
    cancel_url: moss_expense_path(@moss_expense, return_url: return_path)
