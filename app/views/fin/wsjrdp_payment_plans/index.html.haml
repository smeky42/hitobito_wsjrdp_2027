:css
  .thead-like {
    background-color: var(--bs-body-bg) !important;
    --bs-table-accent-bg: transparent !important;
  }

#main.row

  %table.table.table-striped.table-hover
    %thead
      %tr
        %th WSJRDP
        %th Einmalzahlung
        %th Raten
        %th Gesamt
        %th
    %tbody
      - @payment_plans.each do |di|
        %tr
          %td= di.wsjrdp_role
          %td= format_attr(di, :single_payment)
          %td= format_attr(di, :yme_list)
          %td= format_attr(di, :total_eur)
          %td.info-col
            %a{href: url_for(di)}
              %span.fa.fa-info-circle(aria-label="info" role="img")
