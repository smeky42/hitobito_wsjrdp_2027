-# Ratenpläne: the standard plans (WsjrdpPaymentPlan), each opening its own
-# page. The individual plans of people have the Individuelle Ratenpläne tab
-# (Fin::IndividualPaymentPlansController).
#main
  %h1 Ratenpläne
  %p.text-muted
    Die Standard-Ratenpläne je Rolle, Einmalzahlung und Zahlungsart.
  %table.table.table-striped.table-hover
    %thead
      %tr
        %th WSJRDP
        %th Einmalzahlung
        %th Raten
        %th Zahlungsart
        %th Gesamt
        %th
    %tbody
      - @payment_plans.each do |di|
        %tr
          %td= di.wsjrdp_role
          %td= format_attr(di, :single_payment)
          %td= format_attr(di, :yme_list)
          %td= di.payment_method_display
          %td= format_attr(di, :total_eur)
          %td.info-col
            %a{href: url_for(di)}
              %span.fa.fa-info-circle(aria-label="info" role="img")
