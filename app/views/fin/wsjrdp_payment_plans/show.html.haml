#main.row
  = standard_form(@wsjrdp_payment_plan, {url: wsjrdp_payment_plan_path, method: :put, data: {turbo: false}}) do |f|
    = hidden_field_tag("fin_admin", can_fin_admin?)
    = hidden_field_tag("return_url", return_url)
    = f.error_messages
    = form_buttons(f, cancel_url: cancel_url)

    .mt-3
      = field_set_tag do
        %div.border-top.py-2
          = input_or_render_attrs(f, :wsjrdp_role)
          = input_or_render_attrs(f, :single_payment)
          = input_or_render_attrs(f, :installments_string)
          = input_or_render_attrs(f, :comment)
          = input_or_render_attrs(f, :status)

    = form_buttons(f, cancel_url: cancel_url)
