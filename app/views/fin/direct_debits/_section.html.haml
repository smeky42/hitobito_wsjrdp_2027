-#
-#  The Einzüge section of an order's or a Sammler's page
-#  (Fin::DirectDebitsSection): the debits table without the order column,
-#  filtered on its own; nothing without :log on WsjrdpFinAccount.
-#
-#  Locals: apply_url (the host's apply_debits route)
- if section_debits?
  %h2.h5.mt-4= t("fin.tabs.direct_debits")
  = render "fin/direct_debits/table", rows: section_debits, totals: section_debit_totals, id: "d",
    apply_url: apply_url, columns: direct_debit_table_columns.reject { |col| col[:key] == "order" }
