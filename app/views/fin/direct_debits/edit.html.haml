-#
-#  The edit page of a debit (fin/direct_debits/_detail in edit mode): the
-#  fields its status lets change (Fin::DebitEditing) as inputs.
= wsjrdp_detail_frame("dd", @debit.id) do
  = render "detail", debit: @debit, ctx: @ctx, editing: true,
    form_url: direct_debit_path(@debit, return_url: return_path),
    cancel_url: direct_debit_path(@debit, return_url: return_path), return_path: return_path
