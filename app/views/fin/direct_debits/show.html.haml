-#
-#  The page of a debit (fin/direct_debits/_detail), also the row detail of the
-#  Einzüge tables. On its own page it is the reading page, with "Bearbeiten"
-#  for whoever may :update pre-notifications (edit).
= wsjrdp_detail_frame("dd", @debit.id) do
  = render "detail", debit: @debit, ctx: @ctx, editing: (@ctx.regular? ? false : nil),
    edit_url: (@ctx.regular? && can?(:update, @debit) ? edit_direct_debit_path(@debit, return_url: return_path) : nil),
    return_path: return_path
