-#
-#  The changes made to a debit in Hitobito, newest first, worded as in the
-#  person's log. Locals: debit, compact (one line each, for a row of the
-#  Beitrag page's entries)
- compact = local_assigns.fetch(:compact, false)
- debit_change_versions(debit).each do |version|
  - change = PaperTrail::VersionDecorator.new(version)
  - if compact
    .debit-change.small
      %span.text-muted{title: change.author_name}= l(version.created_at, format: "%d.%m.%Y %H:%M")
      = change.compact_changeset
  - else
    .debit-change.small
      .text-muted= change.header
      = change.changeset_list
