-#
-#  Thin pass-through to the bookings table adapter. Summary line, paging, the
-#  column hamburger, the filter and the row selection are all rendered by the
-#  shared widget (via fin/bookings/_bookings_table).
= render "fin/bookings/bookings_table", query: query,
  filter: local_assigns[:filter],
  row_badge: local_assigns[:row_badge], extra_columns: local_assigns[:extra_columns],
  selection: local_assigns[:selection], detail_top: local_assigns[:detail_top],
  detail_extra: local_assigns[:detail_extra]
