-#
-#  The edit page of one booking: the same central detail, in the kit's :edit
-#  mode. `form_url:` is left out, so the partial takes its own booking_path --
-#  the one PATCH endpoint every form of the detail posts to. "Abbrechen" goes
-#  back to the reading page.
= wsjrdp_detail_frame("bk", @booking.id) do
  = render "detail", booking: @booking, ctx: @ctx, editing: true,
    cancel_url: booking_path(@booking)
