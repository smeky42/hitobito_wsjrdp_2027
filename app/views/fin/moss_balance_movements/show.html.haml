#main.row
  = standard_form(@moss_balance_movement, {url: moss_balance_movement_path, method: :put, data: {turbo: false}}) do |f|
    = hidden_field_tag("fin_admin", can_fin_admin?)
    = hidden_field_tag("return_url", return_url)
    = f.error_messages
    = form_buttons(f, cancel_url: cancel_url)

    .mt-3
    = field_set_tag do
      %div.border-top.py-2
      = input_or_render_attrs(f, :fin_account, display_link: true)
      = input_or_render_attrs(f, :amount, :currency)
      = input_or_render_attrs(f, :payment_date, :booking_date)
      = input_or_render_attrs(f, :payment_reference, :note, :comment)
      %div.border-top.py-2
      = input_or_render_attrs(f, :subject, show_previous_as_help_inline: true)
      - accounting_entries = f.object.accounting_entries
      = form_like_labeled(if accounting_entries.size == 1 then "Buchung" else "Buchungen" end) do
        - accounting_entries.each do |ae|
          %div
            %span= link_to(ae.link_name, url_for(ae))
            %span.muted= " • "
            %span.fw-light.muted Person:
            %span= link_to(ae.subject.short_full_name_with_nickname, url_for(ae.subject))

      -# %div.border-top.py-2
      -# = input_or_render_attrs(f, :status)
      -# %div.border-top.py-2
      -# = input_or_render_attrs(f, :created_at, :updated_at)

    = form_buttons(f, cancel_url: cancel_url)
