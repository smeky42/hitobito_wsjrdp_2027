-#
-#  Zahlungsverkehr overview (default tab): the open work
-#  (fin/payments/_open_work), the tiles of all direct debit orders
-#  (fin/payments/_direct_debit_tiles, linking to the Aufträge list), the next
-#  collection and the collections by month.
-#  Figures: Fin::PaymentsOverview.
- ov = @overview

#main
  %h1= t("fin.nav.payments")
  %p.text-muted= t("fin.payments.overview_lead")

  = render "fin/payments/open_work", ov: ov

  %h2.mt-4.mb-3= t("fin.payments.tiles.direct_debits_heading")
  .payment-tiles
    = render "fin/payments/direct_debit_tiles", ov: ov, link: true
    = render "fin/payments/next_collection", ov: ov
  = render "fin/payments/months", ov: ov
