-#
-#  The look of the Zahlungsverkehr values, once per response
-#  (Fin::PaymentsHelper#payment_pre_notified_note): the announced amount
-#  beside a debit's amount stays in one piece -- next to the amount where it
-#  fits, a gap apart, else on a line of its own, flush with the amount (a
-#  flex row's column gap separates only what shares a line) --, an amount
-#  that differs from the collected one in the orange of the finance pages
-#  (fin/_person_status_styles); a debit's amount that differs from the
-#  announced one (Fin::PaymentsHelper#payment_debit_amount_cell) with the
-#  announced one small and struck through in front -- on a line of its own
-#  where the column has no room --, coloured by the case; dates and times with digits of one width; the
-#  per-Sammler lines under an order's value (Fin::PaymentsHelper#payment_order_stack),
-#  small and muted, their row aligned to the top so every cell's first line is
-#  the order's; the key figure strip of the direct debits
-#  (fin/payments/_direct_debit_tiles) and the open work checklist
-#  (fin/payments/_open_work); sequence type badges as small in a row of their own as in
-#  those lines. Also the "mehr" button of an amounts breakdown
-#  (Fin::PaymentsHelper#payment_count_with_breakdown): each click shows the
-#  next data-step hidden amounts and goes away once none is left.
- unless @payment_styles_rendered
  - @payment_styles_rendered = true
  :css
    .payment-amount-with-note { display: inline-flex; flex-wrap: wrap; column-gap: .9em; max-width: 100%; }
    .payment-pre-notified { display: inline-block; white-space: nowrap; }
    .payment-tabular { font-variant-numeric: tabular-nums; }
    .payment-pre-notified-differs { color: #e8590c; font-weight: 600; }
    .payment-amount-differs { display: inline-flex; flex-wrap: wrap; justify-content: flex-end; column-gap: .3em; white-space: nowrap; }
    .payment-amount-announced { font-size: .8em; font-weight: 300; color: var(--bs-secondary-color, #6c757d); }
    .payment-amount-lower { color: #e8590c; }
    .payment-amount-higher { color: var(--bs-danger); }
    .payment-amount-planned { color: var(--bs-primary); }
    .payment-amount-skipped { color: var(--bs-secondary-color, #6c757d); }
    .payment-stack-line { font-size: .8em; line-height: 1.5; color: var(--bs-secondary-color, #6c757d); white-space: nowrap; }
    .payment-stack-head { white-space: nowrap; }
    .payment-seq-badge { font-size: .525rem; }
    .payment-tiles { container-type: inline-size; }
    .payment-strip, .payment-tiles-row { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .payment-strip { gap: 1px; background: var(--bs-border-color); border: 1px solid var(--bs-border-color);
      border-radius: .375rem; overflow: hidden; }
    .payment-strip-cell { background: var(--bs-body-bg); padding: .6rem .9rem; min-width: 0;
      display: flex; flex-direction: column; justify-content: space-between; gap: .15rem; }
    a.payment-strip-cell:hover { background: var(--bs-tertiary-bg); }
    .payment-strip-single { grid-column: span 2; display: block; }
    @container (max-width: 56rem) {
      .payment-strip, .payment-tiles-row { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @container (max-width: 30rem) {
      .payment-strip-wide { grid-column: 1 / -1; } }
    .payment-checklist { max-width: 40rem; border-top: 1px solid var(--bs-border-color); }
    .payment-checklist-row { display: flex; justify-content: space-between; align-items: center; gap: 1rem;
      padding: .45rem .25rem; border-bottom: 1px solid var(--bs-border-color); }
    a.payment-checklist-row:hover { background: var(--bs-tertiary-bg); }
    .payment-checklist-done > summary { cursor: pointer; list-style: none; justify-content: flex-start; gap: .4rem; }
    .payment-checklist-done > summary::-webkit-details-marker { display: none; }
    .payment-checklist-done > summary::before { content: "✓"; color: var(--bs-success); }
    .payment-credit-link { white-space: nowrap; }
    .payment-stack-line .payment-credit-link { font-size: 1.25em; }
    tr:has(.payment-stack-head) > td { vertical-align: top; }
    .payment-breakdown-more { font-size: inherit; margin-left: .4em; vertical-align: baseline; }
  :javascript
    (function () {
      if (window.__paymentBreakdownMore) return;
      window.__paymentBreakdownMore = true;
      document.addEventListener("click", function (e) {
        var button = e.target.closest(".payment-breakdown-more");
        if (!button) return;
        var box = button.closest(".payment-breakdown");
        var hidden = box.querySelectorAll(".payment-breakdown-item[hidden]");
        var step = parseInt(box.dataset.step, 10) || hidden.length;
        for (var i = 0; i < Math.min(step, hidden.length); i++) hidden[i].hidden = false;
        if (hidden.length <= step) button.remove();
      });
    })();
