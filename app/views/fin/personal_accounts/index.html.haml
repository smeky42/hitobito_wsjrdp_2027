= render "shared/wsjrdp/moss_status_styles"

#main
  %h1 Kreditoren
  %p.text-muted
    Übersicht der Kreditoren (Lieferanten) mit der Summe der gebuchten Beträge (nur aktive Buchungen).
    Standardmäßig werden alle Kreditoren angezeigt, auch solche ohne Buchungen.
    Klick auf eine Zeile zeigt die Buchungen des Kreditors.

  -# The filter (and its "Schnellauswahl" presets) comes from the controller's
  -# policy: this view passes only the apply URL. Sorting, paging and the column
  -# hamburger are the widget's own links and keep the filter.
  = wsjrdp_expandable_table do |t|
    - t.rows   personal_accounts, id: "supplier"
    - t.columns kreditoren_columns, menu: true
    - t.row_key { |a| a.number }
    - t.detail_page { |a| personal_account_path(a.number) }
    - t.detail_src { |a| personal_account_path(a.number) }
    - t.paging  per_options: [10, 25, 50, 100, :all]
    - t.filter  apply_url: apply_personal_accounts_path

  %p.text-muted.small.mt-2
    #{personal_accounts.total_count} Kreditoren angezeigt · #{shown_booking_count} Buchungen
