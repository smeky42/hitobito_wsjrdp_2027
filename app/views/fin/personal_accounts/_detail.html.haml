-#
-#  The detail of a Kreditor: the master data in groups, the raw area with the
-#  entries blocks of the DATEV and the Moss export, and the account's embedded
-#  bookings. Shown on the Kreditor's own page and inside the Kreditoren list's
-#  detail pane -- `ctx` says which, and the kit (Fin::DetailHelper) picks
-#  header, layout and the raw area's open state from it.
-#
-#  Bank details and the Moss defaults stand on blank: :unset -- they say what
-#  the master data would carry, so their absence is worth reading ("nicht
-#  gesetzt"); every other field simply disappears when it is blank.
-#
-#  The values come from Fin::PersonalAccountsHelper, the labels from
-#  de.activerecord.attributes.wsjrdp_personal_account.
-#
-#  Locals: account (WsjrdpPersonalAccount), ctx (Fin::AttrFormatContext)
-#          editing:    the kit's edit mode -- nil the list's pane (its inline
-#                      default, i.e. no form without a form_url), false the
-#                      reading page, true the edit page
-#          form_url:   the PATCH target of the editable fields; nil = no form
-#          edit_url:   the edit page the reading page's "Bearbeiten" points at
-#          cancel_url: the reading page the edit page's "Abbrechen" returns to
-#
-#  Unit-Budget is the one field of a Kreditor Hitobito owns: whether a booking
-#  on this account belongs to a unit's budget. It is read everywhere and
-#  editable for the write tier, which is what the edit page is for.
- editing = local_assigns.fetch(:editing, nil)
- form_url = local_assigns.fetch(:form_url, nil)
= render "shared/wsjrdp/moss_status_styles"
= fin_detail(account, ctx, form_url: form_url, editing: editing,
    edit_url: local_assigns[:edit_url], cancel_url: local_assigns[:cancel_url]) do |d|
  - d.header back: personal_accounts_path, back_label: "Zurück zu Kreditoren",
      label: "Kreditor #{account.number}", title: account.name
  - d.attrs :name, :short_name, :aliases, :moss_status
  - d.attrs :is_unit_budget,
      is_unit_budget: {input: :select, options: fin_account_unit_budget_options,
                       editable: can?(:update, WsjrdpPersonalAccount)}
  - d.attrs :moss_account_holder_name, :iban, :bic, :moss_vat_id,
      :moss_default_payment_method, :address,
      iban: {blank: :unset}, bic: {blank: :unset}
  - d.attrs :moss_default_ledger_account_number, :moss_default_cost_center_number,
      :moss_default_sphere_number, :moss_default_team_name, blank: :unset
  - d.attrs :description, :comment, :represented_person
  - d.raw_data do
    - d.raw_entries :other_datev_columns, title: "DATEV Rohdaten"
    - d.raw_entries :other_moss_columns, title: "Moss Rohdaten"
  - d.bookings supplier_bookings(account.number),
      show_all_path: bookings_filter_path([[["any_account", "in", account.number]]]),
      all_label: "In Buchungen-Ansicht öffnen"
