-#
-#  The page of a payment order (fin/payment_orders/_detail), also the row
-#  detail of the Aufträge list; on its own page -- for a direct debit, with
-#  :log on WsjrdpFinAccount -- its debits (fin/direct_debits/_section).
= wsjrdp_detail_frame("po", @order.id) do
  = render "detail", order: @order, infos: @infos, ctx: @ctx
  - if @ctx.regular?
    = render "fin/direct_debits/section", apply_url: apply_debits_payment_order_path(@order)
