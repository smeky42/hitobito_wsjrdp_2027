-#
-#  The detail of one Moss department, on its page and in a list row: its
-#  fields, its teams and their users.
-#
-#  Locals: record (MossDepartment), ctx (Fin::AttrFormatContext)
-#          edit_url, edit_turbo_frame: see fin/moss_organisation/_detail_shell
- department = record
= render layout: "fin/moss_organisation/detail_shell",
  locals: {edit_url: local_assigns[:edit_url], edit_turbo_frame: local_assigns[:edit_turbo_frame]} do
  = fin_detail(department, ctx, editing: false, layout: :list) do |d|
    - d.attrs :name, :owner
    - d.attrs :comment, comment: {blank: :dash}
    - d.attrs :moss_department_uuid, :owner_uuid, :moss_organisation_uuid, :last_seen_at, :moss_removed_at,
        :created_at, :updated_at
    - d.custom title: "Teams", key: :teams do
      = render "fin/moss_organisation/table", rows: department_teams, columns: moss_teams_table_columns,
        noun: "Teams", id: "mdt_#{department.id}",
        apply_url: apply_teams_moss_department_path(department)
    - d.custom title: "Benutzer", key: :users do
      = render "fin/moss_organisation/table", rows: department_users, columns: moss_users_table_columns,
        noun: "Benutzer", id: "mdu_#{department.id}",
        apply_url: apply_users_moss_department_path(department)
    - d.raw_data title: "Weitere Moss-Daten" do
      - d.raw_entries :additional_info, title: "Zusatzdaten"
