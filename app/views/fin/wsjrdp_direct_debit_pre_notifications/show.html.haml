-#
-#  A debit under its person (Fin::WsjrdpDirectDebitPreNotificationsController):
-#  the Zahlungsverkehr area's detail, leading back to the person's Beitrag.
= render "fin/direct_debits/detail", debit: @debit, ctx: @ctx, editing: false,
  edit_url: (can?(:update, @debit) ? edit_wsjrdp_direct_debit_pre_notification_path(@debit, return_url: return_path) : nil),
  return_path: return_path, back: person_accounting_path(@person),
  back_label: t("fin.payments.back_to", tab: t("people.tabs.finance"))
