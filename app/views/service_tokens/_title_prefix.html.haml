-# "API-Key <id>" before the page heading, as the finance detail pages
-# set their "Kostenstelle <number>" (fin/shared/_detail_header: text-muted,
-# fw-light, gap-2). The core's title also names the browser tab, where
-# markup would show as text, so the prefix is drawn by CSS on the heading
-# alone.
:css
  .content-header h1::before {
    content: "#{ServiceToken.model_name.human} #{entry.id.to_i}";
    margin-right: .5rem;
    font-weight: 300;
    color: var(--bs-secondary-color, #6c757d);
  }
