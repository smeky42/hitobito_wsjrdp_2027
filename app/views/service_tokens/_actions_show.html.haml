= button_action_edit if can?(:edit, entry)
-# "Token neu erzeugen" in the kinds this API key may get: one button for one
-# kind, one per kind otherwise (Wsjrdp2027::ServiceToken#regenerate_kinds).
- if can?(:regenerate_token, entry)
  - kinds = entry.regenerate_kinds
  - kinds.each do |kind|
    = action_button(kinds.one? ? t('.regenerate_token') : t(".regenerate_token_as.#{kind}"),
      regenerate_token_group_service_token_path(entry.layer, entry, kind: kind), :sync,
      data: {method: :post, confirm: t('.regenerate_token_confirm')})
= button_action_destroy if can?(:destroy, entry)
