-# The :log extra of a core area (people:log, ...), in the line of the core's
-# checkbox of that area (Wsjrdp2027::StandardFormBuilder#boolean_field).
-# Disabled without an acting person; a checked one stays checked, so the form
-# can name it before it is dropped (service_tokens/_fields_wsjrdp_2027).
- token = f.object
- id = "service_token_scope_#{scope.tr(':', '_')}"
.form-check{data: {scope_extra: scope, scope_base: "service_token_#{area}"}}
  = check_box_tag 'service_token[wagon_scopes][]', scope, token.scopes.include?(scope), id: id,
    class: 'form-check-input', disabled: token.acting_person_id.nil?
  = label_tag id, class: 'form-check-label me-2' do
    = t('service_tokens.scope_fields.log')
