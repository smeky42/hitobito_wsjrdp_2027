-#
-#  The "one page forward" step button, icon only. On the last page it stays in
-#  place as a disabled item instead of disappearing (kaminari/wsjrdp/_paginator).
%li.page-item.bk-page-step{class: ("disabled" if current_page.last?)}
  - if current_page.last?
    %span.page-link{"aria-disabled": "true", "aria-label": "Nächste Seite", title: "Nächste Seite"}
      %i.fas.fa-chevron-right{"aria-hidden": "true"}
  - else
    = link_to url, {rel: "next", remote: remote, class: "page-link", title: "Nächste Seite", "aria-label": "Nächste Seite"} do
      %i.fas.fa-chevron-right{"aria-hidden": "true"}
