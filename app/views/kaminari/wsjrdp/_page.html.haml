-#
-#  A single page number. Markup as in the core's kaminari/_page, so hitobito's
-#  Bootstrap pagination styling carries over unchanged; the theme only needs its
-#  own copy because a themed paginator has no fallback to kaminari/.
%li{class: "#{"active" if page.current?} page-item"}
  = link_to page, page.current? ? "#" : url, {remote: remote, rel: page.next? ? "next" : (page.prev? ? "prev" : nil), class: "page-link"}
