-#  A new version of an account (also the first one of a new account),
-#  always for this stage.
- title(t("credential_versions.new.title", account: credential_account_title(kind_name, account_key, name: credential_display_name(report) || form.name.presence)))

- unless Wsjrdp::Credentials::Keys.current.active
  .alert.alert-warning#credentials-no-key= t("credentials.notices.no_key")

= render "form", url: credential_versions_path(kind: kind_name, account_key: account_key), method: :post
