-#
-#  The eye button next to a secret input: shows or hides what is in it.
- label = t("credential_versions.form.show_secret")
%button.btn.btn-outline-secondary{type: "button", title: label, data: {credential_show_secret: true}}
  %span.credential-eye-show= icon(:eye)
  %span.credential-eye-hide.d-none= icon(:'eye-slash')
  %span.visually-hidden= label
