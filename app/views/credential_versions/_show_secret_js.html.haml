-#
-#  The eye button next to a secret input: shows or hides what is in it.
-#  A shown secret is hidden again before the form is sent or the page is
-#  left.
:javascript
  (function () {
    if (window.WsjrdpCredentialShowSecret) return

    document.addEventListener("click", (event) => {
      const eye = event.target.closest("[data-credential-show-secret]")
      if (!eye) return
      event.preventDefault()
      const input = eye.parentElement.querySelector("input[type=password], input[data-credential-shown]")
      if (!input) return
      const show = input.type === "password"
      input.type = show ? "text" : "password"
      if (show) input.dataset.credentialShown = "1"
      else delete input.dataset.credentialShown
      eye.querySelector(".credential-eye-show").classList.toggle("d-none", show)
      eye.querySelector(".credential-eye-hide").classList.toggle("d-none", !show)
    })
    const hideAll = () => document.querySelectorAll("input[data-credential-shown]").forEach((input) => {
      input.type = "password"
      delete input.dataset.credentialShown
    })
    document.addEventListener("submit", hideAll)
    window.addEventListener("pagehide", hideAll)

    window.WsjrdpCredentialShowSecret = true
  })();
