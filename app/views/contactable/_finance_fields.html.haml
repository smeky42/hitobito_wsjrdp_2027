.row.mt-4
  .col
    %h4= t('people.finance_fields.early_payer_header')
    %p.text-muted= raw(t('people.finance_fields.early_payer_help'))
    - if (@person.status == 'registered')
      = f.labeled(:early_payer, t('people.finance_fields.early_payer_header')) do
        - { true  => 'Einmalzahlung', false => 'Ratenzahlung' }.each do |value, label|
          = f.inline_radio_button(:early_payer, value, label)
    - else
      = render_attrs(entry, :early_payer)

.row.mt-5
  .col
    %h4= t('people.finance_fields.sepa_header')
    %p.text-muted= t('people.finance_fields.sepa_info')

.row.mt-3
  -if (@person.status == 'registered')
    .row
      %label.col-md-3.col-xl-2.pb-1.col-form-label.text-md-end
        = t('activerecord.attributes.person.sepa_name')
      .col
        .d-flex.flex-row.mb-2
          = f.input_field :sepa_name, input_html: { id: 'person_sepa_name' }

    .row
      %label.col-md-3.col-xl-2.pb-1.col-form-label.text-md-end
        = t('activerecord.attributes.person.sepa_address')
      .col
        .mb-2= f.with_aside(f.input_field(:sepa_address, input_html: { id: 'person_sepa_address' }),
          render('people/copy_from_participant', person: @person, kind: :address, target: 'person_sepa_address'))
    .row
      %label.col-md-3.col-xl-2.pb-1.col-form-label.text-md-end
        = t('activerecord.attributes.person.sepa_mail')
      .col
        .mb-2= f.with_aside(f.input_field(:sepa_mail, input_html: { id: 'person_sepa_mail' }),
          render('people/copy_from_participant', person: @person, kind: :email, target: 'person_sepa_mail'))

    .row
      %label.col-md-3.col-xl-2.pb-1.col-form-label.text-md-end
        = t('activerecord.attributes.person.sepa_iban')
      .col
        .d-flex.flex-row.mb-2
          = f.input_field :sepa_iban, input_html: { id: 'person_sepa_iban' }

    .row
      %label.col-md-3.col-xl-2.pb-1.col-form-label.text-md-end
        = t('activerecord.attributes.person.sepa_bic')
      .col
        .d-flex.flex-row.mb-2
          = f.input_field :sepa_bic, input_html: { id: 'person_sepa_bic' }
    - if can?(:update_finance, @person)
      .row
        %label.col-md-3.col-xl-2.pb-1.col-form-label.text-md-end
          = t('activerecord.attributes.person.sepa_mandate_id')
        .col
          .d-flex.flex-row.mb-2
            = f.input_field :sepa_mandate_id, input_html: { id: 'person_sepa_mandate_id' }

  -else
    = render_attrs(entry,
                    :sepa_name,
                    :sepa_address,
                    :sepa_mail,
                    :sepa_iban,
                    :sepa_bic,
                    :sepa_mandate_id)

= render 'people/copy_from_participant_script'
