= field_set_tag do
  = f.labeled_country_multi_select_field :passport_nationality_codes, placeholder: t('activerecord.attributes.person.passport_nationality_info'),
    help: t('activerecord.attributes.person.passport_nationality_help')
  = field_set_tag do
    = f.labeled(:passport_germany) do
      - yes_no_options.each do |value, label|
        = f.inline_radio_button(:passport_germany, value, label)
  = f.labeled_input_field :languages_spoken, placeholder: t('activerecord.attributes.person.languages_spoken_info')

= field_set_tag do
  = f.labeled_collection_select(:diet, Settings.diets, :first, :last, {}, class: 'span2')
  = f.labeled_input_field :medical_eating_disorders, label: t('people.medical_fields.eating_disorders_long')
= field_set_tag do
  = f.labeled_collection_select(:shirt_size, Settings.shirt_size, :to_s, :to_s, {include_blank: t('people.additional_info_fields.size_placeholder')}, class: 'span2')
  = f.labeled_collection_select(:uniform_size, Settings.uniform_size, :to_s, :to_s, {include_blank: t('people.additional_info_fields.size_placeholder')}, class: 'span2')
  -# Without an answer Langarm and ordering are ticked; Kurzarm and Nein
  -# are an explicit choice.
  = f.labeled(:uniform_long_sleeve) do
    - sleeve_options.each do |value, label|
      = f.inline_radio_button(:uniform_long_sleeve, value, label, true, checked: value == (f.object.uniform_long_sleeve != false))
  - if f.object.uniform_order_available?
    = f.labeled(:uniform_order) do
      - yes_no_options.each do |value, label|
        = f.inline_radio_button(:uniform_order, value, label, true, checked: value == (f.object.uniform_order != false))
      .mw-90ch.mb-2
        = t('people.additional_info_fields.uniform_order_help')
  = f.labeled_collection_select(:headgear, Settings.headgear, :first, :last, { include_blank: true }, class: 'span2')

= field_set_tag do
  = f.labeled(:can_swim) do
    - yes_no_options.each do |value, label|
      = f.inline_radio_button(:can_swim, value, label)

- if (@person.status == 'registered')
  = field_set_tag do
    = f.labeled(:foto_permission) do
      - yes_no_options.each do |value, label|
        = f.inline_radio_button(:foto_permission, value, label)
    .mw-90ch.mb-2
      = raw(t('people.additional_info_fields.foto_permission_help'))
- else
  = render_attrs(entry, :foto_permission)
