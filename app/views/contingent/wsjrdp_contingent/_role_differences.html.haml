-#
-#  Everyone, in any group, whose jamboree role (wsj_role) differs from the one
-#  their contingent role (wsjrdp_role) goes with -- not wrong, but worth
-#  seeing. Their chips carry the same "CMT→JPT" tag everywhere.
%h2.mt-4 Abweichende Kontingents- und Jamboree-Rollen
- differences = overview.role_differences
- people = Person.where(id: differences.values.flatten.map(&:id)).includes(:tags, :primary_group).index_by(&:id)
- if differences.empty?
  %p.text-muted Bei niemandem.
- else
  %table.table.table-striped.co-numbers#co-role-differences
    %thead
      %tr
        %th Kontingents-Rolle
        %th Jamboree-Rolle
        %th.co-num Anzahl
        %th Personen
        %th Gruppen
    %tbody
      - differences.each do |difference, entries|
        %tr
          - contingent, jamboree = difference.split("→", 2)
          %td= contingent
          %td= jamboree
          %td.co-num= entries.size
          %td= people_chips(entries.filter_map { |e| people[e.id] })
          %td= entries.map(&:group_name).uniq.join(", ")
  %p.small.text-muted BMT mit Jamboree-Rolle IST gelten als gleich.
