:css
  .td-like {
    font-weight: var(--bs-body-font-weight);
    background-color: var(--bs-body-bg) !important;
    --bs-table-accent-bg: transparent !important;
  }
  .p-chip {
    display: inline-block;
    vertical-align: baseline;
    padding: 1px 4px;
    margin: 1px 3px;
    border-radius: 6px;
    background-color: #e8ebf0aa;
    white-space: nowrap;
  }
  .tag-hoc, .tag-ehoc {
    font-weight: 300 !important;
    position: relative;
    bottom: 0.25em;
    font-size: 75%;
    padding: 0px 2px;
    border-radius: 2px;
    color: #a16a18;
    background-color: #fef5d5;
  }
  .tag-jpt {
    font-weight: 300 !important;
    position: relative;
    bottom: 0.25em;
    font-size: 75%;
    padding: 0px 2px;
    border-radius: 2px;
    color: #398bf1;
    background-color: #a2ceff;
  }
  .team-people-list + .team-people-list {
    margin-left: 10px;
  }

#main.row
  %div

    %h2 BMT

    %h3 IST zu BMT umziehen

    %div
      %span.chip.person-tag
        %a{href: "https://anmeldung.worldscoutjamboree.de/groups/1/people?filters[role][kind]=active_today&filters[tag][names][]=zu-BMT-umziehen&range=deep", style: "text-decoration: underline; color: inherit;"}
          zu-BMT-umziehen
        %a{href: "https://anmeldung.worldscoutjamboree.de/groups/1/people?filters[role][kind]=active_today&filters[tag][names][]=zu-BMT-umziehen&range=deep", target: "_blank"}
          ↗
      %br
      %br

    %h3 BMT

    = render 'people_table', grouped_people: @bmt_people

    %h2 IST ohne BMT

    = render 'people_table', grouped_people: @ist_wo_bmt_people
